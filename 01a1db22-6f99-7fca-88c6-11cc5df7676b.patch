+                    {
+                        trial[i3]     = pos[i3]     + lsAlpha * dx[i3];
+                        trial[i3 + 1] = pos[i3 + 1] + lsAlpha * dx[i3 + 1];
+                        trial[i3 + 2] = pos[i3 + 2] + lsAlpha * dx[i3 + 2];
+                    }
+                }
+                const eTrial = this._computeTotalEnergy(trial, h, zipAlpha, true);
