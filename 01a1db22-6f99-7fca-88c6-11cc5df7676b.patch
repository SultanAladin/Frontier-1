+        this.metrics.meanFoldDeg = nHinges > 0 ? foldAcc / nHinges : 0.0;
+        this.metrics.meanFoldAngleDeg = this.metrics.meanFoldDeg;
+        this.metrics.p90FoldDeg = nHinges > 0 ? foldDegs[Math.min(nHinges - 1, Math.floor(nHinges * 0.9))] : 0.0;
