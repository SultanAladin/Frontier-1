+    backdrop-filter: blur(16px);
+}
+
+.notch-brand {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    padding-right: 10px;
+    border-right: 1px solid var(--border-soft);
+}
+
+.notch-dot {
+    width: 8px;
+    height: 8px;
+    border-radius: 50%;
