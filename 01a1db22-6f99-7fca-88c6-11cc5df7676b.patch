+            const lv = Math.hypot(fvX, fvY, fvZ);
+
+            const shearRad = (lu > 1e-6 && lv > 1e-6) ? Math.asin(clamp(Math.abs(fuX * fvX + fuY * fvY + fuZ * fvZ) / (lu * lv), 0, 1)) : 0;
