+        const sIds = net.seamIndices;
+        for (let s = 0; s < net.seamCount; ++s)
+        {
+            const a3 = sIds[s * 2] * 3, b3 = sIds[s * 2 + 1] * 3;
+            const dx = pos[a3] - pos[b3], dy = pos[a3 + 1] - pos[b3 + 1], dz = pos[a3 + 2] - pos[b3 + 2];
+            seamSq += dx * dx + dy * dy + dz * dz;
+        }
