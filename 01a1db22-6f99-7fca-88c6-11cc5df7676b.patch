+        const localTris = [];
+        for (let j = 0; j < nv; ++j)
+        {
+            for (let i = 0; i < nu; ++i)
+            {
+                const v00 = j * (nu + 1) + i;
+                const v10 = v00 + 1;
+                const v01 = (j + 1) * (nu + 1) + i;
+                const v11 = v01 + 1;
+                const flipDiag = ((i + j) & 1) === 1;
+                if (!flipDiag)
