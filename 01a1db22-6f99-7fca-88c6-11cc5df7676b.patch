+}
+
+.dock-scroll::-webkit-scrollbar-thumb {
+    background: rgba(255, 255, 255, 0.14);
+    border-radius: 999px;
+}
+
+/* =====================================================================
+   PROJECT-ZERO INSPECTOR CARDS & PILL SLIDERS
+===================================================================== */
+.pz-card {
+    background: var(--bg-card);
+    border: 1px solid var(--border-soft);
+    border-radius: 20px;
+    padding: 13px 14px;
+    display: flex;
+    flex-direction: column;
