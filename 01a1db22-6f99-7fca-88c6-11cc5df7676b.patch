+            if (!adapter) return null;
+            const device = await adapter.requestDevice();
+            return new WebGpuClothAccelerator(device, adapter.info?.description || 'WebGPU Hardware Compute');
+        }
+        catch
+        {
+            return null;
+        }
+    }
