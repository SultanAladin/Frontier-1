+    box-shadow: 0 0 8px rgba(255, 180, 84, 0.55);
+}
+
+.notch-title {
+    font-size: 12px;
+    font-weight: 500;
+    letter-spacing: -0.01em;
+    color: var(--text-primary);
+}
+
+.notch-sub {
+    font-size: 10.5px;
+    color: var(--text-muted);
+    margin-left: 2px;
+}
+
+.notch-group {
+    display: flex;
+    align-items: center;
+    gap: 5px;
+}
+
+.notch-btn {
+    display: inline-flex;
+    align-items: center;
+    gap: 5px;
+    height: 28px;
+    padding: 0 11px;
+    border-radius: 999px;
+    border: 1px solid var(--border-soft);
+    background: #1c1c20;
+    color: var(--text-secondary);
+    font-family: inherit;
+    font-size: 11px;
+    font-weight: 500;
+    cursor: pointer;
+    transition: all 0.14s ease;
+}
+
+.notch-btn:hover {
+    color: var(--text-primary);
+    background: #27272c;
+}
+
+.notch-btn.primary {
+    background: #f4f4f6;
+    color: #090909;
+    border-color: transparent;
+}
+
+.notch-btn.primary:hover {
+    background: #ffffff;
+}
+
+.notch-btn.playing {
+    background: rgba(52, 199, 89, 0.16);
+    color: #6ee787;
+    border-color: rgba(52, 199, 89, 0.35);
+}
+
+.notch-select {
+    height: 28px;
+    padding: 0 10px;
+    border-radius: 999px;
+    border: 1px solid var(--border-soft);
+    background: #1c1c20;
+    color: var(--text-primary);
+    font-family: inherit;
+    font-size: 11px;
+    font-weight: 500;
+    outline: none;
+    cursor: pointer;
+}
+
+/* =====================================================================
+   FLOATING DOCKS & TRAPEZOIDAL TABS
+===================================================================== */
+.dock {
+    position: absolute;
+    top: 10px;
+    bottom: 10px;
+    z-index: 20;
+    display: flex;
+    flex-direction: column;
+    border-radius: 24px;
+    background: var(--bg-dock);
+    border: 1px solid var(--border-soft);
+    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.65);
+    backdrop-filter: blur(18px);
+    overflow: hidden;
+}
+
+.dock-left {
+    left: 10px;
+    width: var(--dock-left-w);
+}
+
+.dock-right {
+    right: 10px;
+    width: var(--dock-right-w);
+}
+
+.dock-tab-strip {
+    display: flex;
+    align-items: flex-end;
+    padding: 10px 14px 0 14px;
+    background: #0e0e10;
+    border-bottom: 1px solid var(--border-soft);
+    gap: 0;
+}
+
+.trapezoid-tab {
+    position: relative;
+    z-index: 1;
+    height: 30px;
+    padding: 0 18px;
+    margin-left: -10px;
+    border: none;
+    background: #1b1b1e;
+    color: var(--text-muted);
+    font-family: inherit;
+    font-size: 11px;
+    font-weight: 500;
+    cursor: pointer;
+    clip-path: polygon(10px 0%, calc(100% - 10px) 0%, 100% 100%, 0% 100%);
+    transition: background 0.14s ease, color 0.14s ease;
+}
+
+.trapezoid-tab:first-child {
+    margin-left: 0;
+}
+
+.trapezoid-tab:hover {
+    background: #232328;
+    color: var(--text-secondary);
+}
+
+.trapezoid-tab.active {
+    z-index: 3;
+    background: #27272c;
+    color: var(--text-primary);
+}
+
+.dock-scroll {
+    flex: 1;
+    overflow-y: auto;
+    padding: 12px;
+    display: flex;
+    flex-direction: column;
+    gap: 10px;
+}
+
+.dock-scroll::-webkit-scrollbar {
