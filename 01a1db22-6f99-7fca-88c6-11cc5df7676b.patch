+                        }
+                    }
+                }
+            }
+
+            // C. Quadratic Plate Bending hinges
+            for (let c = 0; c < net.hingeBatches.colorCount; ++c)
+            {
+                const b0 = hOff[c], b1 = hOff[c + 1];
