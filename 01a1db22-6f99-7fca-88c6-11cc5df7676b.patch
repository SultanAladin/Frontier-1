+/*============================================================================================================================================
+                                                          CLOTHATELIER.CSS
+                       Faithful Project-Zero Visual Language — Dark Charcoal Atelier Theme, Trapezoidal Tabs,
+                          Pill Sliders with Dynamic Fill, Top Control Notch, and Collapsible Asset Drawer
+============================================================================================================================================*/
+
+@font-face {
+    font-family: 'DM Sans';
+    font-style: normal;
+    font-weight: 300;
+    font-display: swap;
+    src: url('../Fonts/dm-sans-latin-300-normal.woff2') format('woff2');
+}
+@font-face {
+    font-family: 'DM Sans';
+    font-style: normal;
+    font-weight: 400;
+    font-display: swap;
+    src: url('../Fonts/dm-sans-latin-400-normal.woff2') format('woff2');
+}
+@font-face {
+    font-family: 'DM Sans';
+    font-style: normal;
+    font-weight: 500;
+    font-display: swap;
+    src: url('../Fonts/dm-sans-latin-500-normal.woff2') format('woff2');
+}
+
+:root {
+    --bg-root: #090909;
+    --bg-dock: rgba(18, 18, 20, 0.94);
+    --bg-card: #19191c;
+    --bg-card-inner: #212125;
+    --bg-pill: #252529;
+    --bg-hover: rgba(255, 255, 255, 0.08);
+    --border-soft: rgba(255, 255, 255, 0.075);
+    --border-strong: rgba(255, 255, 255, 0.14);
+    --text-primary: #f4f4f6;
+    --text-secondary: #a1a1aa;
+    --text-muted: #71717a;
+    --accent-amber: #ffb454;
+    --accent-green: #34c759;
+    --accent-blue: #38bdf8;
+    --accent-pink: #f472b6;
+    --dock-left-w: 326px;
+    --dock-right-w: 344px;
+}
+
+*, *::before, *::after {
+    box-sizing: border-box;
+    user-select: none;
+    -webkit-user-select: none;
+}
+
+html, body {
+    margin: 0;
+    padding: 0;
+    width: 100%;
+    height: 100%;
+    overflow: hidden;
+    background: var(--bg-root);
+    color: var(--text-primary);
+    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
+    font-size: 12px;
+    -webkit-font-smoothing: antialiased;
+}
+
+.atelier-shell {
+    position: relative;
+    width: 100%;
+    height: 100%;
+    overflow: hidden;
+    background: radial-gradient(circle at 50% 35%, #16181f 0%, #090909 75%);
+}
+
+/* =====================================================================
+   STAGE (3D VIEWPORT + 2D PATTERN CANVAS)
+===================================================================== */
+.viewport-stage {
+    position: absolute;
+    inset: 0;
+    display: flex;
+    padding-left: calc(var(--dock-left-w) + 12px);
+    padding-right: calc(var(--dock-right-w) + 12px);
+    padding-top: 52px;
+    padding-bottom: 42px;
+    gap: 8px;
+}
+
+.pane-box {
+    position: relative;
+    flex: 1 1 0;
+    min-width: 0;
+    height: 100%;
+    border-radius: 22px;
+    overflow: hidden;
+    background: #101114;
+    border: 1px solid var(--border-soft);
+    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
+}
+
+.pane-box.hidden {
+    display: none;
+}
+
+.pane-box canvas {
+    display: block;
+    width: 100%;
+    height: 100%;
+}
+
+.pane-badge {
+    position: absolute;
+    top: 12px;
+    left: 12px;
+    z-index: 4;
+    display: inline-flex;
+    align-items: center;
+    gap: 7px;
+    padding: 5px 11px;
+    border-radius: 999px;
+    background: rgba(16, 16, 18, 0.78);
+    backdrop-filter: blur(10px);
+    border: 1px solid var(--border-soft);
+    font-size: 11px;
+    font-weight: 500;
+    color: var(--text-secondary);
+    pointer-events: none;
+}
+
+.pane-badge strong {
+    color: var(--text-primary);
+    font-weight: 500;
+}
+
+.pane-controls-tr {
+    position: absolute;
+    top: 12px;
+    right: 12px;
+    z-index: 4;
+    display: flex;
+    gap: 5px;
+}
+
+.pane-chip-btn {
+    border: 1px solid var(--border-soft);
+    background: rgba(18, 18, 22, 0.82);
+    backdrop-filter: blur(10px);
+    color: var(--text-secondary);
+    padding: 5px 9px;
+    border-radius: 999px;
+    font-family: inherit;
+    font-size: 10.5px;
+    font-weight: 500;
+    cursor: pointer;
+    transition: all 0.14s ease;
+}
+
+.pane-chip-btn:hover {
+    color: var(--text-primary);
+    background: rgba(38, 38, 44, 0.92);
+}
+
+.pane-chip-btn.active {
+    color: #111;
+    background: #f4f4f6;
+    border-color: transparent;
+}
+
+/* =====================================================================
+   TOP PROJECT-ZERO NOTCH
+===================================================================== */
+.notch-shell {
+    position: absolute;
+    top: 0;
+    left: 50%;
+    transform: translateX(-50%);
+    z-index: 30;
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    height: 44px;
+    padding: 0 16px;
+    background: rgba(14, 14, 16, 0.96);
