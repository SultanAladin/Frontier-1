+        let vSqAcc = 0, activeCount = 0;
+        for (let i = 0; i < nPts; ++i)
+        {
+            const i3 = i * 3;
+            const nl = Math.hypot(vn[i3], vn[i3 + 1], vn[i3 + 2]);
+            if (nl > 1e-10)
+            {
+                const invN = 1.0 / nl;
+                vn[i3] *= invN; vn[i3 + 1] *= invN; vn[i3 + 2] *= invN;
+            }
+            else
+            {
