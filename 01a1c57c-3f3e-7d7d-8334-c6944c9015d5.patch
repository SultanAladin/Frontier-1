+    addRoad(g, 'motorway-4', pts.map(([x, z]) => ({ x, y: Y.ring, z })), { name: `Ring ${k}` });
+    use('motorway-4');
+  }
+
+  // ---- crossing motorways ----
+  addRoad(g, 'motorway-6', [{ x: -MAP, y: Y.motor, z: -1400 }, { x: -800, y: Y.motor, z: -1400 }, { x: 800, y: Y.motor, z: -1400 }, { x: MAP, y: Y.motor, z: -1400 }], { name: 'Motorway E-W' });
