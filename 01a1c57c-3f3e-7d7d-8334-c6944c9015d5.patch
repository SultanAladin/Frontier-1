+.range-labels { color: #919191; font-size: 10px; }
+input[type=range] { background: linear-gradient(to right, #c5c5c5 0%, #c5c5c5 var(--progress), #444 var(--progress), #444 100%); height: 3px; }
+input[type=range]::-webkit-slider-thumb { width: 11px; height: 11px; background: #e5e5e5; border-color: #e5e5e5; box-shadow: 0 0 0 4px #222; transition: box-shadow .2s; }
