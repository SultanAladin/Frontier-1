+            if (Vig) Vig.style.opacity = "0";
+            return;
+        }
+        const Sat = Math.max(0, Number(S.PostSaturation ?? 1));
+        const Con = Math.max(0.5, Number(S.PostContrast ?? 1));
+        const BloomBoost = 1 + Math.max(0, Number(S.PostBloom ?? 0.05)) * 0.12;
+        this.Canvas.style.filter = `saturate(${Sat.toFixed(3)}) contrast(${Con.toFixed(3)}) brightness(${BloomBoost.toFixed(3)})`;
