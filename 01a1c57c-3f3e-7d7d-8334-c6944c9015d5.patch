+        assert.ok(Used.every((Id) => Id < 2) && new Set(Used).size === Used.length, "valid, unique ids");
+        assert.ok(Ids.slice(Used.length).every((Id) => Id === EmissiveEmptySlot), "empty slots follow the used ones");
+    }
