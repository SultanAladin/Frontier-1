+  await Choose("Stars");
+  await Add();
+  assert.equal(await Count(), 25);
+  // Remove and duplicate both update the same outline/preview collection.
+  await Page.getByRole("textbox", {
+    name: "Search outliner",
+    exact: true,
+  }).fill("Preview box");
