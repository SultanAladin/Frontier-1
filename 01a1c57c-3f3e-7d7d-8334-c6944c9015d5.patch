+/* Neutral graphite theme. Object color appears only in the visualizations. */
+:root {
+  background: #101010;
+  color: #e5e5e5;
+  --surface: #202020;
+  --border: #303030;
+  --muted: #929292;
+}
+.outliner { background: #151515; border-right-color: #292929; }
+.inspector { background: radial-gradient(ellipse at 80% 0, #1a1a1a, #121212 75%); }
