+const entries=[{"id": "sun", "name": "Sun", "group": "Celestial", "description": "A granular photosphere, dark active regions, and looping plasma prominences. Native SVG turbulence makes the surface\u2014not a photograph."}, {"id": "moon", "name": "Moon", "group": "Celestial", "description": "A shaded lunar globe with layered maria, small impact craters, and a softly darkened limb."}, {"id": "stars", "name": "Stars", "group": "Celestial", "description": "A fuller sky of 62 clean star dots, with varied sizes and no glow, rays or flares."}, {"id": "clouds", "name": "Clouds", "group": "Environment", "description": "A continuous sculpted cumulus cloud with turbulent edges, illuminated billows, and a soft, dense underside."}, {"id": "wind", "name": "Wind", "group": "Environment", "description": "Three clean rounded airflow strokes. A simple solid-color wind control with no glow or gradients."}, {"id": "rainbow", "name": "Rainbow", "group": "Environment", "description": "A soft spectral arc with layered color bands, an illuminated rim, and transparent surroundings."}, {"id": "forest", "name": "Forest", "group": "Environment", "description": "Layered conifers with separate lit and shaded needle masses and warm wooden trunks."}, {"id": "terrain", "name": "Terrain", "group": "Environment", "description": "A faceted mountain massif with weathered rock, cool shadow planes, and snow on the summits."}, {"id": "fluid", "name": "Liquid", "group": "Objects", "description": "A magnified droplet with a rounded base, reflected studio lights, and a cool refractive rim."}, {"id": "mesh", "name": "Mesh object", "group": "Objects", "description": "A bevelled cube with distinct face lighting, precise edges, and a softly lit top plane."}, {"id": "material", "name": "PBR material", "group": "Objects", "description": "A satin ceramic material sample: pearl-gray shading, broad roughness-controlled highlights, fine surface micro-pitting, a recessed shader-ball seam, and a cool edge reflection.