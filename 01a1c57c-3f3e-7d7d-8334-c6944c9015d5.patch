+  // ---- railway level crossings: furniture + approach type ----
+  let converted = 0;
+  for (const e of g.edgeList()) {
+    const hits = crossesRail(e, g.rails);
+    for (const h of hits) {
+      g.railGear.push({ x: h.x, y: e.control[0].y, z: h.z, rot: Math.atan2(h.tx, h.tz), width: 8 });
