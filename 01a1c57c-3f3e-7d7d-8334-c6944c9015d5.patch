+  addRoad(g, 'motorway-4', [{ x: 1400, y: Y.motorHigh, z: -MAP }, { x: 1400, y: Y.motorHigh, z: 0 }, { x: 1400, y: Y.motorHigh, z: MAP }], { name: 'Motorway N-S' });
