+  } else if (bridgeId === 'slab') {
+    box(conc, P(0, -w / 2 - 0.5, deckY - deckT - 0.4), P(len, w / 2 + 0.5, deckY - deckT), tx, tz);
+    abut(conc, P, len, w, deckY - deckT, groundY, tx, tz);
+  } else if (bridgeId === 'arch') {
+    const rise = Math.min(len * 0.18, deckY - groundY - 3);
