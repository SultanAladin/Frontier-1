+  nbody.appendChild(ta);
+  notes.appendChild(nbody);
+  notes.querySelector('h4').onclick = e => { if (e.target.closest('textarea')) return; notes.classList.toggle('shut'); };
+  if (compact) notes.classList.add('shut');
+  host.appendChild(notes);
+
+  return host;
+}
