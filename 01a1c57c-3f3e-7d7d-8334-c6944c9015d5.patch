+    ['footpath', [[-900, 2500], [-300, 2700], [300, 2900]]],
+  ];
+  for (const [t, pts] of offroads) {
+    addRoad(g, t, pts.map(([x, z]) => ({ x, y: 0, z })), {});
+    use(t);
