+//============================================================================================================================================
+//                                                         ATMOSPHEREINTEGRATOR.JS
+//============================================================================================================================================
+// 🧩 Light direction from the time of day, sun transmittance at the observer, moonlight below the horizon, sky-view refresh.
+
+import { NormalizeVector, ClampScalar } from "./TransformProjection.js";
+
+const SkyViewExtent = [192, 108];   // [texel] - azimuth × elevation
+
+// 📝 Same constants as AtmosphereScattering.wgsl, so the light the shading uses is the light the sky was integrated for.
+const GroundRadius     = 6360000.0;
+const AtmosphereRadius = 6460000.0;
+const RayleighScatter  = [5.802e-6, 13.558e-6, 33.1e-6];
+const MieExtinction    = 4.40e-6;
+const OzoneAbsorption  = [0.650e-6, 1.881e-6, 0.085e-6];
+const ObserverAltitude = 100.0;
+
+export class AtmosphereIntegrator
+{
+    constructor(Exchange, Shaders)
+    {
+        this.Exchange = Exchange;
+        this.Shaders  = Shaders;
+        this.LastKey  = "";
+        this.Light    = { Direction: [0, 0, 1], Illuminance: [1, 1, 1], SkyScale: 1.0, NightSky: [0, 0, 0], SunVisible: 1.0 };
+    }
+
+    async ConstructResources()
+    {
+        this.SkyTexture = this.Exchange.ConstructTexture({ label: "Sky view", size: SkyViewExtent, format: "rgba16float",
+                                                           usage: GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.TEXTURE_BINDING });
+        this.SkyView = this.SkyTexture.createView();
+        this.SkySampler = this.Exchange.ConstructSampler({ magFilter: "linear", minFilter: "linear",
+                                                           addressModeU: "repeat", addressModeV: "clamp-to-edge" });
+        this.UniformRecords = this.Exchange.ConstructRecords(32, GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST, "Atmosphere record");
+        this.Layout = this.Exchange.ConstructDescriptorLayout(["Uniform", "StorageTexture2D:rgba16float"], GPUShaderStage.COMPUTE, "Atmosphere");
+        this.Group = this.Exchange.ConstructDescriptorGroup(this.Layout, [this.UniformRecords, this.SkyView]);
+        this.Program = await this.Shaders.ConstructComputeProgram("AtmosphereScattering.wgsl", "IntegrateSkyView", [this.Layout]);
+    }
+
+    // 📝 Elevation and azimuth in degrees. Below about −4° the key light hands over to a cool, dim moon opposite the
+    //    sun, and a faint night-sky floor keeps escaped rays from returning pure black.
+    ResolveLight(ElevationDegrees, AzimuthDegrees, SolarIlluminance)
+    {
+        const Elevation = ElevationDegrees * Math.PI / 180.0;
+        const Azimuth   = AzimuthDegrees * Math.PI / 180.0;
+        const Sun = NormalizeVector([Math.cos(Elevation) * Math.cos(Azimuth), Math.cos(Elevation) * Math.sin(Azimuth), Math.sin(Elevation)]);
+        const Transmittance = ResolveSunTransmittance(Sun);
+        const SunFade  = ClampScalar((ElevationDegrees + 1.0) / 3.0, 0.0, 1.0);
+        const MoonFade = ClampScalar((-ElevationDegrees - 4.0) / 6.0, 0.0, 1.0);
+        const MoonElevation = 38.0 * Math.PI / 180.0;
+        const Moon = NormalizeVector([Math.cos(MoonElevation) * Math.cos(Azimuth + Math.PI),
+                                      Math.cos(MoonElevation) * Math.sin(Azimuth + Math.PI), Math.sin(MoonElevation)]);
+        const MoonIlluminance = [0.035, 0.045, 0.065].map((Component) => Component * SolarIlluminance / 10.0);
+        if (MoonFade > SunFade)
+        {
+            this.Light.Direction = Moon;
+            this.Light.Illuminance = MoonIlluminance.map((Component) => Component * MoonFade);
+        }
+        else
+        {
+            this.Light.Direction = Sun;
+            this.Light.Illuminance = Transmittance.map((Component) => Component * SolarIlluminance * SunFade);
+        }
+        this.Light.SunDirection = Sun;
+        this.Light.SunVisible = SunFade;
+        this.Light.NightSky = [0.0012, 0.0016, 0.0030].map((Component) => Component * (1.0 - SunFade) * SolarIlluminance / 10.0);
+        return this.Light;
+    }
+
+    RecordSkyView(Encoder, SolarIlluminance)
+    {
+        const Sun = this.Light.SunDirection;
+        const Key = `${Sun.map((Component) => Component.toFixed(4)).join(",")}|${SolarIlluminance.toFixed(3)}`;
+        if (Key === this.LastKey)
+            return false;
+        this.LastKey = Key;
+        const Record = new Float32Array(8);
+        Record.set(Sun, 0);
+        Record[3] = SolarIlluminance;
+        Record[4] = ObserverAltitude;
+        this.Exchange.Device.queue.writeBuffer(this.UniformRecords, 0, Record);
+        const Pass = Encoder.beginComputePass({ label: "Sky view" });
+        Pass.setPipeline(this.Program);
+        Pass.setBindGroup(0, this.Group);
+        Pass.dispatchWorkgroups(Math.ceil(SkyViewExtent[0] / 8), Math.ceil(SkyViewExtent[1] / 8));
+        Pass.end();
+        return true;
+    }
+}
+
+// 📐 Transmittance from the observer toward the sun, 64-step quadrature of the extinction along the ray.
+function ResolveSunTransmittance(Direction)
+{
+    const Origin = [0.0, 0.0, GroundRadius + ObserverAltitude];
+    const Dot = Origin[2] * Direction[2];
+    const Square = Origin[2] * Origin[2];
+    const GroundDiscriminant = Dot * Dot - (Square - GroundRadius * GroundRadius);
+    if (GroundDiscriminant > 0.0 && (-Dot - Math.sqrt(GroundDiscriminant)) > 0.0)
+        return [0.0, 0.0, 0.0];
+    const Exit = -Dot + Math.sqrt(Dot * Dot - (Square - AtmosphereRadius * AtmosphereRadius));
+    const Samples = 64;
+    const Step = Exit / Samples;
+    const Depth = [0.0, 0.0, 0.0];
+    for (let Sample = 0; Sample < Samples; ++Sample)
+    {
+        const Travel = (Sample + 0.5) * Step;
+        const Point = [Direction[0] * Travel, Direction[1] * Travel, Origin[2] + Direction[2] * Travel];
+        const Altitude = Math.hypot(Point[0], Point[1], Point[2]) - GroundRadius;
+        const Rayleigh = Math.exp(-Altitude / 8000.0);
+        const Mie = Math.exp(-Altitude / 1200.0);
+        const Ozone = Math.max(0.0, 1.0 - Math.abs(Altitude - 25000.0) / 15000.0);
+        for (let Channel = 0; Channel < 3; ++Channel)
+            Depth[Channel] += (RayleighScatter[Channel] * Rayleigh + MieExtinction * Mie + OzoneAbsorption[Channel] * Ozone) * Step;
+    }
+    return Depth.map((Component) => Math.exp(-Component));
+}
diff --git a/Experimental/FrontierEngine/Source/BenchmarkMetrics.js b/Experimental/FrontierEngine/Source/BenchmarkMetrics.js
new file mode 100644
index 0000000..d2db734
--- /dev/null
+++ b/Experimental/FrontierEngine/Source/BenchmarkMetrics.js
@@ -0,0 +1,157 @@
+//============================================================================================================================================
+//                                                          BENCHMARKMETRICS.JS
+//============================================================================================================================================
+// 🧩 Frame-timing log for a WebGPU machine: runs each capture configuration for a fixed frame count, summarises it, and builds
+//    plain text the user can copy back. Nothing is written to disk; the text lives in memory until it is copied.
+// 📝 The log reports what this machine measured. It makes no claim about speed or quality on any other machine.
+
+export const CaptureFrameCount = 120;
+
+// 📝 Each configuration names the settings it changes; the others keep their current values.
+const ScreenOn = { ScreenTraversal: true, ScreenIndirect: true, ScreenReflection: true };
+export const CaptureMatrix = Object.freeze([
+    Object.freeze({ Name: "SDF distance field",             Settings: Object.freeze({ RayTracing: false, ScreenTraversal: false }) }),
+    Object.freeze({ Name: "SDF + screen traces",            Settings: Object.freeze({ RayTracing: false, ...ScreenOn }) }),
+    Object.freeze({ Name: "BVH path tracer",                Settings: Object.freeze({ RayTracing: true,  ScreenTraversal: false, LightGrid: true }) }),
+    Object.freeze({ Name: "BVH + screen traces",            Settings: Object.freeze({ RayTracing: true,  ...ScreenOn }) }),
+    Object.freeze({ Name: "BVH, light grid off (all lights)", Settings: Object.freeze({ RayTracing: true,  ScreenTraversal: false, LightGrid: false }) }),
+    Object.freeze({ Name: "BVH, emissive clusters off",      Settings: Object.freeze({ RayTracing: true,  ScreenTraversal: false, EmissiveLights: false }) })
+]);
+
+// 📝 The settings the log may change; every other setting is only read.
+const GateKeys = ["RayTracing", "ScreenTraversal", "ScreenIndirect", "ScreenReflection", "LightGrid", "EmissiveLights"];
+
+function Summarise(Values)
+{
+    const Sorted = [...Values].sort((First, Second) => First - Second);
+    const Count = Sorted.length;
+    if (Count === 0)
+        return { Median: 0, Mean: 0, P95: 0, Worst: 0 };
+    const Mean = Sorted.reduce((Sum, Value) => Sum + Value, 0) / Count;
+    return { Median: Sorted[Math.floor(Count / 2)], Mean, P95: Sorted[Math.min(Count - 1, Math.floor(Count * 0.95))], Worst: Sorted[Count - 1] };
+}
+
+export class BenchmarkMetrics
+{
+    constructor()
+    {
+        this.Matrix = null;
+        this.Index = 0;
+        this.Frames = [];
+        this.Results = [];
+        this.Saved = null;
+        this.Active = false;
+        this.Finished = false;
+        this.LastText = "";
+        this.CopyStatus = "";
+    }
+
+    // 📝 Starts a capture. The gate settings of the plan are applied per configuration and restored when it finishes.
+    Begin(Host, Matrix)
+    {
+        if (this.Active)
+            return;
+        this.Matrix = Matrix;
+        this.Index = 0;
+        this.Results = [];
+        this.Frames = [];
+        this.Finished = false;
+        this.Saved = Object.fromEntries(GateKeys.map((Key) => [Key, Host.Settings[Key]]));
+        this.Active = true;
+        this.Apply(Host, Matrix[0]);
+    }
+
+    // 📝 A configuration sets every gate: the keys it leaves out keep the values the user had set before the capture.
+    Apply(Host, Configuration)
+    {
+        for (const Key of GateKeys)
+            Host.Settings[Key] = Key in Configuration.Settings ? Configuration.Settings[Key] : this.Saved[Key];
+        Host.PriorValid = false;
+    }
+
+    // 📝 Called once per presented frame. Frame times are the raw interval between frames; pass durations are the latest resolved values.
+    Sample(Host)
+    {
+        if (!this.Active)
+            return;
+        const Durations = Host.Metrics ? { ...Host.Metrics.Raw } : {};
+        this.Frames.push({ Milliseconds: Host.LastFrameMilliseconds || 0.0, Durations });
+        if (this.Frames.length < CaptureFrameCount)
+            return;
+        this.Results.push(this.Finish(Host, this.Matrix[this.Index]));
+        this.Frames = [];
+        this.Index += 1;
+        if (this.Index < this.Matrix.length)
+        {
+            this.Apply(Host, this.Matrix[this.Index]);
+            return;
+        }
+        Object.assign(Host.Settings, this.Saved);
+        Host.PriorValid = false;
+        this.Active = false;
+        this.Finished = true;
+        this.LastText = this.BuildText(Host);
+    }
+
+    Finish(Host, Configuration)
+    {
+        const Milliseconds = this.Frames.map((Frame) => Frame.Milliseconds);
+        const Passes = {};
+        for (const Name of Object.keys(this.Frames[0].Durations))
+            Passes[Name] = Summarise(this.Frames.map((Frame) => Frame.Durations[Name] || 0.0)).Median;
+        return { Name: Configuration.Name, Settings: { ...Configuration.Settings }, Frame: Summarise(Milliseconds), Passes, Count: this.Frames.length };
+    }
+
+    // 📝 The status line the panel shows while a capture runs or after it ends.
+    StatusLines()
+    {
+        if (this.Active)
+            return [`Capturing "${this.Matrix[this.Index].Name}" · ${this.Frames.length} / ${CaptureFrameCount} frames`,
+                    `configuration ${this.Index + 1} of ${this.Matrix.length}`];
+        if (this.Finished)
+            return this.Results.map((Result) => `${Result.Name.padEnd(34)} median ${Result.Frame.Median.toFixed(1)} ms · p95 ${Result.Frame.P95.toFixed(1)} ms`)
+                               .concat([this.CopyStatus || "Press Copy log to copy the full text."]);
+        return ["Idle. Capture current settings, or the matrix of renderer configurations (SDF / BVH, screen traces, light grid)."];
+    }
+
+    // 📝 Plain text for the clipboard: the machine, the settings, and each configuration's frame and pass figures.
+    BuildText(Host)
+    {
+        const Lines = [];
+        const Information = Host.Exchange && Host.Exchange.Adapter ? Host.Exchange.QueryAdapterDescription() : "unknown adapter";
+        Lines.push("Frontier VehicleHmiPrototype · hardware log");
+        Lines.push(`recorded ${new Date().toISOString()}`);
+        Lines.push(`adapter ${Information}`);
+        Lines.push(`timestamp queries ${Host.Metrics && Host.Metrics.Enabled ? "on" : "off"} · quality ${Host.GradeName} · `
+                   + `screen ${Host.ScreenExtent ? Host.ScreenExtent.join("x") : "-"} · trace ${Host.TraceExtent ? Host.TraceExtent.join("x") : "-"}`);
+        Lines.push(`frames per configuration ${CaptureFrameCount}`);
+        Lines.push("");
+        for (const Result of this.Results)
+        {
+            Lines.push(`[${Result.Name}]`);
+            Lines.push(`  gates ${JSON.stringify(Result.Settings)}`);
+            Lines.push(`  frame ms  median ${Result.Frame.Median.toFixed(2)}  mean ${Result.Frame.Mean.toFixed(2)}  p95 ${Result.Frame.P95.toFixed(2)}  worst ${Result.Frame.Worst.toFixed(2)}`);
+            for (const [Name, Milliseconds] of Object.entries(Result.Passes))
+                if (Milliseconds > 0.0)
+                    Lines.push(`  ${Name.padEnd(24)} ${Milliseconds.toFixed(3)} ms (median)`);
+            Lines.push("");
+        }
+        Lines.push(`settings ${JSON.stringify(Object.fromEntries(GateKeys.map((Key) => [Key, Host.Settings[Key]])))}`);
+        return Lines.join("\n");
+    }
+
+    async Copy()
+    {
+        if (!this.LastText)
+            return;
+        try
+        {
+            await navigator.clipboard.writeText(this.LastText);
+            this.CopyStatus = "Copied the log to the clipboard.";
+        }
+        catch (Failure)
+        {
+            this.CopyStatus = "The clipboard refused. Click Copy log again after clicking the panel.";
+        }
+    }
+}
diff --git a/Experimental/FrontierEngine/Source/BoundingStructure.js b/Experimental/FrontierEngine/Source/BoundingStructure.js
new file mode 100644
index 0000000..cb5ae11
--- /dev/null
+++ b/Experimental/FrontierEngine/Source/BoundingStructure.js
@@ -0,0 +1,192 @@
+//============================================================================================================================================
+//                                                           BOUNDINGSTRUCTURE.JS
+//============================================================================================================================================
+// 🧩 Binned-SAH bounding volume hierarchy over one facet set, flattened for the distance transfer's device traversal.
+
+// 📝 Node layout, 32 bytes: Minimum.xyz, LeftOrFirst (u32), Maximum.xyz, Count (u32). Count > 0 marks a leaf whose
+//    facets are [LeftOrFirst, LeftOrFirst + Count); an interior node's children are LeftOrFirst and LeftOrFirst + 1.
+const LeafCapacity = 4;    // [-] - facets per leaf before a split is attempted
+const BinCount     = 12;   // [-] - SAH bins along the split axis
+
+export function ConstructBoundingStructure(Corners)
+{
+    const FacetCount = Corners.length / 9;
+    const Centroids = new Float32Array(FacetCount * 3);
+    const FacetMinimum = new Float32Array(FacetCount * 3);
+    const FacetMaximum = new Float32Array(FacetCount * 3);
+    for (let Facet = 0; Facet < FacetCount; ++Facet)
+    {
+        for (let Axis = 0; Axis < 3; ++Axis)
+        {
+            const A = Corners[Facet * 9 + Axis], B = Corners[Facet * 9 + 3 + Axis], C = Corners[Facet * 9 + 6 + Axis];
+            FacetMinimum[Facet * 3 + Axis] = Math.min(A, B, C);
+            FacetMaximum[Facet * 3 + Axis] = Math.max(A, B, C);
+            Centroids[Facet * 3 + Axis] = (A + B + C) / 3.0;
+        }
+    }
+
+    const Order = new Uint32Array(FacetCount);
+    for (let Facet = 0; Facet < FacetCount; ++Facet)
+        Order[Facet] = Facet;
+
+    const Nodes = [];
+    const ConstructNode = () =>
+    {
+        Nodes.push({ Minimum: [0, 0, 0], Maximum: [0, 0, 0], LeftOrFirst: 0, Count: 0 });
+        return Nodes.length - 1;
+    };
+
+    const FitBounds = (Node, First, Count) =>
+    {
+        const Minimum = [Infinity, Infinity, Infinity], Maximum = [-Infinity, -Infinity, -Infinity];
+        for (let Index = First; Index < First + Count; ++Index)
+        {
+            const Facet = Order[Index];
+            for (let Axis = 0; Axis < 3; ++Axis)
+            {
+                Minimum[Axis] = Math.min(Minimum[Axis], FacetMinimum[Facet * 3 + Axis]);
+                Maximum[Axis] = Math.max(Maximum[Axis], FacetMaximum[Facet * 3 + Axis]);
+            }
+        }
+        Nodes[Node].Minimum = Minimum;
+        Nodes[Node].Maximum = Maximum;
+    };
+
+    const SurfaceArea = (Minimum, Maximum) =>
+    {
+        const X = Math.max(0, Maximum[0] - Minimum[0]), Y = Math.max(0, Maximum[1] - Minimum[1]), Z = Math.max(0, Maximum[2] - Minimum[2]);
+        return 2.0 * (X * Y + Y * Z + Z * X);
+    };
+
+    // 📐 Binned SAH: cost(split) = A_left·N_left + A_right·N_right, compared against the leaf cost A·N.
+    const Subdivide = (Node, First, Count) =>
+    {
+        FitBounds(Node, First, Count);
+        if (Count <= LeafCapacity)
+        {
+            Nodes[Node].LeftOrFirst = First;
+            Nodes[Node].Count = Count;
+            return;
+        }
+        let BestAxis = -1, BestSplit = 0, BestCost = Infinity;
+        for (let Axis = 0; Axis < 3; ++Axis)
+        {
+            let Low = Infinity, High = -Infinity;
+            for (let Index = First; Index < First + Count; ++Index)
+            {
+                const Centroid = Centroids[Order[Index] * 3 + Axis];
+                Low = Math.min(Low, Centroid);
+                High = Math.max(High, Centroid);
+            }
+            if (High - Low < 1.0e-9)
+                continue;
+            const Bins = Array.from({ length: BinCount }, () => ({ Count: 0, Minimum: [Infinity, Infinity, Infinity],
+                                                                   Maximum: [-Infinity, -Infinity, -Infinity] }));
+            const Scale = BinCount / (High - Low);
+            for (let Index = First; Index < First + Count; ++Index)
+            {
+                const Facet = Order[Index];
+                const Bin = Math.min(BinCount - 1, Math.floor((Centroids[Facet * 3 + Axis] - Low) * Scale));
+                Bins[Bin].Count++;
+                for (let Component = 0; Component < 3; ++Component)
+                {
+                    Bins[Bin].Minimum[Component] = Math.min(Bins[Bin].Minimum[Component], FacetMinimum[Facet * 3 + Component]);
+                    Bins[Bin].Maximum[Component] = Math.max(Bins[Bin].Maximum[Component], FacetMaximum[Facet * 3 + Component]);
+                }
+            }
+            for (let Split = 1; Split < BinCount; ++Split)
+            {
+                let LeftCount = 0, RightCount = 0;
+                const LeftMinimum = [Infinity, Infinity, Infinity], LeftMaximum = [-Infinity, -Infinity, -Infinity];
+                const RightMinimum = [Infinity, Infinity, Infinity], RightMaximum = [-Infinity, -Infinity, -Infinity];
+                for (let Bin = 0; Bin < BinCount; ++Bin)
+                {
+                    if (Bins[Bin].Count === 0)
+                        continue;
+                    const Left = Bin < Split;
+                    const TargetMinimum = Left ? LeftMinimum : RightMinimum, TargetMaximum = Left ? LeftMaximum : RightMaximum;
+                    for (let Component = 0; Component < 3; ++Component)
+                    {
+                        TargetMinimum[Component] = Math.min(TargetMinimum[Component], Bins[Bin].Minimum[Component]);
+                        TargetMaximum[Component] = Math.max(TargetMaximum[Component], Bins[Bin].Maximum[Component]);
+                    }
+                    if (Left)
+                        LeftCount += Bins[Bin].Count;
+                    else
+                        RightCount += Bins[Bin].Count;
+                }
+                if (LeftCount === 0 || RightCount === 0)
+                    continue;
+                const Cost = SurfaceArea(LeftMinimum, LeftMaximum) * LeftCount + SurfaceArea(RightMinimum, RightMaximum) * RightCount;
+                if (Cost < BestCost)
+                {
+                    BestCost = Cost;
+                    BestAxis = Axis;
+                    BestSplit = Low + Split / Scale;
+                }
+            }
+        }
+        const LeafCost = SurfaceArea(Nodes[Node].Minimum, Nodes[Node].Maximum) * Count;
+        let Middle = First;
+        if (BestAxis >= 0 && BestCost < LeafCost)
+        {
+            let Cursor = First, Tail = First + Count - 1;
+            while (Cursor <= Tail)
+            {
+                if (Centroids[Order[Cursor] * 3 + BestAxis] < BestSplit)
+                    ++Cursor;
+                else
+                {
+                    const Swap = Order[Cursor];
+                    Order[Cursor] = Order[Tail];
+                    Order[Tail] = Swap;
+                    --Tail;
+                }
+            }
+            Middle = Cursor;
+        }
+        if (Middle === First || Middle === First + Count)
+        {
+            if (Count <= LeafCapacity * 4)
+            {
+                Nodes[Node].LeftOrFirst = First;
+                Nodes[Node].Count = Count;
+                return;
+            }
+            Middle = First + (Count >> 1);
+        }
+        const Left = ConstructNode();
+        ConstructNode();
+        Nodes[Node].LeftOrFirst = Left;
+        Nodes[Node].Count = 0;
+        Subdivide(Left, First, Middle - First);
+        Subdivide(Left + 1, Middle, First + Count - Middle);
+    };
+
+    const Root = ConstructNode();
+    Subdivide(Root, 0, FacetCount);
+
+    const NodeBytes = new ArrayBuffer(Nodes.length * 32);
+    const NodeScalars = new Float32Array(NodeBytes);
+    const NodeIntegers = new Uint32Array(NodeBytes);
+    Nodes.forEach((Node, Index) =>
+    {
+        NodeScalars.set(Node.Minimum, Index * 8);
+        NodeIntegers[Index * 8 + 3] = Node.LeftOrFirst;
+        NodeScalars.set(Node.Maximum, Index * 8 + 4);
+        NodeIntegers[Index * 8 + 7] = Node.Count;
+    });
+
+    const Ordered = new Float32Array(FacetCount * 12);
+    for (let Index = 0; Index < FacetCount; ++Index)
+    {
+        const Facet = Order[Index];
+        for (let Corner = 0; Corner < 3; ++Corner)
+        {
+            Ordered[Index * 12 + Corner * 4 + 0] = Corners[Facet * 9 + Corner * 3 + 0];
+            Ordered[Index * 12 + Corner * 4 + 1] = Corners[Facet * 9 + Corner * 3 + 1];
+            Ordered[Index * 12 + Corner * 4 + 2] = Corners[Facet * 9 + Corner * 3 + 2];
+        }
+    }
+    return { NodeScalars, NodeCount: Nodes.length, FacetCorners: Ordered, FacetCount };
+}
