+import { ProjectZeroIconUris } from "./ProjectZeroIcons.js";
+
+// 📝 An icon element: uses ProjectZeroEditor's native EngineContent/Icons artwork for all shared entities & controls,
+//    falling back to Frontier's inline stroke glyph only for entities that do not exist in ProjectZeroEditor.
+export function ConstructGlyph(Name, Size = 16, StrokeWidth = 1.6)
+{
+    const Wrapper = document.createElement("span");
+    Wrapper.className = "glyph";
+    const NativeUri = ProjectZeroIconUris[Name];
+    if (NativeUri)
+    {
+        const Image = document.createElement("img");
+        Image.src = NativeUri;
+        Image.width = Size;
+        Image.height = Size;
+        Image.alt = "";
+        Image.draggable = false;
+        Image.style.cssText = `width:${Size}px;height:${Size}px;display:block;object-fit:contain;pointer-events:none;`;
+        Wrapper.appendChild(Image);
+        return Wrapper;
+    }
+    Wrapper.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="${Size}" height="${Size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" `
+                      + `stroke-width="${StrokeWidth}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${EditorGlyphs[Name] || ""}</svg>`;
+    return Wrapper;
+}
