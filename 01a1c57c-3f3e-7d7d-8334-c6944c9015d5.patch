+        const U = (ClientX - Rect.left) / Math.max(1.0, Rect.width);
+        const V = (ClientY - Rect.top) / Math.max(1.0, Rect.height);
+        const NdcX = U * 2.0 - 1.0;
+        const NdcY = 1.0 - V * 2.0;
+        const C = this.CameraState;
+        const Origin = C.Position;
