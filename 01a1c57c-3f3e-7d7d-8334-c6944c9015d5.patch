+    const panel = 6;
+    const n = Math.max(2, Math.round(len / panel));
+    for (const side of [-1, 1]) {
+      const off = side * (w / 2 - 0.2);
+      // chords
+      beam(struct, P(0, off, deckY), P(len, off, deckY), 0.35);
+      beam(struct, P(0, off, deckY + h), P(len, off, deckY + h), 0.35);
+      for (let i = 0; i <= n; i++) {
