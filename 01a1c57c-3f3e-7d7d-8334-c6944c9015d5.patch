+export function ConstructTopNotch(Root, Host, Callbacks = {}) {
+    if (!Root) return null;
+    let CurrentPage = "Dashboard";
+    let NotificationsEnabled = true;
+
+    const Drawer = AttachDrawerController({
+        Root,
+        Edge: "top",
+        HandleLabel: "Control Center",
+        HandleClass: "notch-handle",
+        InitialFraction: 0.5,
+        DefaultHeight: 510,
