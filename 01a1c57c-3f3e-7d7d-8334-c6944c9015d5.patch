+                    if (LocalOrigin[Axis] < Min[Axis] - 0.05 || LocalOrigin[Axis] > Max[Axis] + 0.05) { HitBox = false; break; }
+                }
+                else
+                {
+                    let T1 = (Min[Axis] - 0.05 - LocalOrigin[Axis]) / D;
+                    let T2 = (Max[Axis] + 0.05 - LocalOrigin[Axis]) / D;
+                    if (T1 > T2) { const Tmp = T1; T1 = T2; T2 = Tmp; }
+                    TMin = Math.max(TMin, T1);
+                    TMax = Math.min(TMax, T2);
+                    if (TMin > TMax) { HitBox = false; break; }
+                }
+            }
+            if (!HitBox)
+                continue;
+
+            for (const Facet of Set.Facets)
+            {
+                const T = IntersectVehicleFacet(LocalOrigin, LocalDir, Facet.Corners);
+                if (T !== null && T > 0.01 && T < BestT)
+                {
+                    BestT = T;
+                    BestEntity = EntityId;
+                }
+            }
+        }
+
+        // Kick off hardware WebGPU G-buffer IdentityTexture (r16float) readback in parallel
+        const GpuPickPromise = (this.Surface?.ReadPixelOccupantId && this.ScreenExtent)
+            ? this.Surface.ReadPixelOccupantId(Math.floor(U * this.ScreenExtent[0]), Math.floor(V * this.ScreenExtent[1]))
+            : Promise.resolve(null);
+
+        const ApplyPicked = (PickedId) =>
+        {
+            if (!PickedId) return;
+            if (PickedId.startsWith("shape-"))
+            {
+                if (this.Shell) this.Shell.Selected = PickedId;
+                this.Shell?.RefreshSceneOutliner?.(PickedId);
+            }
+            else
+            {
+                this.Shell?.SelectEntity?.(PickedId);
+            }
+        };
+
+        if (BestEntity)
+        {
+            ApplyPicked(BestEntity);
+            GpuPickPromise.then((GpuOcc) => { if (GpuOcc !== null) this.LastGpuPickedOccupant = GpuOcc; });
+            return;
+        }
+
+        const GpuOcc = await GpuPickPromise;
+        this.LastGpuPickedOccupant = GpuOcc;
+        const GpuEntity = GpuOcc !== null ? this.MapOccupantToEntityId(GpuOcc) : null;
+        if (GpuEntity)
+            ApplyPicked(GpuEntity);
+    }
+
+    FocusSelectedEntity()
+    {
+        const SelectedId = this.Shell?.Selected || this.Shell?.SelectedId;
+        const Pose = this.QueryEntityTransformPose(SelectedId);
+        if (!Pose)
+            return;
+        const Target = Pose.Position;
+        const Eye = [Target[0] + 4.8, Target[1] + 4.2, Target[2] + 2.2];
+        if (this.FreeCamera || this.EditorFlightActive || !this.Lobby)
+        {
+            this.Flight.AssignFromChase(Eye, Target);
+            this.EditorFlightActive = true;
+        }
+        else if (this.Orbit)
+        {
+            const Dx = Target[0] - this.Vehicle.Position[0];
+            const Dy = Target[1] - this.Vehicle.Position[1];
+            if (Math.hypot(Dx, Dy) > 0.5)
+                this.Orbit.Yaw = Math.atan2(Dy, Dx);
+            this.Orbit.Distance = 5.8;
+        }
+        this.Shell?.Announce?.(`Focused ${SelectedId}`);
+    }
+
+    ReportFailure(Message, Fatal)
+    {
+        const Panel = document.getElementById("failure");
+        if (!Panel) { console.error(Message); if (Fatal) this.Failed = true; return; }
+        Panel.classList.remove("hidden");
+        const Line = document.createElement("div");
+        Line.textContent = Message;
+        Panel.appendChild(Line);
+        if (Fatal)
+            this.Failed = true;
+    }
+}
+
+const Host = new IlluminationHost();
+Host.ConstructExhibit().catch((Failure) =>
+{
+    console.error(Failure);
+    const Text = String(Failure && Failure.message ? Failure.message : Failure);
+    Host.Splash?.MarkFailure(Text);
+    Host.LogStream?.RecordDiagnostic("Render", Text, "IlluminationHost.js", "fatal", "fatal");
+    Host.ReportFailure(Text, true);
+    const Overlay = document.getElementById("bring-up");
+    if (Overlay)
+        Overlay.classList.add("hidden");
+});
