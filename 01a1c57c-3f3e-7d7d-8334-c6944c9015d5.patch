+    body='''<circle cx="128" cy="128" r="105" fill="url(#atmosphere-altitude)"/><circle cx="128" cy="128" r="65" fill="url(#atmosphere-surface)"/><circle cx="128" cy="128" r="84" fill="url(#atmosphere-light)"/>'''
