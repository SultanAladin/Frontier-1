+/* ============================================================================================================================================
+                                                            WORKSPACEDOCK.CSS
+   ============================================================================================================================================
+   Dockable multi-zone editor workspace (Left, Center Viewport, Right, Bottom, Floating Windows) with drag-and-drop tabs & splitters.
+*/
+
+.fe-dock-workspace {
+    position: relative;
+    flex: 1 1 auto;
+    min-height: 0;
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+    background: #141515;
+    overflow: hidden;
+}
+
+.fe-dock-upper {
+    flex: 1 1 auto;
+    min-height: 160px;
+    min-width: 0;
+    display: flex;
+    flex-direction: row;
+    overflow: hidden;
+}
+
+.fe-dock-zone {
+    display: flex;
+    flex-direction: column;
+    min-height: 0;
+    min-width: 0;
+    background: #1e1f1f;
+    overflow: hidden;
+    position: relative;
+}
+
+.fe-dock-zone[hidden] {
+    display: none !important;
+}
+
+.fe-dock-left {
+    flex: 0 0 var(--fe-left-width, 252px);
+    border-right: 1px solid #2b2d2d;
+}
+
+.fe-dock-right {
+    flex: 0 0 var(--fe-right-width, 336px);
+    border-left: 1px solid #2b2d2d;
+}
+
+.fe-dock-bottom {
+    flex: 0 0 var(--fe-bottom-height, 210px);
+    border-top: 1px solid #2b2d2d;
+}
+
+.fe-dock-center {
+    flex: 1 1 auto;
+    min-width: 220px;
+    min-height: 140px;
+    display: flex;
+    flex-direction: column;
+    position: relative;
+    background: #0d0e0e;
+    overflow: hidden;
+}
+
+/* Splitters */
+.fe-dock-splitter-v {
+    flex: 0 0 5px;
+    cursor: col-resize;
+    background: transparent;
+    position: relative;
+    z-index: 12;
+    margin: 0 -2px;
+    transition: background 100ms ease;
+}
+
+.fe-dock-splitter-h {
+    flex: 0 0 5px;
+    cursor: row-resize;
+    background: transparent;
+    position: relative;
+    z-index: 12;
+    margin: -2px 0;
+    transition: background 100ms ease;
+}
+
+.fe-dock-splitter-v:hover,
+.fe-dock-splitter-h:hover,
+.fe-dock-splitter-active {
+    background: rgba(127, 216, 170, 0.45);
+}
+
+.fe-dock-splitter-v[hidden],
+.fe-dock-splitter-h[hidden] {
+    display: none !important;
+}
+
+/* Tab strip inside each dock zone */
+.fe-dock-tabbar {
+    flex: 0 0 28px;
+    height: 28px;
+    display: flex;
+    align-items: stretch;
+    background: #161717;
+    border-bottom: 1px solid #2a2b2b;
+    padding: 0 4px;
+    gap: 2px;
+    user-select: none;
+}
+
+.fe-dock-tabs {
+    flex: 1 1 auto;
+    display: flex;
+    align-items: flex-end;
+    gap: 2px;
+    overflow-x: auto;
+    scrollbar-width: none;
+}
+
+.fe-dock-tab {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    height: 24px;
+    padding: 0 9px;
+    border: 1px solid transparent;
+    border-bottom: none;
+    border-radius: 5px 5px 0 0;
+    background: transparent;
+    color: #8f9490;
+    font: 500 11.5px/1 "DM Sans", system-ui, sans-serif;
+    cursor: grab;
+    white-space: nowrap;
+}
+
+.fe-dock-tab:hover {
+    color: #d6dad4;
+    background: rgba(255, 255, 255, 0.04);
+}
+
+.fe-dock-tab.is-active {
+    background: #1e1f1f;
+    color: #eef1ec;
+    border-color: #2d2f2f;
+}
+
+.fe-dock-tab-grip {
+    opacity: 0.45;
+    font-size: 10px;
+    letter-spacing: -1px;
+}
+
+.fe-dock-zone-actions {
+    display: inline-flex;
+    align-items: center;
+    gap: 2px;
+    margin-left: auto;
+}
+
+.fe-dock-iconbtn {
+    height: 20px;
+    min-width: 20px;
+    padding: 0 5px;
+    border: 1px solid transparent;
+    border-radius: 4px;
+    background: transparent;
+    color: #8c918d;
+    font: 500 11px/1 "DM Sans", system-ui, sans-serif;
+    cursor: pointer;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+}
+
+.fe-dock-iconbtn:hover {
+    background: #2a2c2c;
+    color: #eef1ec;
+    border-color: #3a3d3d;
+}
+
+.fe-dock-body {
+    flex: 1 1 auto;
+    min-height: 0;
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+    overflow: hidden;
+}
+
+.fe-dock-body > * {
+    flex: 1 1 auto;
+    min-height: 0;
+    width: 100% !important;
+    border: none !important;
+}
+
+/* Override fixed widths from legacy static panels when inside dock */
+.fe-dock-body .ed-outliner,
+.fe-dock-body .ed-inspector,
+.fe-dock-body .fe-log-drawer {
+    width: 100% !important;
+    height: 100% !important;
+    max-height: none !important;
+    flex: 1 1 auto !important;
+}
+
+.fe-dock-body .ed-panel-head,
+.fe-dock-body > .column > .column-tabs {
+    display: none !important;
+}
+
+.fe-dock-body #log-stream-enclosure {
+    display: flex !important;
+    position: relative !important;
+    inset: auto !important;
+    width: 100% !important;
+    height: 100% !important;
+    max-height: none !important;
+    border-top: none !important;
+}
+
+body.panels-hidden .fe-dock-zone,
+body.panels-hidden .fe-dock-splitter-v,
+body.panels-hidden .fe-dock-splitter-h,
+body.panels-hidden .fe-dock-floating-layer {
+    display: none !important;
+}
+
+/* Floating dock windows */
+.fe-dock-floating-layer {
+    position: absolute;
+    inset: 0;
+    pointer-events: none;
+    z-index: 35;
+}
+
+.fe-dock-float {
+    position: absolute;
+    pointer-events: auto;
+    display: flex;
+    flex-direction: column;
+    background: rgba(28, 30, 30, 0.96);
+    border: 1px solid #3c403e;
+    border-radius: 8px;
+    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.62);
+    backdrop-filter: blur(10px);
+    overflow: hidden;
+    min-width: 240px;
+    min-height: 170px;
+    resize: both;
+}
+
+.fe-dock-float-head {
+    flex: 0 0 28px;
+    height: 28px;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 0 8px 0 10px;
+    background: #151717;
+    border-bottom: 1px solid #2c2e2e;
+    cursor: move;
+    user-select: none;
+    color: #e6eae4;
+    font: 600 11.5px/1 "DM Sans", system-ui, sans-serif;
+}
+
+/* Drag-and-drop overlay targets */
+.fe-dock-drop-overlay {
+    position: absolute;
+    inset: 0;
+    z-index: 50;
+    pointer-events: none;
+    display: none;
+}
+
+.fe-dock-workspace.is-dragging-tab .fe-dock-drop-overlay {
+    display: block;
+}
+
+.fe-dock-drop-target {
+    position: absolute;
+    pointer-events: auto;
+    border: 1.5px dashed rgba(127, 216, 170, 0.55);
+    background: rgba(34, 62, 48, 0.26);
+    border-radius: 8px;
+    color: #dcf5e7;
+    font: 600 12px/1 "DM Sans", system-ui, sans-serif;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    transition: background 90ms ease, transform 90ms ease, border-color 90ms ease;
+}
+
+.fe-dock-drop-target.is-hovered {
+    background: rgba(62, 196, 109, 0.34);
+    border-color: #7fd8aa;
+    transform: scale(1.01);
+}
+
+.fe-dock-drop-target[data-slot="left"]   { left: 10px; top: 10px; bottom: 10px; width: 170px; }
+.fe-dock-drop-target[data-slot="right"]  { right: 10px; top: 10px; bottom: 10px; width: 170px; }
+.fe-dock-drop-target[data-slot="bottom"] { left: 192px; right: 192px; bottom: 10px; height: 120px; }
+.fe-dock-drop-target[data-slot="float"]  { left: 50%; top: 22px; transform: translateX(-50%); width: 190px; height: 52px; }
+
+/* Quick dock placement menu */
+.fe-dock-menu {
+    position: fixed;
+    z-index: 80;
+    min-width: 164px;
+    padding: 4px;
+    background: #181a1a;
+    border: 1px solid #383b3a;
+    border-radius: 7px;
+    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.58);
+    display: flex;
+    flex-direction: column;
+    gap: 1px;
+}
+
+.fe-dock-menu button {
+    border: none;
+    background: transparent;
+    color: #d6dad4;
+    text-align: left;
+    padding: 6px 9px;
+    border-radius: 4px;
+    font: 500 11.5px/1.2 "DM Sans", system-ui, sans-serif;
+    cursor: pointer;
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+}
+
+.fe-dock-menu button:hover {
+    background: #2a2e2c;
+    color: #ffffff;
+}
diff --git a/Experimental/FrontierEngine/Tools/AuthorLightingProfiles.py b/Experimental/FrontierEngine/Tools/AuthorLightingProfiles.py
new file mode 100644
index 0000000..172d308
--- /dev/null
+++ b/Experimental/FrontierEngine/Tools/AuthorLightingProfiles.py
@@ -0,0 +1,53 @@
+"""Generate the AUTHORED LM-63 Type C intensity tables: the three automotive beams (LowBeam, HighBeam, FogBeam).
+
+These curves are authored demonstrations, not measured or certified IES data (their headers say so). Roadway, Area, RoofFlood and RoofSpot are no longer authored: they are real
+manufacturer / test-lab files copied verbatim into Profiles/ (Profiles/README.md, Profiles/PROVENANCE.json), and this script must never overwrite them.
+Angles use C-planes around each fixture's optical axis, not world coordinates.
+
+    python3 Tools/AuthorLightingProfiles.py [output directory]     (default: ../Profiles)
+"""
+import sys
+from math import atan2, cos, exp, pi, sin, degrees
+from pathlib import Path
+
+AUTHORED = ("LowBeam", "HighBeam", "FogBeam")
+ROOT = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent / "Profiles"
+ROOT.mkdir(exist_ok=True, parents=True)
+
+
+def gaussian(value, width):
+    return exp(-0.5 * (value / width) ** 2)
+
+
+def cutoff(height, threshold, softness=0.8):
+    return 1.0 / (1.0 + exp(max(-60, min(60, (height - threshold) / softness))))
+
+
+def sample(name, polar, azimuth):
+    v, h = polar * pi / 180, azimuth * pi / 180
+    # +up is C0, +right is C90. The vehicle is on a left-hand-traffic
+    # road: its left verge (negative C angle) gets the low-beam upsweep.
+    elevation = degrees(atan2(sin(v) * cos(h), cos(v)))
+    lateral = degrees(atan2(sin(v) * sin(h), cos(v)))
+    if name == "LowBeam":
+        upsweep = 1.5 if lateral < -12 else 0.0
+        return gaussian(lateral, 24) * gaussian(elevation + 3.0, 7.5) * cutoff(elevation, 0.8 + upsweep, 0.55)
+    if name == "HighBeam":
+        return gaussian(lateral, 15) * gaussian(elevation + 1.0, 7.0)
+    if name == "FogBeam":
+        return gaussian(lateral, 48) * gaussian(elevation + 1.5, 4.5) * cutoff(elevation, 1.5, 0.8)
+    raise ValueError(name)
+
+
+for name in AUTHORED:
+    vertical = list(range(0, 181, 2))
+    horizontal = list(range(0, 361, 10))
+    # Peak candela is encoded in the file for standard readers; the exhibit
+    # normalises the shape and uses the inspector's calibrated scene intensity.
+    scale = 1000.0
+    grid = [max(0.0, sample(name, v, h)) * scale for h in horizontal for v in vertical]
+    lines = ["IESNA:LM-63-2002", "[TEST] Frontier authored demonstration profile - not measured photometry",
+             f"[LUMINAIRE] {name}", "TILT=NONE", f"1 1000 1 {len(vertical)} {len(horizontal)} 1 2 0.30 0.30 0.15",
+             "1 1 60", " ".join(map(str, vertical)), " ".join(map(str, horizontal))]
+    lines += [" ".join(f"{value:.5f}" for value in grid[i:i + len(vertical)]) for i in range(0, len(grid), len(vertical))]
+    (ROOT / f"{name}.ies").write_text("\n".join(lines) + "\n", encoding="ascii")
diff --git a/Experimental/FrontierEngine/Tools/BenchHooks.mjs b/Experimental/FrontierEngine/Tools/BenchHooks.mjs
