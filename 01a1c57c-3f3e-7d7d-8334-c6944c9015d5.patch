+    padding: 12px 7px 10px;
+    min-width: 0;
+    min-height: 135px;
+    background: linear-gradient(135deg, #252525, #1b1b1b);
+    border: 1px solid #ffffff0c;
+    border-radius: 16px;
+    color: #c3c3c3;
+    cursor: pointer;
+}
+.asset-catalogue.list .asset-cell {
+    flex-direction: row;
+    min-height: 56px;
+    gap: 14px;
+    padding: 7px 12px;
+}
+.asset-cell:hover { border-color: #ffffff25; background: #282828; }
+.asset-cell.selected {
+    border-color: #c7ae805c;
+    background: linear-gradient(140deg, #39352e, #24221f);
+}
+.asset-thumbnail {
+    display: grid;
+    place-items: center;
+    height: 78px;
+    width: 100%;
+}
+.asset-catalogue.list .asset-thumbnail { width: 44px; height: 42px; flex: none; }
+.asset-thumbnail img { width: 58px; height: 58px; object-fit: contain; }
+.asset-material-orb {
+    display: block;
+    width: 54px;
+    height: 54px;
+    border-radius: 50%;
+    background:
+        radial-gradient(circle at 35% 27%, #fffd, transparent 12%),
+        radial-gradient(circle at 35% 30%, var(--orb, #88aacc), #111 90%);
+    box-shadow: 0 6px 8px #0008, inset -2px -2px 5px #0007;
+}
+.asset-catalogue.list .asset-material-orb { width: 34px; height: 34px; }
+.asset-kind-icon { font-size: 34px; color: #b1a796; }
+.asset-cell-name {
+    width: 100%;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+    font-size: 10px;
+    text-align: center;
+    margin-top: 6px;
+}
+.asset-catalogue.list .asset-cell-name { text-align: left; margin-top: 0; }
+.asset-cell-name small { display: block; font-size: 8px; color: #757575; margin-top: 4px; }
+
+.asset-preview {
+    overflow: auto;
+    padding: 18px 0 18px 20px;
+    border-left: 1px solid #ffffff0b;
+    min-width: 0;
+}
+.asset-preview-heading { display: flex; justify-content: space-between; align-items: center; }
+.asset-origin-label {
+    padding: 3px 8px;
+    border: 1px solid #ffffff12;
+    border-radius: 12px;
+    font-size: 8.5px;
+    color: #9d8f7c;
+}
+.asset-preview h2 { font-weight: 300; font-size: 20px; color: #e2e2e2; margin: 12px 0 14px; }
+.asset-preview p { font-size: 10.5px; color: #8b8b8b; line-height: 1.6; }
+.asset-preview dl {
+    display: grid;
+    grid-template-columns: auto 1fr;
+    gap: 8px;
+    font-size: 10px;
+    padding: 12px 0;
+    border-top: 1px solid #ffffff0a;
+    color: #787878;
+}
+.asset-preview dd { margin: 0; text-align: right; color: #bcbcbc; }
+.asset-preview-actions {
+    display: flex;
+    flex-direction: column;
+    gap: 8px;
+    margin-top: 12px;
+}
+.asset-preview-actions button {
+    width: 100%;
+    padding: 9px 12px;
+    border-radius: 14px;
+    border: 1px solid #ffffff14;
+    background: #232323;
+    color: #ececec;
+    font-size: 11px;
+    cursor: pointer;
+}
+.asset-preview-actions button.primary {
+    background: #3b82f6;
+    border-color: #3b82f6;
+    color: #fff;
+}
+.asset-browser-footer {
+    height: 36px;
+    flex: none;
+    border-top: 1px solid #ffffff0a;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    font-size: 9.5px;
+    color: #6d6d6d;
+}
+
+/* ============================================================================================================================================
+   RESPONSIVE NARROW SPLIT-PANE RULES (~781px Arena Preview & Tablet Widths)
+   ============================================================================================================================================ */
+@media (max-width: 1020px) {
+    .viewport-heading-row {
+        flex-wrap: wrap;
+        gap: 6px;
+        min-height: 40px;
+        padding-top: 6px;
+    }
+    .viewport-identity > div > span,
+    .viewport-preview-badge {
+        display: none;
+    }
+    .viewport-action-row {
+        flex-wrap: wrap;
+        height: auto !important;
+        min-height: 31px;
+        gap: 4px !important;
+        padding: 3px 0;
+    }
+    .viewport-construct kbd {
+        display: none;
+    }
+    .pz-outliner .stats {
+        height: 52px;
+        padding: 4px 8px;
+    }
+    #stage.pz-stage {
+        margin: 0 6px;
+    }
+}
+
+/* ============================================================================================================================================
+   GIZMOPRO 3D OVERLAY, TOOLBAR & READOUT (Gizmo.html 1:1)
+   ============================================================================================================================================ */
+.gizmo-overlay,
+.gizmo-overlay-canvas {
+    position: absolute;
+    inset: 0;
+    width: 100%;
+    height: 100%;
+    pointer-events: none;
+    z-index: 4;
+}
+
+.gizmo-toolbar {
+    position: absolute;
+    top: 10px;
+    left: 10px;
+    z-index: 5;
+    display: inline-flex;
+    align-items: center;
+    gap: 2px;
+    padding: 3px;
+    background: rgba(14, 14, 14, 0.86);
+    border: 1px solid rgba(255, 255, 255, 0.09);
+    border-radius: 9px;
+    backdrop-filter: blur(8px);
+}
+.gizmo-toolbar.hidden { display: none !important; }
+
+.gizmo-tool-btn,
+.gizmo-toolbar button {
+    height: 24px;
+    padding: 0 8px;
+    border-radius: 6px;
+    border: 1px solid transparent;
+    background: transparent;
+    color: #969696;
+    font-size: 10.5px;
+    font-weight: 400;
+    letter-spacing: 0.02em;
+    display: inline-flex;
+    align-items: center;
+    gap: 4px;
+    cursor: pointer;
+}
+.gizmo-tool-btn kbd {
+    font-family: "JetBrains Mono", monospace;
+    font-size: 9px;
+    padding: 1px 4px;
+    border-radius: 3px;
+    background: rgba(255, 255, 255, 0.06);
+    color: #bcbcbc;
+}
+.gizmo-tool-btn:hover,
+.gizmo-toolbar button:hover {
+    color: #f0f0f0;
+    background: rgba(255, 255, 255, 0.06);
+}
+.gizmo-tool-btn.active,
+.gizmo-toolbar button.active {
+    color: #ffffff;
+    background: #252525;
+    border-color: rgba(255, 255, 255, 0.16);
+}
+.gizmo-toolbar-divider,
+.gizmo-sep {
+    width: 1px;
+    height: 14px;
+    background: rgba(255, 255, 255, 0.1);
+    margin: 0 2px;
+}
+
+.gizmo-readout {
+    position: absolute;
+    top: 12px;
+    left: 50%;
+    transform: translateX(-50%);
+    z-index: 6;
+    padding: 6px 14px;
+    background: rgba(12, 12, 12, 0.92);
+    border: 1px solid rgba(255, 255, 255, 0.14);
+    border-radius: 999px;
+    color: #f0f0f0;
+    font: 500 11.5px/1 "JetBrains Mono", Consolas, monospace;
+    letter-spacing: 0.03em;
+    pointer-events: none;
+    white-space: nowrap;
+    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
+}
+.gizmo-readout.hidden { display: none !important; }
+
+/* ============================================================================================================================================
+   INTERACTIVE CAMERA CARDS (SensorField · Iris · DepthOfField — FrontierEditor 1:1)
+   ============================================================================================================================================ */
+.fe-camera-diagram {
+    margin: 6px 0 10px;
+    padding: 10px 10px 8px;
+    background: #141414;
+    border: 1px solid #262626;
+    border-radius: 12px;
+}
+.fe-camera-diagram-svg {
+    width: 100%;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    overflow: hidden;
+}
+.fe-camera-diagram-svg svg {
+    width: 100%;
+    height: auto;
+    display: block;
+}
+.fe-camera-diagram-dof .fe-camera-diagram-svg {
+    cursor: ew-resize;
+    touch-action: none;
+}
+.fe-camera-diagram-meta {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 6px 10px;
+    margin-top: 7px;
+    padding-top: 7px;
+    border-top: 1px solid #202020;
+    font-size: 10.5px;
+    color: #8c8c8c;
+    font-variant-numeric: tabular-nums;
+}
+.fe-camera-diagram-meta b {
+    color: #dcdcdc;
+    font-weight: 500;
+}
+
+/* ============================================================================================================================================
+   ARRAY MODIFIER BLUEPRINT PREVIEW & FOLDER INSPECTOR MEMBERS
+   ============================================================================================================================================ */
+.fe-array-header {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 8px;
+    margin-bottom: 6px;
+}
+.fe-array-badge {
+    font-size: 10.5px;
+    color: #cfcfcf;
+    padding: 3px 8px;
+    border-radius: 999px;
+    background: #1a1a1a;
+    border: 1px solid #2b2b2b;
+}
+.fe-array-remove {
+    font-size: 10.5px;
+    color: #d98282;
+    padding: 3px 8px;
+    border-radius: 6px;
+    border: 1px solid rgba(217, 130, 130, 0.25);
+    background: rgba(217, 130, 130, 0.08);
+    cursor: pointer;
+}
+.fe-array-remove:hover {
+    background: rgba(217, 130, 130, 0.18);
+    color: #ffb3b3;
+}
+.fe-array-diagram {
+    margin: 6px 0 10px;
+    padding: 8px;
+    background: #141414;
+    border: 1px solid #262626;
+    border-radius: 10px;
+}
+.fe-array-diagram svg {
+    width: 100%;
+    height: auto;
+    display: block;
+}
+
+.fe-folder-member-list {
+    display: flex;
+    flex-direction: column;
+    gap: 4px;
+    margin-top: 4px;
+}
+.fe-folder-member {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 10px;
+    padding: 8px 10px;
+    border-radius: 9px;
+    background: #171717;
+    border: 1px solid #262626;
+    color: #e4e4e4;
+    text-align: left;
+    cursor: pointer;
+}
+.fe-folder-member:hover {
+    background: #1f1f1f;
+    border-color: #363636;
+}
+.fe-folder-member-id {
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    font-size: 12px;
+}
+.fe-folder-member-id strong {
+    font-weight: 400;
+}
+.fe-folder-member-meta {
+    font-size: 10.5px;
+    color: #848484;
+    font-variant-numeric: tabular-nums;
+}
+
diff --git a/Experimental/FrontierEngine/Style/SliderControl.css b/Experimental/FrontierEngine/Style/SliderControl.css
new file mode 100644
index 0000000..0170bda
--- /dev/null
+++ b/Experimental/FrontierEngine/Style/SliderControl.css
@@ -0,0 +1,222 @@
+/*==========================================================================================================================================
+                                                            SLIDERCONTROL.CSS
+==========================================================================================================================================
+ 🧩 Canonical Frontier Editor slider: two-cell ValuePill (#050505 number cell + #191919 unit cell) above a 22 px neutral pill track.
+
+ 📝 Matches Engine/Interface/ControlKit.cpp (ControlKit::Slider & ControlKit::ValuePill) and VehicleHmiPrototype/Style/SliderControl.css:
+    • Full 22 px hit band (never a 3 px sliver); neutral rail #171818, neutral fill #555650 (never an accent bar), #e2e4d8 20 px knob.
+    • Fill terminates at the exact knob centre: calc(10px + var(--slider-ratio, 0) * (100% - 20px)), eliminating end-cap bleed at 0% / 100%.
+    • ValuePill clips two flush cells inside one 999 px border so number and unit meet at a crisp 1 px #282828 seam.
+==========================================================================================================================================*/
+
+.frontier-slider.control
+{
+    display: block;
+    min-width: 0;
+    margin-top: 16px;
+}
+
+.frontier-slider.control:first-child
+{
+    margin-top: 0;
+}
+
+.frontier-slider .frontier-slider-head
+{
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    margin-bottom: 9px;
+    min-height: 26px;
+}
+
+.frontier-slider .frontier-slider-label
+{
+    font-size: 11px;
+    line-height: 1.35;
+    color: #b0b0b0;
+    min-width: 0;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+    cursor: ew-resize;
+    user-select: none;
+    transition: color 0.15s ease;
+}
+
+.frontier-slider .frontier-slider-label:hover,
+.frontier-slider.is-scrubbing .frontier-slider-label
+{
+    color: #ececec;
+}
+
+/* 📐 Two cells flush inside one rounded pill: #050505 number cell on the left, #191919 unit cell on the right. */
+.frontier-slider .frontier-slider-value
+{
+    display: inline-flex;
+    align-items: stretch;
+    flex: 0 0 auto;
+    height: 26px;
+    min-width: 78px;
+    border-radius: 999px;
+    border: 1px solid #2b2b2b;
+    background: #050505;
+    overflow: hidden;
+    font-variant-numeric: tabular-nums;
+    transition: border-color 0.16s ease, box-shadow 0.16s ease;
+}
+
+.frontier-slider .frontier-slider-value:hover
+{
+    border-color: #3d3d3d;
+}
+
+.frontier-slider .frontier-slider-value:focus-within
+{
+    border-color: #6a6d6a;
+    box-shadow: 0 0 0 2px rgba(226, 228, 216, 0.08);
+}
+
+.frontier-slider .frontier-slider-number
+{
+    width: 56px;
+    min-width: 0;
+    flex: 1 1 auto;
+    padding: 0 10px;
+    border: 0 !important;
+    background: #050505 !important;
+    color: #e6e6de;
+    font: 400 11.5px/24px "DM Sans", sans-serif;
+    font-variant-numeric: tabular-nums;
+    text-align: right;
+    outline: none;
+    appearance: textfield;
+}
+
+.frontier-slider .frontier-slider-value.has-unit .frontier-slider-number
+{
+    padding: 0 8px 0 11px;
+}
+
+.frontier-slider .frontier-slider-number::-webkit-inner-spin-button,
+.frontier-slider .frontier-slider-number::-webkit-outer-spin-button
+{
+    appearance: none;
+    margin: 0;
+}
+
+.frontier-slider .frontier-slider-unit
+{
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    min-width: 28px;
+    padding: 0 8px 0 7px;
+    background: #191919;
+    border-left: 1px solid #2a2a2a;
+    color: #93938c;
+    font-size: 10px;
+    letter-spacing: 0.01em;
+    white-space: nowrap;
+    user-select: none;
+}
+
+/* 📐 Full-width 22 px pill rail with thumb-centre-aligned neutral fill. */
+.frontier-slider input.frontier-slider-track
+{
+    --thumb-stop: calc(10px + var(--slider-ratio, 0) * (100% - 20px));
+    display: block;
+    appearance: none;
+    -webkit-appearance: none;
+    width: 100%;
+    height: 22px;
+    min-height: 22px;
+    margin: 0;
+    padding: 0 1px;
+    border: 1px solid #252626;
+    border-radius: 999px;
+    cursor: ew-resize;
+    background: linear-gradient(90deg, #555650 0%, #555650 var(--thumb-stop), #171818 var(--thumb-stop), #171818 100%);
+    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.55);
+    transition: border-color 0.16s ease;
+}
+
+.frontier-slider input.frontier-slider-track:hover
+{
+    border-color: #383938;
+}
+
+.frontier-slider input.frontier-slider-track::-webkit-slider-runnable-track
+{
+    height: 20px;
+    background: transparent;
+    border-radius: 999px;
+}
+
+.frontier-slider input.frontier-slider-track::-webkit-slider-thumb
+{
+    appearance: none;
+    -webkit-appearance: none;
+    width: 18px;
+    height: 18px;
+    margin-top: 1px;
+    border: 0;
+    border-radius: 50%;
+    background: #e2e4d8;
+    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(0, 0, 0, 0.25);
+    transition: transform 0.14s cubic-bezier(0.22, 0.61, 0.36, 1), background-color 0.14s ease, box-shadow 0.14s ease;
+}
+
+.frontier-slider input.frontier-slider-track:hover::-webkit-slider-thumb
+{
+    background: #f2f3ec;
+}
+
+.frontier-slider input.frontier-slider-track:active::-webkit-slider-thumb
+{
+    transform: scale(1.1);
+    background: #ffffff;
+    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.65), 0 0 0 3px rgba(226, 228, 216, 0.14);
+}
+
+.frontier-slider input.frontier-slider-track::-moz-range-track
+{
+    height: 20px;
+    background: transparent;
+    border-radius: 999px;
+}
+
+.frontier-slider input.frontier-slider-track::-moz-range-thumb
+{
+    width: 18px;
+    height: 18px;
+    border: 0;
+    border-radius: 50%;
+    background: #e2e4d8;
+    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.55);
+    transition: transform 0.14s cubic-bezier(0.22, 0.61, 0.36, 1), background-color 0.14s ease;
+}
+
+.frontier-slider input.frontier-slider-track:active::-moz-range-thumb
+{
+    transform: scale(1.1);
+    background: #ffffff;
+}
+
+.frontier-slider input.frontier-slider-track:focus-visible
+{
+    outline: 2px solid #9db4c0;
+    outline-offset: 2px;
+}
+
+.frontier-slider .range-labels
+{
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    font-size: 9.5px;
+    color: #7c7c78;
+    margin-top: 7px;
+    padding: 0 2px;
+}
diff --git a/Experimental/FrontierEngine/Style/SplashEnclosure.css b/Experimental/FrontierEngine/Style/SplashEnclosure.css
new file mode 100644
index 0000000..47be7a3
--- /dev/null
+++ b/Experimental/FrontierEngine/Style/SplashEnclosure.css
@@ -0,0 +1,520 @@
+/*==========================================================================================================================================
+                                                           SPLASHENCLOSURE.CSS
+==========================================================================================================================================
+ 🧩 FrontierEngine startup splash screen, live GPU bring-up progress bar, and level picker (Proving Grounds · Lobby / Garage).
+==========================================================================================================================================*/
+
+#lobby
+{
+    position: fixed;
+    inset: 0;
+    z-index: 60;
+    display: grid;
+    grid-template-rows: 1fr auto;
+    place-items: center;
+    row-gap: 12px;
+    padding: 28px;
+    background: rgba(8, 8, 8, 0.96);
+    backdrop-filter: blur(14px);
+    opacity: 1;
+    visibility: visible;
+    transition: opacity 0.38s cubic-bezier(0.22, 0.61, 0.36, 1), visibility 0.38s ease;
+}
+
+#lobby.hidden
+{
+    display: none !important;
+}
+
+body.lobby-open #shell
+{
+    pointer-events: none;
+}
+
+#lobby.leaving
+{
+    opacity: 0;
+    visibility: hidden;
+    pointer-events: none;
+}
+
+.lobby-aurora
+{
+    position: absolute;
+    inset: -20%;
+    background:
+        radial-gradient(closest-side at 22% 28%, rgba(92, 118, 96, 0.14), transparent 70%),
+        radial-gradient(closest-side at 78% 72%, rgba(96, 108, 128, 0.12), transparent 72%),
+        radial-gradient(closest-side at 62% 18%, rgba(142, 114, 88, 0.08), transparent 70%);
+    filter: blur(10px);
+    animation: splash-drift 24s ease-in-out infinite alternate;
+    pointer-events: none;
+}
+
+@keyframes splash-drift
+{
+    from { transform: translate3d(-1.2%, -0.8%, 0) scale(1.02); }
+    to   { transform: translate3d(1.2%, 1.2%, 0) scale(1.06); }
+}
+
+.lobby-panel
+{
+    position: relative;
+    width: min(1060px, 100%);
+    max-height: min(670px, 100%);
+    min-height: 0;
+    display: grid;
+    grid-template-rows: auto minmax(0, 1fr) auto;
+    background: linear-gradient(158deg, #191a1a 0%, #131414 54%, #0e0f0f 100%);
+    border: 1px solid #2b2c2c;
+    border-radius: 20px;
+    box-shadow: 0 42px 120px rgba(0, 0, 0, 0.72), inset 0 1px 0 rgba(255, 255, 255, 0.045);
+    overflow: hidden;
+}
+
+.lobby-top
+{
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 18px;
+    padding: 18px 28px 15px;
+    border-bottom: 1px solid #232424;
+    background: rgba(12, 12, 12, 0.45);
+}
+
+.lobby-mark
+{
+    display: inline-flex;
+    align-items: center;
+    gap: 9px;
+    font-size: 17px;
+    font-weight: 500;
+    letter-spacing: -0.02em;
+    color: #efefef;
+}
+
+.lobby-dot
+{
+    color: var(--on);
+}
+
+.lobby-build
+{
+    font-size: 9.5px;
+    letter-spacing: 0.2em;
+    color: #7c7e7c;
+    text-transform: uppercase;
+    text-align: right;
+}
+
+.lobby-body
+{
+    display: grid;
+    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.85fr);
+    gap: 30px;
+    align-items: center;
+    padding: 26px 30px 22px;
+    min-height: 0;
+    overflow-y: auto;
+}
+
+.lobby-copy
+{
+    display: flex;
+    flex-direction: column;
+    align-items: flex-start;
+    gap: 13px;
+    min-width: 0;
+}
+
+.lobby-kicker
+{
+    font-size: 9.5px;
+    letter-spacing: 0.24em;
+    text-transform: uppercase;
+    color: #849986;
+}
+
+.lobby-copy h1
+{
+    font-size: clamp(32px, 4vw, 48px);
+    font-weight: 300;
+    line-height: 1.0;
+    letter-spacing: -0.035em;
+    color: #f2f2ee;
+}
+
+.lobby-lede
+{
+    max-width: 52ch;
+    font-size: 12.5px;
+    line-height: 1.56;
+    color: #a9aba8;
+}
+
+.lobby-chips
+{
+    display: flex;
