+fn Slate_RecoverVelocity_0( X_2 : f32,  Y_2 : f32,  Z_2 : f32,  PreviousX_1 : f32,  PreviousY_1 : f32,  PreviousZ_1 : f32,  RigidX_0 : f32,  RigidY_0 : f32,  RigidZ_0 : f32,  Damping_0 : f32,  Substep_0 : f32,  VelocityX_2 : ptr<function, f32>,  VelocityY_2 : ptr<function, f32>,  VelocityZ_2 : ptr<function, f32>)
+{
+    var Inverse_0 : f32 = 1.0f / Substep_0;
+    var Retained_0 : f32 = 1.0f - Damping_0 * Substep_0;
+    var Retained_1 : f32;
+    if(Retained_0 < 0.0f)
+    {
+        Retained_1 = 0.0f;
+    }
+    else
+    {
+        Retained_1 = Retained_0;
+    }
+    (*VelocityX_2) = RigidX_0 + ((X_2 - PreviousX_1) * Inverse_0 - RigidX_0) * Retained_1;
+    (*VelocityY_2) = RigidY_0 + ((Y_2 - PreviousY_1) * Inverse_0 - RigidY_0) * Retained_1;
+    (*VelocityZ_2) = RigidZ_0 + ((Z_2 - PreviousZ_1) * Inverse_0 - RigidZ_0) * Retained_1;
+    return;
+}
+
+struct Slate_TyreVelocityRecord_0
+{
+     VelocityX_0 : f32,
+     VelocityY_0 : f32,
+     VelocityZ_0 : f32,
+     FrictionMultiplier_0 : f32,
+};
+
+struct Slate_TyreMotionRecord_0
+{
+     PreviousX_0 : f32,
+     PreviousY_0 : f32,
+     PreviousZ_0 : f32,
+     ContactMultiplier_0 : f32,
+};
+
+@compute
+@workgroup_size(128, 1, 1)
+fn main(@builtin(global_invocation_id) Dispatched_0 : vec3<u32>)
+{
+    var Particle_1 : u32 = Dispatched_0.x;
+    if(Particle_1 >= (Step_0.ParticleCount_0))
+    {
+        return;
+    }
+    var Tyre_1 : u32 = u32(0);
+    var Ring_1 : u32 = u32(0);
+    var Segment_1 : u32 = u32(0);
+    Slate_ResolveLatticePosition_0(Particle_1, &(Tyre_1), &(Ring_1), &(Segment_1));
+    var _S6 : Slate_TyreHubRecord_std430_0 = Hubs_0[Tyre_1];
+    var Current_0 : Slate_TyreParticleRecord_std430_0 = Particles_0[Particle_1];
+    var Motion_0 : Slate_TyreMotionRecord_std430_0 = Motions_0[Particle_1];
+    var RigidX_1 : f32 = 0.0f;
+    var RigidY_1 : f32 = 0.0f;
+    var RigidZ_1 : f32 = 0.0f;
+    Slate_RigidPointVelocity_0(&(_S6), Particles_0[Particle_1].X_0, Particles_0[Particle_1].Y_0, Particles_0[Particle_1].Z_0, &(RigidX_1), &(RigidY_1), &(RigidZ_1));
+    var Velocity_0 : Slate_TyreVelocityRecord_0;
+    Velocity_0.VelocityX_0 = Velocities_0[Particle_1].VelocityX_0;
+    Velocity_0.VelocityY_0 = Velocities_0[Particle_1].VelocityY_0;
+    Velocity_0.VelocityZ_0 = Velocities_0[Particle_1].VelocityZ_0;
+    Velocity_0.FrictionMultiplier_0 = Velocities_0[Particle_1].FrictionMultiplier_0;
+    if((Particles_0[Particle_1].InverseMass_0) <= 0.0f)
+    {
+        Velocity_0.VelocityX_0 = RigidX_1;
+        Velocity_0.VelocityY_0 = RigidY_1;
+        Velocity_0.VelocityZ_0 = RigidZ_1;
+    }
+    else
+    {
+        var _S7 : f32 = Velocity_0.VelocityX_0;
+        var _S8 : f32 = Velocity_0.VelocityY_0;
+        var _S9 : f32 = Velocity_0.VelocityZ_0;
+        Slate_RecoverVelocity_0(Current_0.X_0, Current_0.Y_0, Current_0.Z_0, Motion_0.PreviousX_0, Motion_0.PreviousY_0, Motion_0.PreviousZ_0, RigidX_1, RigidY_1, RigidZ_1, _S6.DeformationDamping_0, Step_0.SubstepSeconds_0, &(_S7), &(_S8), &(_S9));
+        Velocity_0.VelocityX_0 = _S7;
+        Velocity_0.VelocityY_0 = _S8;
+        Velocity_0.VelocityZ_0 = _S9;
+    }
+    Velocities_0[Particle_1].VelocityX_0 = Velocity_0.VelocityX_0;
+    Velocities_0[Particle_1].VelocityY_0 = Velocity_0.VelocityY_0;
+    Velocities_0[Particle_1].VelocityZ_0 = Velocity_0.VelocityZ_0;
+    Velocities_0[Particle_1].FrictionMultiplier_0 = Velocity_0.FrictionMultiplier_0;
+    var Started_0 : Slate_TyreMotionRecord_0;
+    Started_0.PreviousX_0 = Motion_0.PreviousX_0;
+    Started_0.PreviousY_0 = Motion_0.PreviousY_0;
+    Started_0.PreviousZ_0 = Motion_0.PreviousZ_0;
+    Started_0.ContactMultiplier_0 = Motion_0.ContactMultiplier_0;
+    Started_0.PreviousX_0 = Current_0.X_0;
+    Started_0.PreviousY_0 = Current_0.Y_0;
+    Started_0.PreviousZ_0 = Current_0.Z_0;
+    Motions_0[Particle_1].PreviousX_0 = Started_0.PreviousX_0;
+    Motions_0[Particle_1].PreviousY_0 = Started_0.PreviousY_0;
+    Motions_0[Particle_1].PreviousZ_0 = Started_0.PreviousZ_0;
+    Motions_0[Particle_1].ContactMultiplier_0 = Started_0.ContactMultiplier_0;
+    return;
+}
+
diff --git a/Experimental/FrontierEngine/Shader/VarianceTemporal.wgsl b/Experimental/FrontierEngine/Shader/VarianceTemporal.wgsl
new file mode 100644
index 0000000..bf42312
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/VarianceTemporal.wgsl
@@ -0,0 +1,95 @@
+//============================================================================================================================================
+//                                                          VARIANCETEMPORAL.WGSL
+//============================================================================================================================================
+// 🧩 Temporal integration of a resolved signal with luminance moments, reprojected through motion and validated per tap.
+
+// 📝 SVGF's temporal stage (Schied et al. 2017): the prior signal is gathered with four bilinear taps, each refused
+//    unless the prior guide agrees in normal and depth, then mixed with α = max(1/N, MinimumWeight). Luminance
+//    moments μ₁, μ₂ are integrated alongside; variance μ₂ − μ₁² is inflated while the tally is short.
+
+//! include "FrameDescriptor.wgsl"
+//! include "PackingCodec.wgsl"
+
+struct VarianceRecord
+{
+    Step           : u32,   // [px]  wavelet step (unused here)
+    MinimumWeight  : f32,   // [-]   floor of the temporal weight
+    ColourSigma    : f32,   // [-]   luminance edge-stopping scale (unused here)
+    TallyLimit     : f32,   // [-]   longest tally N
+}
+
+@group(0) @binding(1) var<uniform> Variance  : VarianceRecord;
+@group(0) @binding(2) var CurrentSignal      : texture_2d<f32>;
+@group(0) @binding(3) var SurfaceMotion      : texture_2d<f32>;
+@group(0) @binding(4) var CurrentGuide       : texture_2d<f32>;
+@group(0) @binding(5) var PreviousGuide      : texture_2d<f32>;
+@group(0) @binding(6) var PriorSignal        : texture_2d<f32>;
+@group(0) @binding(7) var PriorMoments       : texture_2d<f32>;
+@group(0) @binding(8) var IntegratedTarget   : texture_storage_2d<rgba16float, write>;
+@group(0) @binding(9) var MomentsTarget      : texture_storage_2d<rgba16float, write>;
+
+@compute @workgroup_size(8, 8)
+fn IntegrateTemporal(@builtin(global_invocation_id) Invocation: vec3u)
+{
+    let TracePixel = vec2i(Invocation.xy);
+    let Extent = vec2i(textureDimensions(CurrentSignal));
+    if (any(TracePixel >= Extent))
+    {
+        return;
+    }
+    let Guide = textureLoad(CurrentGuide, TracePixel, 0);
+    let Signal = textureLoad(CurrentSignal, TracePixel, 0).rgb;
+    let Luminance = ResolveLuminance(Signal);
+    if (Guide.w < 0.5)
+    {
+        textureStore(IntegratedTarget, TracePixel, vec4f(0.0));
+        textureStore(MomentsTarget, TracePixel, vec4f(0.0));
+        return;
+    }
+    let Normal = DecodeOctahedral(Guide.xy);
+    let ScreenPixel = min(TracePixel * i32(Frame.TraceScale), vec2i(Frame.ScreenExtent) - vec2i(1));
+    let Motion = textureLoad(SurfaceMotion, ScreenPixel, 0).xy;
+    let PriorPosition = (vec2f(ScreenPixel) + 0.5 - Motion) / f32(Frame.TraceScale) - 0.5;
+    let Corner = floor(PriorPosition);
+    let Fraction = PriorPosition - Corner;
+
+    var PriorColour  = vec3f(0.0);
+    var PriorMoment  = vec3f(0.0);
+    var TotalWeight  = 0.0;
+    for (var Tap = 0u; Tap < 4u; Tap++)
+    {
+        let Offset = vec2i(i32(Tap & 1u), i32(Tap >> 1u));
+        let Texel = vec2i(Corner) + Offset;
+        if (any(Texel < vec2i(0)) || any(Texel >= Extent))
+        {
+            continue;
+        }
+        let PriorGuide = textureLoad(PreviousGuide, Texel, 0);
+        if (PriorGuide.w < 0.5 || dot(DecodeOctahedral(PriorGuide.xy), Normal) < 0.85
+            || !ClassifyPriorDepth(PriorGuide.z, Guide.w - 1.0, Guide.z))
+        {
+            continue;
+        }
+        let Weight = select(1.0 - Fraction.x, Fraction.x, Offset.x == 1) * select(1.0 - Fraction.y, Fraction.y, Offset.y == 1);
+        PriorColour += textureLoad(PriorSignal, Texel, 0).rgb * Weight;
+        PriorMoment += textureLoad(PriorMoments, Texel, 0).xyz * Weight;
+        TotalWeight += Weight;
+    }
+
+    var Tally = 1.0;
+    var Colour = Signal;
+    var Moments = vec2f(Luminance, Luminance * Luminance);
+    if (TotalWeight > 0.01 && !FeatureEnabled(Frame, FeatureTemporalRestart))
+    {
+        PriorColour /= TotalWeight;
+        PriorMoment /= TotalWeight;
+        Tally = min(PriorMoment.z + 1.0, Variance.TallyLimit);
+        let Fraction = max(1.0 / Tally, Variance.MinimumWeight);
+        Colour  = mix(PriorColour, Signal, Fraction);
+        Moments = mix(PriorMoment.xy, Moments, max(Fraction, 0.2));
+    }
+    var Spread = max(Moments.y - Moments.x * Moments.x, 0.0);
+    Spread *= 4.0 / min(Tally, 4.0);
+    textureStore(IntegratedTarget, TracePixel, vec4f(Colour, Spread));
+    textureStore(MomentsTarget, TracePixel, vec4f(Moments, Tally, 0.0));
+}
diff --git a/Experimental/FrontierEngine/Shader/VarianceUpsample.wgsl b/Experimental/FrontierEngine/Shader/VarianceUpsample.wgsl
new file mode 100644
index 0000000..89c3c05
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/VarianceUpsample.wgsl
@@ -0,0 +1,64 @@
+//============================================================================================================================================
+//                                                          VARIANCEUPSAMPLE.WGSL
+//============================================================================================================================================
+// 🧩 Joint bilateral projection of a resampling-resolution signal onto every screen pixel, guided by depth and normal.
+
+//! include "FrameDescriptor.wgsl"
+//! include "PackingCodec.wgsl"
+
+@group(0) @binding(1) var SourceSignal      : texture_2d<f32>;
+@group(0) @binding(2) var SourceGuide       : texture_2d<f32>;
+@group(0) @binding(3) var SurfaceAttributes : texture_2d<f32>;
+@group(0) @binding(4) var SurfaceDepth      : texture_depth_2d;
+@group(0) @binding(5) var ScreenTarget      : texture_storage_2d<rgba16float, write>;
+
+@compute @workgroup_size(8, 8)
+fn ProjectScreenSignal(@builtin(global_invocation_id) Invocation: vec3u)
+{
+    let Pixel = vec2i(Invocation.xy);
+    if (any(vec2f(Pixel) >= Frame.ScreenExtent))
+    {
+        return;
+    }
+    let Depth = textureLoad(SurfaceDepth, Pixel, 0);
+    if (Depth <= 0.0)
+    {
+        textureStore(ScreenTarget, Pixel, vec4f(0.0));
+        return;
+    }
+    let ViewDepth = ResolveViewDepth(ReconstructWorldPosition(vec2f(Pixel) + 0.5, Depth));
+    let Normal = DecodeOctahedral(textureLoad(SurfaceAttributes, Pixel, 0).xy);
+    let Extent = vec2i(textureDimensions(SourceSignal));
+    let Position = vec2f(Pixel) / f32(Frame.TraceScale);
+    let Corner = vec2i(floor(Position));
+    let Fraction = Position - floor(Position);
+    var Sum = vec3f(0.0);
+    var WeightSum = 0.0;
+    var Nearest = vec3f(0.0);
+    var NearestScore = 1.0e30;
+    for (var Tap = 0u; Tap < 4u; Tap++)
+    {
+        let Offset = vec2i(i32(Tap & 1u), i32(Tap >> 1u));
+        let Texel = clamp(Corner + Offset, vec2i(0), Extent - vec2i(1));
+        let Guide = textureLoad(SourceGuide, Texel, 0);
+        if (Guide.w < 0.5)
+        {
+            continue;
+        }
+        let Signal = textureLoad(SourceSignal, Texel, 0).rgb;
+        let DepthDifference = abs(Guide.z - ViewDepth) / max(ViewDepth, 1.0e-3);
+        let Facing = max(dot(DecodeOctahedral(Guide.xy), Normal), 0.0);
+        let Bilinear = select(1.0 - Fraction.x, Fraction.x, Offset.x == 1) * select(1.0 - Fraction.y, Fraction.y, Offset.y == 1);
+        let Weight = (Bilinear + 1.0e-3) * exp(-DepthDifference * 40.0) * pow(Facing, 16.0);
+        Sum += Signal * Weight;
+        WeightSum += Weight;
+        let Score = DepthDifference + (1.0 - Facing);
+        if (Score < NearestScore)
+        {
+            NearestScore = Score;
+            Nearest = Signal;
+        }
+    }
+    let Projected = select(Nearest, Sum / WeightSum, WeightSum > 1.0e-4);
+    textureStore(ScreenTarget, Pixel, vec4f(Projected, 1.0));
+}
diff --git a/Experimental/FrontierEngine/Shader/VarianceWavelet.wgsl b/Experimental/FrontierEngine/Shader/VarianceWavelet.wgsl
new file mode 100644
index 0000000..5904fc0
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/VarianceWavelet.wgsl
@@ -0,0 +1,82 @@
+//============================================================================================================================================
+//                                                           VARIANCEWAVELET.WGSL
+//============================================================================================================================================
+// 🧩 One à-trous wavelet iteration: a 5×5 B3-spline kernel at step 2^i, stopped at depth, normal and luminance edges.
+
+// 📐 w(p, q) = h(q) · exp(−|z_p − z_q| / (σ_z·step·z_p)) · max(0, n_p·n_q)^σ_n · exp(−|l_p − l_q| / (σ_l·√Var_p + ε)),
+//    h the separable B3 spline (1, 4, 6, 4, 1)/16. Variance is propagated as Σw²·Var / (Σw)² (Dammertz et al. 2010,
+//    Schied et al. 2017). Signal alpha carries the variance between iterations.
+
+//! include "FrameDescriptor.wgsl"
+//! include "PackingCodec.wgsl"
+
+struct VarianceRecord
+{
+    Step         : u32,   // [px]
+    MinimumWeight : f32,   // [-]  (unused here)
+    ColourSigma  : f32,   // [-]
+    TallyLimit : f32,   // [-]  (unused here)
+}
+
+@group(0) @binding(1) var<uniform> Variance : VarianceRecord;
+@group(0) @binding(2) var SourceSignal      : texture_2d<f32>;
+@group(0) @binding(3) var CurrentGuide      : texture_2d<f32>;
+@group(0) @binding(4) var WaveletTarget     : texture_storage_2d<rgba16float, write>;
+
+const Spline : array<f32, 3> = array<f32, 3>(0.375, 0.25, 0.0625);
+
+@compute @workgroup_size(8, 8)
+fn ConvolveWavelet(@builtin(global_invocation_id) Invocation: vec3u)
+{
+    let Pixel = vec2i(Invocation.xy);
+    let Extent = vec2i(textureDimensions(SourceSignal));
+    if (any(Pixel >= Extent))
+    {
+        return;
+    }
+    let Guide = textureLoad(CurrentGuide, Pixel, 0);
+    let Centre = textureLoad(SourceSignal, Pixel, 0);
+    if (Guide.w < 0.5)
+    {
+        textureStore(WaveletTarget, Pixel, Centre);
+        return;
+    }
+    let Normal = DecodeOctahedral(Guide.xy);
+    let Luminance = ResolveLuminance(Centre.rgb);
+    let Deviation = sqrt(max(Centre.a, 0.0));
+    let Step = i32(Variance.Step);
+    var Sum = vec4f(0.0);
+    var WeightSum = 0.0;
+    var SpreadSum = 0.0;
+    for (var Y = -2; Y <= 2; Y++)
+    {
+        for (var X = -2; X <= 2; X++)
+        {
+            let Texel = Pixel + vec2i(X, Y) * Step;
+            if (any(Texel < vec2i(0)) || any(Texel >= Extent))
+            {
+                continue;
+            }
+            let TapGuide = textureLoad(CurrentGuide, Texel, 0);
+            if (TapGuide.w < 0.5)
+            {
+                continue;
+            }
+            let Tap = textureLoad(SourceSignal, Texel, 0);
+            let Kernel = Spline[abs(X)] * Spline[abs(Y)];
+            let DepthWeight = exp(-abs(TapGuide.z - Guide.z) / (0.015 * f32(Step) * Guide.z + 1.0e-3));
+            let NormalWeight = pow(max(dot(DecodeOctahedral(TapGuide.xy), Normal), 0.0), 64.0);
+            let LuminanceWeight = exp(-abs(ResolveLuminance(Tap.rgb) - Luminance) / (Variance.ColourSigma * Deviation + 1.0e-3));
+            let Weight = Kernel * DepthWeight * NormalWeight * LuminanceWeight;
+            Sum += vec4f(Tap.rgb * Weight, 0.0);
+            SpreadSum += Weight * Weight * Tap.a;
+            WeightSum += Weight;
+        }
+    }
+    if (WeightSum <= 1.0e-6)
+    {
+        textureStore(WaveletTarget, Pixel, Centre);
+        return;
+    }
+    textureStore(WaveletTarget, Pixel, vec4f(Sum.rgb / WeightSum, SpreadSum / (WeightSum * WeightSum)));
+}
diff --git a/Experimental/FrontierEngine/Shader/VehicleVisual.wgsl b/Experimental/FrontierEngine/Shader/VehicleVisual.wgsl
new file mode 100644
index 0000000..82094dc
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/VehicleVisual.wgsl
@@ -0,0 +1,143 @@
+// Volumetric authored tyres, pressure-driven deformation, damage visibility and cabin articulation; shared by all raster paths.
+struct VehicleRecord {
+    Cabin : vec4f, // steering angle, see-through glass, reserved, lamp
+    Column : vec4f,
+    Axis : vec4f,
+    CabinFrame : vec4f,
+    CabinShift : vec4f, // tablet centre xyz, tablet-only scale w
+    Wheels : array<vec4f, 4>, // x = shredded; yzw reserved
+    Deformation : array<vec4f, 4>, // x = ContactAngle, y = Deflection, z = GaugePressure, w = LateralDistortion
+}
+
+const TyreRimRadius: f32 = 0.3448;
+const TyreOuterRadius: f32 = 0.50855;
+const PI: f32 = 3.141592653589793;
+
+struct DeformedVertex { Position : vec3f, Normal : vec3f, }
+
+// 📐 Volumetric Tyre Physics (Chaos Flesh / PB-FEM Volumetric Incompressibility & Pressure Dilatation on GPU):
+// Evaluates radial contact patch flattening, volumetric sidewall bulges (conserving rubber/gas volume),
+// shoulder expansion waves, lateral slip shear and internal inflation pressure stiffening in real time.
+fn ResolveWheelVertex(Wheel: u32, Family: u32, Position: vec3f, Normal: vec3f) -> DeformedVertex {
+    var Result: DeformedVertex;
+    Result.Position = Position;
+    Result.Normal = Normal;
+
+    // All vertices of a shredded rubber facet collapse to the axle: no rubber or rubber shadow.
+    // Rim/hub/brake facets and all occupant steering/spin/suspension transforms stay intact.
+    if (Family == TyreFamily && VehicleState.Wheels[Wheel].x > 0.5) {
+        Result.Position = vec3f(0.0);
+        return Result;
+    }
+
+    if (Family != TyreFamily) {
+        return Result;
+    }
+
+    let Deform = VehicleState.Deformation[Wheel];
+    let Deflection = Deform.y;
+    if (Deflection <= 1.0e-5) {
+        return Result;
+    }
+
+    let ContactAngle = Deform.x;
+    let Pressure = max(0.0, Deform.z);
+    let LateralDistortion = Deform.w;
+
+    let R = length(Position.xz);
+    if (R <= TyreRimRadius + 1.0e-4) {
+        return Result;
+    }
+
+    let Phi = atan2(Position.z, Position.x);
+    var DPhi = Phi - ContactAngle;
+    DPhi = DPhi - 2.0 * PI * round(DPhi / (2.0 * PI));
+
+    // Internal pressure scaling:
+    // Reference pressure is 220 kPa. Under higher pressure the contact patch is shorter and stiffer;
+    // under lower pressure (deflation) the contact patch elongates and sidewalls bulge dramatically.
+    let PNorm = max(0.05, Pressure / 220000.0);
+    let PatchSpan = clamp(0.44 / sqrt(max(0.15, PNorm)), 0.20, 1.15);
+
+    // Normalized radial depth: 0 at bead/rim, 1 at outer tread crown.
+    let RadialFrac = clamp((R - TyreRimRadius) / (TyreOuterRadius - TyreRimRadius), 0.0, 1.0);
+
+    var DR: f32 = 0.0;
+    var DY: f32 = 0.0;
+    let AbsDPhi = abs(DPhi);
+
+    // ① Contact flattening constraint:
+    if (AbsDPhi < PatchSpan) {
+        let U = AbsDPhi / PatchSpan;
+        let Envelope = 0.5 * (1.0 + cos(U * PI));
+        DR = -Deflection * Envelope * RadialFrac;
+
+        // ② Volumetric conservation (Poisson / Chaos Flesh hyperelastic continuum):
+        // Compressing the rubber tyre radially in contact pushes the material outward along the sidewalls.
+        let SidewallFactor = sin(RadialFrac * PI);
+        let BulgeIntensity = 0.48 / (0.4 + 0.6 * sqrt(PNorm));
+        DY = sign(Position.y) * (Deflection * BulgeIntensity * Envelope * SidewallFactor);
+    }
+
+    // ③ Volumetric wave expansion (bead/shoulder transition zone just outside contact):
+    let WaveOuter = PatchSpan * 1.5;
+    if (AbsDPhi >= PatchSpan && AbsDPhi < WaveOuter) {
+        let V = (AbsDPhi - PatchSpan) / (WaveOuter - PatchSpan);
+        let Wave = sin(V * PI) * (0.12 * Deflection * RadialFrac);
+        DR = DR + Wave;
+    }
+
+    // ④ Lateral cornering slip / shear strain:
+    if (AbsDPhi < PatchSpan * 1.2) {
+        let UShear = AbsDPhi / (PatchSpan * 1.2);
+        let ShearEnv = 0.5 * (1.0 + cos(UShear * PI));
+        DY = DY + LateralDistortion * ShearEnv * RadialFrac;
+    }
+
+    let NewR = max(TyreRimRadius, R + DR);
+    Result.Position = vec3f(NewR * cos(Phi), Position.y + DY, NewR * sin(Phi));
+
+    // Tilt deformed normal to maintain accurate shading over the contact patch & bulging sidewalls:
+    if (AbsDPhi < PatchSpan) {
+        let Tilt = -sin((DPhi / PatchSpan) * PI) * (Deflection / (TyreOuterRadius * PatchSpan));
+        Result.Normal = normalize(Normal + vec3f(-sin(Phi), 0.0, cos(Phi)) * Tilt);
+    }
+
+    return Result;
+}
+
+// 📐 Rodrigues: Vector turned by Angle about the unit Axis.
+fn TurnAboutAxis(Vector: vec3f, Axis: vec3f, Angle: f32) -> vec3f
+{
+    let C = cos(Angle);
+    let S = sin(Angle);
+    return Vector * C + cross(Axis, Vector) * S + Axis * dot(Axis, Vector) * (1.0 - C);
+}
+
+// 📝 A steering-wheel facet (car-body frame) turned about the column by the wheel's angle.
+fn TurnSteeringWheel(Position: vec3f, Normal: vec3f) -> DeformedVertex
+{
+    var Turned: DeformedVertex;
+    let Axis = normalize(VehicleState.Axis.xyz);
+    let Pivot = VehicleState.Column.xyz;
+    Turned.Position = Pivot + TurnAboutAxis(Position - Pivot, Axis, VehicleState.Cabin.x);
+    Turned.Normal = TurnAboutAxis(Normal, Axis, VehicleState.Cabin.x);
+    return Turned;
+}
+
+fn PlaceTablet(Position: vec3f) -> vec3f {
+    return VehicleState.CabinShift.xyz + (Position - VehicleState.CabinShift.xyz) * VehicleState.CabinShift.w;
+}
+// Only the steering assembly articulates. HUD sizing never moves physical cabin geometry.
+fn DeformBodyVertex(Family: u32, Position: vec3f, Normal: vec3f) -> DeformedVertex
+{
+    var Moved: DeformedVertex;
+    Moved.Position = Position;
+    Moved.Normal = Normal;
+    if (Family == TabletHousingFamily || Family == DisplayGlassFamily) { Moved.Position = PlaceTablet(Position); }
+    if (Family == SteeringWheelFamily)
+    {
+        Moved = TurnSteeringWheel(Position, Normal);
+    }
+    return Moved;
+}
