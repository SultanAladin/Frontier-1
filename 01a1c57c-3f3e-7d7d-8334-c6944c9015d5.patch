+    [cx - hx - wx, y0, cz - hz - wz], [cx + hx - wx, y0, cz + hz - wz],
+    [cx + hx + wx, y0, cz + hz + wz], [cx - hx + wx, y0, cz - hz + wz],
+    [cx - hx - wx, y1, cz - hz - wz], [cx + hx - wx, y1, cz + hz - wz],
+    [cx + hx + wx, y1, cz + hz + wz], [cx - hx + wx, y1, cz - hz + wz],
+  ];
