+
+// Axis-aligned box between two corners, rotated so local X follows (tx,tz).
+function box(B, c0, c1, tx, tz) {
+  const [x0, y0, z0] = c0, [x1, y1, z1] = c1;
+  // corners: s/z already in world; box defined by min/max in (s, off, y) space
