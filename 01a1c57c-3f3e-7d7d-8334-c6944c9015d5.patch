+            const L = StudioLights[i];
+            const ToLight = SubtractVector(L.Position, Origin);
+            const Proj = ToLight[0] * Dir[0] + ToLight[1] * Dir[1] + ToLight[2] * Dir[2];
+            if (Proj > 0.1 && Proj < BestT)
