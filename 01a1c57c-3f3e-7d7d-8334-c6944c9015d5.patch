+  if (bridgeId === 'beam' || bridgeId === 'viaduct') {
+    const spanLen = bridgeId === 'viaduct' ? 30 : 25;
+    const nSpans = Math.max(1, Math.round(len / spanLen));
+    // girders: 4 longitudinal I-beams
