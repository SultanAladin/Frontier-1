+/*==========================================================================================================================================
+                                                          LOGSTREAMENCLOSURE.CSS
+==========================================================================================================================================
+ 🧩 Scoped Frontier Log Stream dock panel inside FrontierEngine — styled in the exact Project-Zero Outliner neutral dark palette
+    (#090909 / #121212 / #171717 / #262626 borders / #f0f0f0 & #8d8d8d neutral typography).
+==========================================================================================================================================*/
+
+#log-stream-enclosure
+{
+    flex: none;
+    height: 300px;
+    min-height: 200px;
+    max-height: 78%;
+    display: flex;
+    flex-direction: column;
+    background: #121212;
+    border-top: 1px solid #262626;
+    color: #f0f0f0;
+    font-family: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+    overflow: hidden;
+    z-index: 25;
+}
+
+/* When docked inside a Left/Centre/Right Project-Zero dock host, fill the full dock height */
+.dock #log-stream-enclosure
+{
+    flex: 1 1 auto;
+    height: 100%;
+    max-height: none;
+    border-top: 0;
+}
+
+#log-stream-enclosure.hidden
+{
+    display: none !important;
+}
+
+#log-stream-enclosure.expanded
+{
+    height: calc(100% - 86px);
+    max-height: none;
+}
+
+#viewport-column.log-stream-maximized #stage
+{
+    display: none;
+}
+
+#viewport-column.log-stream-maximized #log-stream-enclosure
+{
+    flex: 1;
+    height: auto;
+    max-height: none;
+}
+
+/* ── Header (matches Outliner heading & surface) ──────────────────────────────────────────────────────────── */
+
+#log-stream-enclosure .ls-head
+{
+    flex: none;
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    padding: 10px 14px;
+    background: #121212;
+    border-bottom: 1px solid #222222;
+}
+
+#log-stream-enclosure .ls-brand
+{
+    width: 24px;
+    height: 24px;
+    border-radius: 7px;
+    background: #191919;
+    border: 1px solid #2a2a2a;
+    color: #d4d4d4;
+    display: grid;
+    place-items: center;
+    flex: none;
+}
+
+#log-stream-enclosure .ls-brand svg
+{
+    width: 14px;
+    height: 14px;
+}
+
+#log-stream-enclosure .ls-title
+{
+    font-size: 13px;
+    font-weight: 500;
+    letter-spacing: -0.01em;
+    color: #f0f0f0;
+}
+
+#log-stream-enclosure .ls-live-pill
+{
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+    padding: 3px 9px;
+    border-radius: 999px;
+    background: #171717;
+    border: 1px solid #262626;
+    font-size: 10.5px;
+    color: #9a9a9a;
+}
+
+#log-stream-enclosure .ls-live-dot
+{
+    width: 6px;
+    height: 6px;
+    border-radius: 50%;
+    background: #4ade80;
+    box-shadow: 0 0 6px rgba(74, 222, 128, 0.55);
+}
+
+#log-stream-enclosure .ls-live-pill.paused .ls-live-dot
+{
+    background: #e5a93c;
+    box-shadow: none;
+}
+
+#log-stream-enclosure .ls-live-word
+{
+    color: #e4e4e4;
+    font-weight: 500;
+}
+
+#log-stream-enclosure .ls-live-pill.paused .ls-live-word
+{
+    color: #e5a93c;
+}
+
+#log-stream-enclosure .ls-clock
+{
+    font: 400 10.5px/1 var(--mono, ui-monospace, monospace);
+    color: #6e6e6e;
+    font-variant-numeric: tabular-nums;
+}
+
+#log-stream-enclosure .ls-spacer
+{
+    flex: 1;
+}
+
+#log-stream-enclosure .ls-actions
+{
+    display: flex;
+    align-items: center;
+    gap: 5px;
+}
+
+#log-stream-enclosure .ls-icon-btn
+{
+    width: 26px;
+    height: 26px;
+    border-radius: 7px;
+    background: #171717;
+    border: 1px solid #262626;
+    color: #9a9a9a;
+    display: grid;
+    place-items: center;
+    cursor: pointer;
+    transition: background 120ms ease, color 120ms ease, border-color 120ms ease;
+}
+
+#log-stream-enclosure .ls-icon-btn:hover
+{
+    background: #222222;
+    color: #f3f3f3;
+    border-color: #363636;
+}
+
+#log-stream-enclosure .ls-icon-btn.active
+{
+    background: #262626;
+    color: #ffffff;
+    border-color: #444444;
+}
+
+#log-stream-enclosure .ls-icon-btn svg
+{
+    width: 13px;
+    height: 13px;
+}
+
+/* ── Telemetry Summary & Sparkline (matches Outliner .stats cards) ────────────────────────────────────────── */
+
+#log-stream-enclosure .ls-summary
+{
+    flex: none;
+    display: flex;
+    align-items: stretch;
+    padding: 8px 14px;
+    background: #121212;
+    border-bottom: 1px solid #222222;
+    gap: 10px;
+}
+
+#log-stream-enclosure .ls-stat
+{
+    display: flex;
+    flex-direction: column;
+    justify-content: space-between;
+    padding: 7px 12px;
+    border-radius: 8px;
+    background: #171717;
+    border: 1px solid #242424;
+    min-width: 98px;
+}
+
+#log-stream-enclosure .ls-stat-label
+{
+    font-size: 9px;
+    letter-spacing: 0.1em;
+    text-transform: uppercase;
+    color: #7d7d7d;
+    display: inline-flex;
+    align-items: center;
+    gap: 5px;
+}
+
+#log-stream-enclosure .ls-stat-row
+{
+    display: flex;
+    align-items: baseline;
+    gap: 7px;
+    margin-top: 4px;
+}
+
+#log-stream-enclosure .ls-stat-num
+{
+    font-size: 19px;
+    font-weight: 300;
+    line-height: 1;
+    letter-spacing: -0.03em;
+    color: #f3f3f3;
+    font-variant-numeric: tabular-nums;
+}
+
+#log-stream-enclosure .ls-delta
+{
+    font-size: 9.5px;
+    padding: 2px 6px;
+    border-radius: 999px;
+    background: #222222;
+    border: 1px solid #303030;
+    color: #d4d4d4;
+    font-variant-numeric: tabular-nums;
+}
+
+#log-stream-enclosure .ls-delta.amber
+{
+    background: rgba(229, 169, 60, 0.14);
+    border-color: rgba(229, 169, 60, 0.28);
+    color: #e5a93c;
+}
+
+#log-stream-enclosure .ls-delta.coral
+{
+    background: rgba(239, 95, 95, 0.15);
+    border-color: rgba(239, 95, 95, 0.30);
+    color: #ef5f5f;
+}
+
+#log-stream-enclosure .ls-spark-box
+{
+    flex: 1;
+    min-width: 140px;
+    display: flex;
+    flex-direction: column;
+    justify-content: space-between;
+    padding: 7px 12px;
+    border-radius: 8px;
+    background: #171717;
+    border: 1px solid #242424;
+    gap: 3px;
+}
+
+#log-stream-enclosure .ls-spark-head
+{
+    display: flex;
+    justify-content: space-between;
+    font-size: 9px;
