+    Materials[CourseMaterial.StudioFloor]     = Dielectric(0.80, 0.81, 0.82, 0.13);
+    Materials[CourseMaterial.StudioSurround]  = Dielectric(0.030, 0.032, 0.036, 0.34);
+    Materials[CourseMaterial.StudioWall]      = Dielectric(0.88, 0.89, 0.90, 0.52);
+    const Softbox = Dielectric(0.92, 0.93, 0.95, 0.40);
+    Softbox.Emission = [26.0, 26.5, 27.5];
+    Materials[CourseMaterial.StudioSoftbox]   = Softbox;
+    const StudioFrame = Dielectric(0.014, 0.015, 0.017, 0.48);
+    StudioFrame.Metalness = 0.4;
+    Materials[CourseMaterial.StudioFrame]     = StudioFrame;
+    Materials[CourseMaterial.StudioTurntable] = Dielectric(0.76, 0.77, 0.78, 0.08);
+    // 📝 Display paints: the Garage palette as clearcoats, each guest car in its own colour.
+    const DisplayPaint = (Hex) => {
+        const Coat = Dielectric(...[0, 1, 2].map((Channel) => {
+            const Value = parseInt(Hex.slice(1 + Channel * 2, 3 + Channel * 2), 16) / 255.0;
+            return (Value <= 0.04045 ? Value / 12.92 : ((Value + 0.055) / 1.055) ** 2.4) * BodyCoatHeadroom;
+        }), 0.0775);
+        Coat.CoatWeight = 1.0; Coat.CoatRoughness = 0.03;
+        return Coat;
+    };
+    Materials[CourseMaterial.DisplayPaintA] = DisplayPaint("#a4d8be");
+    Materials[CourseMaterial.DisplayPaintB] = DisplayPaint("#d4bd88");
+    Materials[CourseMaterial.DisplayPaintC] = DisplayPaint("#9eb8df");
+    Materials[CourseMaterial.DisplayPaintD] = DisplayPaint("#e2ada4");
+    // 📝 Display wheel lights: dark metal hubs, each carrying its own emissive colour.
+    const DisplayLight = (Emission) => {
+        const Hub = Dielectric(0.04, 0.045, 0.05, 0.25);
+        Hub.Metalness = 1.0; Hub.Emission = Emission;
+        return Hub;
+    };
+    Materials[CourseMaterial.DisplayLightA] = DisplayLight([0.2, 3.2, 2.4]);
+    Materials[CourseMaterial.DisplayLightB] = DisplayLight([3.4, 2.0, 0.3]);
+    Materials[CourseMaterial.DisplayLightC] = DisplayLight([0.5, 1.4, 3.6]);
+    Materials[CourseMaterial.DisplayLightD] = DisplayLight([3.2, 0.7, 2.4]);
+    // 📝 Plates: a retroreflective white face, near-black ink, and the Rank badge metals.
+    const PlateFace = Dielectric(0.86, 0.87, 0.88, 0.32);
+    PlateFace.Emission = [0.10, 0.10, 0.105];
+    Materials[CourseMaterial.PlateFace]  = PlateFace;
+    Materials[CourseMaterial.PlateInk]   = Dielectric(0.012, 0.012, 0.014, 0.55);
+    const BadgeMetal = (Red, Green, Blue) => { const Metal = Dielectric(Red, Green, Blue, 0.24); Metal.Metalness = 1.0; return Metal; };
+    Materials[CourseMaterial.RankBronze]  = BadgeMetal(0.62, 0.32, 0.14);
+    Materials[CourseMaterial.RankSilver]  = BadgeMetal(0.72, 0.74, 0.78);
+    Materials[CourseMaterial.RankGold]    = BadgeMetal(1.00, 0.72, 0.24);
+    Materials[CourseMaterial.RankDiamond] = BadgeMetal(0.62, 0.86, 1.00);
+    // Abraded aggregate and metal transfer: lighter, smoother than rubber, not a chrome strip.
+    const RimScrape = Dielectric(0.16, 0.17, 0.18, 0.46);
+    RimScrape.Metalness = 0.25;
+    Materials[CourseMaterial.RimScrape] = RimScrape;
+    return Materials;
+}
+
+// 📝 64-byte records matching MaterialRecord in SceneRecords.wgsl: 13 scalars, padded to 16 floats.
+export function EncodeMaterialRecords(Materials)
+{
+    const Scalars = new Float32Array(Materials.length * 16);
+    Materials.forEach((Material, Index) =>
+    {
+        const Offset = Index * 16;
+        Scalars.set([...Material.Albedo, Material.Roughness, ...Material.Emission, Material.Metalness,
+                     Material.CoatWeight, Material.CoatRoughness, Material.SpecularLevel, Material.Transmission,
+                     Material.IndexOfRefraction ?? 0.0], Offset);
+    });
+    return Scalars;
+}
diff --git a/Experimental/FrontierEngine/Source/NearestDepthSpace.js b/Experimental/FrontierEngine/Source/NearestDepthSpace.js
new file mode 100644
index 0000000..cefaa60
--- /dev/null
+++ b/Experimental/FrontierEngine/Source/NearestDepthSpace.js
@@ -0,0 +1,95 @@
+//============================================================================================================================================
+//                                                          NEARESTDEPTHSPACE.JS
+//============================================================================================================================================
+// 🧩 The nearest-depth pyramid over the screen — recursively halved tiles, each holding its nearest depth — kept two deep.
+
+// 📝 Rebuilt from the depth attachment every frame into the slot of the frame's parity, so the other slot still holds the
+//    previous frame's pyramid: the screen traces walk the current one and confirm reprojections against the prior one.
+//    Group 3 of every tracing program is constructed here: the BVH and light grid, both pyramids, the surface attributes (normal and
+//    material family), the occupant identity and the previous frame's diffuse exitance.
+
+export class NearestDepthSpace
+{
+    constructor(Exchange, Shaders)
+    {
+        this.Exchange = Exchange;
+        this.Shaders  = Shaders;
+        this.Textures = [];
+    }
+
+    async ConstructPrograms()
+    {
+        const Compute = GPUShaderStage.COMPUTE;
+        this.TransferLayout  = this.Exchange.ConstructDescriptorLayout(["TextureDepth2D", "StorageTexture2D:r32float"], Compute,
+                                                                       "Nearest depth transfer");
+        this.ReductionLayout = this.Exchange.ConstructDescriptorLayout(["Texture2DUnfiltered", "StorageTexture2D:r32float"], Compute,
+                                                                       "Nearest depth reduction");
+        // 📝 Group 3 of the tracing programs: bindings 0 to 3 are RayTracingSpace's BVH nodes, triangles, materials and the light grid;
+        //    4 to 8 are what the screen walk reads (ScreenTraversal.wgsl): both pyramids, attributes, prior exitance and identity.
+        this.TraversalLayout = this.Exchange.ConstructDescriptorLayout(
+            ["StorageRead", "StorageRead", "StorageRead", "Uniform",
+             "Texture2DUnfiltered", "Texture2DUnfiltered", "Texture2D", "Texture2D", "Texture2D"], Compute, "Trace traversal");
+        this.TransferProgram  = await this.Shaders.ConstructComputeProgram("NearestDepthTransfer.wgsl", "TransferNearestDepth",
+                                                                           [this.TransferLayout]);
+        this.ReductionProgram = await this.Shaders.ConstructComputeProgram("NearestDepthReduction.wgsl", "ReduceNearestDepth",
+                                                                           [this.ReductionLayout]);
+    }
+
+    // 📝 Level extents follow max(1, ⌊extent / 2^L⌋) down to a single texel, the chain WebGPU itself defines.
+    ConstructTargets(ScreenExtent, Surface)
+    {
+        for (const Texture of this.Textures)
+            Texture.destroy();
+        const [Width, Height] = ScreenExtent;
+        this.Extent = ScreenExtent;
+        this.LevelCount = Math.floor(Math.log2(Math.max(Width, Height))) + 1;
+        this.LevelExtents = [];
+        for (let Level = 0; Level < this.LevelCount; ++Level)
+            this.LevelExtents.push([Math.max(1, Width >> Level), Math.max(1, Height >> Level)]);
+        const Usage = GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.TEXTURE_BINDING;
+        this.Textures = ["A", "B"].map((Slot) => this.Exchange.ConstructTexture({ label: `Nearest depth ${Slot}`, size: [Width, Height],
+                                                                                   format: "r32float", mipLevelCount: this.LevelCount,
+                                                                                   usage: Usage }));
+        this.Views = this.Textures.map((Texture) => Texture.createView());
+        const LevelView = (Texture, Level) => Texture.createView({ baseMipLevel: Level, mipLevelCount: 1 });
+        this.TransferGroups = this.Textures.map((Texture) => this.Exchange.ConstructDescriptorGroup(this.TransferLayout,
+            [Surface.Views.Depth, LevelView(Texture, 0)], "Nearest depth transfer"));
+        this.ReductionGroups = this.Textures.map((Texture) =>
+        {
+            const Groups = [];
+            for (let Level = 1; Level < this.LevelCount; ++Level)
+                Groups.push(this.Exchange.ConstructDescriptorGroup(this.ReductionLayout,
+                                                                   [LevelView(Texture, Level - 1), LevelView(Texture, Level)],
+                                                                   `Nearest depth level ${Level}`));
+            return Groups;
+        });
+    }
+
+    // 📝 Needs the recombination's exitance target, so it follows DisplayProjection.ConstructTargets. RayTracing: the RayTracingSpace whose
+    //    buffers lead the group (its ConstructResources runs first).
+    ConstructTraversalGroups(Surface, Display, RayTracing)
+    {
+        this.TraversalGroups = [0, 1].map((Parity) => this.Exchange.ConstructDescriptorGroup(this.TraversalLayout,
+            [...RayTracing.TraversalResources, this.Views[Parity], this.Views[1 - Parity], Surface.Views.Attributes, Display.Views.Exitance,
+             Surface.Views.Identity], `Trace traversal ${Parity}`));
+    }
+
+    // 📝 One compute pass: level 0 from the depth attachment, then each level from the one beneath. Every dispatch is its
+    //    own usage scope, so level L written as storage is visible to the dispatch that samples it for level L + 1.
+    RecordReduction(Encoder, Parity, TimestampWrites)
+    {
+        const [Width, Height] = this.Extent;
+        const Reduction = Encoder.beginComputePass({ label: "Nearest depth reduction", timestampWrites: TimestampWrites });
+        Reduction.setPipeline(this.TransferProgram);
+        Reduction.setBindGroup(0, this.TransferGroups[Parity]);
+        Reduction.dispatchWorkgroups(Math.ceil(Width / 8), Math.ceil(Height / 8));
+        Reduction.setPipeline(this.ReductionProgram);
+        for (let Level = 1; Level < this.LevelCount; ++Level)
+        {
+            const [LevelWidth, LevelHeight] = this.LevelExtents[Level];
+            Reduction.setBindGroup(0, this.ReductionGroups[Parity][Level - 1]);
+            Reduction.dispatchWorkgroups(Math.ceil(LevelWidth / 8), Math.ceil(LevelHeight / 8));
+        }
+        Reduction.end();
+    }
+}
diff --git a/Experimental/FrontierEngine/Source/OccupantDistanceSpace.js b/Experimental/FrontierEngine/Source/OccupantDistanceSpace.js
new file mode 100644
index 0000000..b76d6e0
--- /dev/null
+++ b/Experimental/FrontierEngine/Source/OccupantDistanceSpace.js
@@ -0,0 +1,253 @@
+//============================================================================================================================================
+//                                                         OCCUPANTDISTANCESPACE.JS
+//============================================================================================================================================
+// 🧩 Per-facet-set signed distance volumes, stacked in one 3D texel space and transferred on the device at bring-up.
+
+import { ConstructBoundingStructure } from "./BoundingStructure.js";
+import { OccupantRole } from "./FacetStructure.js";
+
+const MaximumVolumeTexels = 128;    // [texel] - longest volume axis
+const MinimumVolumeTexels = 8;      // [texel] - shortest volume axis
+const SignRayCount        = 32;     // [-]     - rays per voxel for the back-face sign heuristic
+const SlabVoxelBudget     = 65536;  // [voxel] - voxels per submission, so no single dispatch can trip a device watchdog
+
+// 📝 The fragment pool: cubes of Edge³ texels appended below the stacked volumes, each holding one live fragment's
+//    distance volume, computed on the device the frame the fragment is born (FragmentDistance.wgsl).
+export const FragmentPool = Object.freeze({
+    Edge:         12,    // [texel] per axis, two of them margin on each side
+    Slots:        256,   // [-]
+    MaxTriangles: 48,    // [-]     a fragment with more is left out of the field
+    MaxPlanes:    40,    // [-]
+    JobsPerFrame: 48     // [-]     volumes computed per frame at most; the rest wait a frame
+});
+const PoolStride = FragmentPool.MaxTriangles * 3 + FragmentPool.MaxPlanes;   // [vec4] geometry per job
+
+export class OccupantDistanceSpace
+{
+    constructor(Exchange, Shaders)
+    {
+        this.Exchange    = Exchange;
+        this.Shaders     = Shaders;
+        this.Volumes     = [];
+        this.Texture     = null;
+        this.TextureView = null;
+        this.SpaceExtent = [0, 0, 0];
+        this.Pool        = { Origins: [], Owners: [], Free: [], Queue: [], Order: [] };
+        this.PoolMetrics = { Live: 0, Computed: 0, Evicted: 0 };
+    }
+
+    // 📝 ① choose each volume's voxel and resolution from its facet set; ② stack them along z with one-texel gaps;
+    //    ③ transfer each volume slab by slab. VoxelScale coarsens every volume uniformly for weaker adapters.
+    async ConstructVolumes(Scene, VoxelScale, ReportProgress)
+    {
+        const Required = new Set();
+        for (const Occupant of Scene.Occupants)
+        {
+            if (Occupant.Roles & OccupantRole.Distance)
+                Required.add(Occupant.FacetSet);
+        }
+
+        let Width = 0, Height = 0, Depth = 0;
+        for (const SetIndex of Required)
+        {
+            const Set = Scene.FacetSets[SetIndex];
+            let Voxel = Set.DistanceVoxel * VoxelScale;
+            const Extent = [0, 1, 2].map((Axis) => Set.LocalMaximum[Axis] - Set.LocalMinimum[Axis]);
+            const Margin = () => Math.max(4.0 * Voxel, 0.12);
+            let Longest = Math.max(...Extent.map((Length) => Length + 2.0 * Margin()));
+            if (Longest / Voxel > MaximumVolumeTexels)
+                Voxel = Longest / MaximumVolumeTexels;
+            const Resolution = Extent.map((Length) =>
+                Math.max(MinimumVolumeTexels, Math.min(MaximumVolumeTexels, Math.ceil((Length + 2.0 * Margin()) / Voxel))));
+            const Centre = [0, 1, 2].map((Axis) => 0.5 * (Set.LocalMinimum[Axis] + Set.LocalMaximum[Axis]));
+            const Minimum = [0, 1, 2].map((Axis) => Centre[Axis] - 0.5 * Resolution[Axis] * Voxel);
+            const Volume = { FacetSet: SetIndex, VoxelExtent: Voxel, Resolution, Minimum, TexelOrigin: [0, 0, Depth] };
+            Set.VolumeIndex = this.Volumes.length;
+            this.Volumes.push(Volume);
+            Width  = Math.max(Width, Resolution[0]);
+            Height = Math.max(Height, Resolution[1]);
+            Depth += Resolution[2] + 1;
+        }
+        // 📝 The fragment pool, layer after layer of Edge-cubes below the last volume.
+        const Edge = FragmentPool.Edge;
+        Width = Math.max(Width, Edge);
+        Height = Math.max(Height, Edge);
+        const PerRow = Math.floor(Width / Edge), PerColumn = Math.floor(Height / Edge);
+        const Layers = Math.ceil(FragmentPool.Slots / (PerRow * PerColumn));
+        for (let Slot = 0; Slot < FragmentPool.Slots; ++Slot)
+        {
+            const Layer = Math.floor(Slot / (PerRow * PerColumn)), Within = Slot % (PerRow * PerColumn);
+            this.Pool.Origins.push([(Within % PerRow) * Edge, Math.floor(Within / PerRow) * Edge, Depth + Layer * (Edge + 1)]);
+            this.Pool.Owners.push(null);
+            this.Pool.Free.push(FragmentPool.Slots - 1 - Slot);
+        }
+        Depth += Layers * (Edge + 1);
+        const Limit = this.Exchange.Device.limits.maxTextureDimension3D;
+        if (Depth > Limit)
+            throw new Error(`Distance volumes need ${Depth} slices; the adapter allows ${Limit}`);
+        this.SpaceExtent = [Width, Height, Math.max(Depth, 1)];
+
+        this.Texture = this.Exchange.ConstructTexture({
+            label: "Occupant distance space",
+            size: this.SpaceExtent,
+            dimension: "3d",
+            format: "rgba16float",
+            usage: GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.TEXTURE_BINDING
+        });
+        this.TextureView = this.Texture.createView({ dimension: "3d" });
+
+        const Layout = this.Exchange.ConstructDescriptorLayout(["Uniform", "StorageRead", "StorageRead", "StorageTexture3D:rgba16float"],
+                                                                GPUShaderStage.COMPUTE, "Distance transfer");
+        const Program = await this.Shaders.ConstructComputeProgram("DistanceTransfer.wgsl", "TransferDistance", [Layout]);
+        const Device = this.Exchange.Device;
+
+        let VoxelTotal = 0, VoxelDone = 0;
+        for (const Volume of this.Volumes)
+            VoxelTotal += Volume.Resolution[0] * Volume.Resolution[1] * Volume.Resolution[2];
+
+        for (const Volume of this.Volumes)
+        {
+            const Set = Scene.FacetSets[Volume.FacetSet];
+            const Corners = new Float32Array(Set.Facets.length * 9);
+            Set.Facets.forEach((Facet, Index) =>
+            {
+                for (let Corner = 0; Corner < 3; ++Corner)
+                    Corners.set(Facet.Corners[Corner], Index * 9 + Corner * 3);
+            });
+            const Structure = ConstructBoundingStructure(Corners);
+            const NodeRecords  = this.Exchange.ConstructRecordsFrom(Structure.NodeScalars, GPUBufferUsage.STORAGE, `${Set.Name} nodes`);
+            const FacetRecords = this.Exchange.ConstructRecordsFrom(Structure.FacetCorners, GPUBufferUsage.STORAGE, `${Set.Name} facets`);
+            const SlicePlane = Volume.Resolution[0] * Volume.Resolution[1];
+            const SlabSlices = Math.max(1, Math.floor(SlabVoxelBudget / SlicePlane));
+            for (let Slab = 0; Slab < Volume.Resolution[2]; Slab += SlabSlices)
+            {
+                const SlabExtent = Math.min(SlabSlices, Volume.Resolution[2] - Slab);
+                const Bytes = new ArrayBuffer(64);
+                const Scalars = new Float32Array(Bytes);
+                const Integers = new Uint32Array(Bytes);
+                Scalars.set(Volume.Minimum, 0);
+                Scalars[3] = Volume.VoxelExtent;
+                Integers.set(Volume.TexelOrigin, 4);
+                Integers[7] = Structure.NodeCount;
+                Integers.set(Volume.Resolution, 8);
+                Integers[11] = Structure.FacetCount;
+                Integers[12] = Slab;
+                Integers[13] = SlabExtent;
+                Integers[14] = SignRayCount;
+                const Uniform = this.Exchange.ConstructRecordsFrom(new Uint8Array(Bytes), GPUBufferUsage.UNIFORM, "Transfer record");
+                const Group = this.Exchange.ConstructDescriptorGroup(Layout, [Uniform, NodeRecords, FacetRecords, this.TextureView]);
+                const Encoder = Device.createCommandEncoder({ label: "Distance transfer" });
+                const Pass = Encoder.beginComputePass({ label: `Transfer ${Set.Name}` });
+                Pass.setPipeline(Program);
+                Pass.setBindGroup(0, Group);
+                Pass.dispatchWorkgroups(Math.ceil(Volume.Resolution[0] / 4), Math.ceil(Volume.Resolution[1] / 4), Math.ceil(SlabExtent / 4));
+                Pass.end();
+                Device.queue.submit([Encoder.finish()]);
+                await Device.queue.onSubmittedWorkDone();
+                Uniform.destroy();
+                VoxelDone += SlicePlane * SlabExtent;
+                if (ReportProgress)
+                    ReportProgress(`Transferring distance volume: ${Set.Name}`, VoxelDone / VoxelTotal);
+            }
+            NodeRecords.destroy();
+            FacetRecords.destroy();
+        }
+    }
+
+    QueryVolume(Scene, FacetSet)
+    {
+        const Index = Scene.FacetSets[FacetSet].VolumeIndex;
+        return Index >= 0 ? this.Volumes[Index] : null;
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                               FRAGMENT POOL
+    //--------------------------------------------------------------------------------------------------------------------
+
+    async ConstructFragmentProgram()
+    {
+        this.FragmentLayout = this.Exchange.ConstructDescriptorLayout(["StorageRead", "StorageRead", "StorageTexture3D:rgba16float"],
+                                                                      GPUShaderStage.COMPUTE, "Fragment distance");
+        this.FragmentProgram = await this.Shaders.ConstructComputeProgram("FragmentDistance.wgsl", "ComputeFragmentDistance", [this.FragmentLayout]);
+        this.JobRecords = this.Exchange.ConstructRecords(FragmentPool.JobsPerFrame * 32, GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST, "Fragment jobs");
+        this.GeometryRecords = this.Exchange.ConstructRecords(FragmentPool.JobsPerFrame * PoolStride * 16, GPUBufferUsage.STORAGE | GPUBufferUsage.COPY_DST,
+                                                              "Fragment geometry");
+        this.FragmentGroup = this.Exchange.ConstructDescriptorGroup(this.FragmentLayout, [this.JobRecords, this.GeometryRecords, this.TextureView]);
+    }
+
+    // 📝 Gives a fragment a pool volume: { Minimum, VoxelExtent, TexelOrigin, Resolution, Slot } in its own (centroid)
+    //    frame, or null when it does not fit the job layout. When the pool is full the oldest live volume is evicted
+    //    and Evict(Owner) is called for it, so its occupant can leave the field.
+    AssignFragment(Owner, Fragment, Evict)
+    {
+        if (!this.FragmentProgram || Fragment.Triangles.length > FragmentPool.MaxTriangles || Fragment.Planes.length > FragmentPool.MaxPlanes)
+            return null;
+        if (this.Pool.Free.length === 0)
+        {
+            const Oldest = this.Pool.Order.shift();
+            if (Oldest === undefined)
+                return null;
+            const Previous = this.Pool.Owners[Oldest];
+            this.Pool.Owners[Oldest] = null;
+            this.Pool.Queue = this.Pool.Queue.filter((Job) => Job.Slot !== Oldest);
+            this.Pool.Free.push(Oldest);
+            this.PoolMetrics.Evicted++;
+            if (Previous && Evict)
+                Evict(Previous);
+        }
+        const Slot = this.Pool.Free.pop();
+        const Edge = FragmentPool.Edge;
+        const Extent = [0, 1, 2].map((Axis) => Fragment.Maximum[Axis] - Fragment.Minimum[Axis]);
+        const Voxel = Math.max(...Extent, 0.02) / (Edge - 4);
+        const Centre = [0, 1, 2].map((Axis) => 0.5 * (Fragment.Minimum[Axis] + Fragment.Maximum[Axis]));
+        const Volume = { Minimum: Centre.map((Component) => Component - 0.5 * Edge * Voxel), VoxelExtent: Voxel,
+                         TexelOrigin: this.Pool.Origins[Slot], Resolution: [Edge, Edge, Edge], Slot };
+        this.Pool.Owners[Slot] = Owner;
+        this.Pool.Order.push(Slot);
+        this.Pool.Queue.push({ Slot, Volume, Fragment });
+        return Volume;
+    }
+
+    ReleaseFragment(Volume)
+    {
+        if (!Volume || this.Pool.Owners[Volume.Slot] === null)
+            return;
+        this.Pool.Owners[Volume.Slot] = null;
+        this.Pool.Order = this.Pool.Order.filter((Slot) => Slot !== Volume.Slot);
+        this.Pool.Queue = this.Pool.Queue.filter((Job) => Job.Slot !== Volume.Slot);
+        this.Pool.Free.push(Volume.Slot);
+    }
+
+    // 📝 Computes the queued volumes (up to JobsPerFrame) before the union reads them; returns how many it computed.
+    RecordFragments(Encoder)
+    {
+        this.PoolMetrics.Live = FragmentPool.Slots - this.Pool.Free.length;
+        if (!this.FragmentProgram || this.Pool.Queue.length === 0)
+            return 0;
+        const Jobs = this.Pool.Queue.splice(0, FragmentPool.JobsPerFrame);
+        const JobBytes = new ArrayBuffer(Jobs.length * 32);
+        const JobScalars = new Float32Array(JobBytes), JobIntegers = new Uint32Array(JobBytes);
+        const Geometry = new Float32Array(Jobs.length * PoolStride * 4);
+        Jobs.forEach((Job, Index) =>
+        {
+            JobIntegers.set(Job.Volume.TexelOrigin, Index * 8);
+            JobIntegers[Index * 8 + 3] = Job.Fragment.Triangles.length | (Job.Fragment.Planes.length << 16);
+            JobScalars.set(Job.Volume.Minimum, Index * 8 + 4);
+            JobScalars[Index * 8 + 7] = Job.Volume.VoxelExtent;
+            const Base = Index * PoolStride * 4;
+            Job.Fragment.Triangles.forEach((Triangle, TriangleIndex) =>
+                Triangle.Corners.forEach((Corner, CornerIndex) => Geometry.set(Corner, Base + (TriangleIndex * 3 + CornerIndex) * 4)));
+            Job.Fragment.Planes.forEach((Plane, PlaneIndex) => Geometry.set(Plane, Base + (FragmentPool.MaxTriangles * 3 + PlaneIndex) * 4));
+        });
+        const Device = this.Exchange.Device;
+        Device.queue.writeBuffer(this.JobRecords, 0, JobBytes);
+        Device.queue.writeBuffer(this.GeometryRecords, 0, Geometry);
+        const Pass = Encoder.beginComputePass({ label: "Fragment distance volumes" });
+        Pass.setPipeline(this.FragmentProgram);
+        Pass.setBindGroup(0, this.FragmentGroup);
+        Pass.dispatchWorkgroups(Jobs.length);
+        Pass.end();
+        this.PoolMetrics.Computed += Jobs.length;
+        return Jobs.length;
+    }
+}
diff --git a/Experimental/FrontierEngine/Source/OverlayDock.js b/Experimental/FrontierEngine/Source/OverlayDock.js
new file mode 100644
index 0000000..e1be574
--- /dev/null
+++ b/Experimental/FrontierEngine/Source/OverlayDock.js
@@ -0,0 +1,183 @@
+//============================================================================================================================================
+//                                                              OVERLAYDOCK.JS
+//============================================================================================================================================
+// 🧩 The debug overlays — readout, distance-slice inset, control panel — closable, recallable from a dock, and remembered.
+
+// 📝 Three overlays: the heads-up readout (top left of the viewport), the distance-slice inset the present pass draws
+//    (top right, with its HTML legend and close button framed over it), and the editor's two columns. Each has
+//    a close button and a key; whatever is closed reappears as a button in the dock at the bottom right. V hides all
+//    of them (and the dock) for a clean view and brings back exactly what was open. Choices persist across reloads.
+
+const StorageKey = "IlluminationExhibit.Overlays";
+
+export const OverlayKeys = Object.freeze({ Hud: "KeyH", Inset: "KeyJ", Panel: "KeyP", Clean: "KeyV" });
+
+const OverlayCaptions = Object.freeze({ Hud: "Readout (H)", Inset: "Distance slice (J)", Panel: "Editor (P)" });
+
+export class OverlayDock
+{
+    // 📝 Settings carries HudVisible, InsetEnabled (read by the present pass) and PanelVisible; OnChange(Name) lets
+    //    the host resynchronise the panel and rebuild screen targets when the panel's width enters or leaves the stage.
+    constructor(Settings, OnChange)
+    {
+        this.Settings = Settings;
+        this.OnChange = OnChange;
+        this.Clean    = false;
+        this.Retained = null;
+        this.Elements = {
+            Hud:    document.getElementById("hud"),
+            Inset:  document.getElementById("inset-frame"),
+            Dock:   document.getElementById("overlay-dock"),
+            Notice: document.getElementById("overlay-notice")
+        };
+        this.RestoreChoices();
+        this.ConstructDock();
+        for (const Button of document.querySelectorAll("[data-overlay]"))
+            Button.addEventListener("click", (Event) => { Event.stopPropagation(); this.Toggle(Button.dataset.overlay); });
+        this.Apply();
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                                   STATE
+    //--------------------------------------------------------------------------------------------------------------------
+
+    RestoreChoices()
+    {
+        try
+        {
+            const Stored = JSON.parse(localStorage.getItem(StorageKey) || "null");
+            if (Stored && typeof Stored === "object")
+            {
+                for (const [Name, Key] of [["Hud", "HudVisible"], ["Inset", "InsetEnabled"], ["Panel", "PanelVisible"]])
+                    if (typeof Stored[Name] === "boolean")
+                        this.Settings[Key] = Stored[Name];
+            }
+        }
+        catch (Failure)
+        {
+            // 📝 Storage may be unavailable (private mode, file://); the defaults simply stand.
+        }
+    }
+
+    PersistChoices()
+    {
+        try
+        {
+            localStorage.setItem(StorageKey, JSON.stringify({ Hud: !!this.Settings.HudVisible, Inset: !!this.Settings.InsetEnabled,
+                                                              Panel: !!this.Settings.PanelVisible }));
+        }
+        catch (Failure)
+        {
+        }
+    }
+
+    QueryVisible(Name)
+    {
+        if (this.Clean)
+            return false;
+        return !!this.Settings[{ Hud: "HudVisible", Inset: "InsetEnabled", Panel: "PanelVisible" }[Name]];
+    }
+
+    Toggle(Name)
+    {
+        if (Name === "Clean")
+        {
+            this.ToggleClean();
+            return;
+        }
+        const Key = { Hud: "HudVisible", Inset: "InsetEnabled", Panel: "PanelVisible" }[Name];
+        if (!Key)
+            return;
+        if (this.Clean)
+        {
+            // 📝 Asking for one overlay out of the clean view brings the view back first, then shows that overlay.
+            this.Clean = false;
+            this.Settings[Key] = true;
+        }
+        else
+        {
+            this.Settings[Key] = !this.Settings[Key];
+        }
+        this.Apply();
+        this.OnChange(Name);
+    }
+
+    ToggleClean()
+    {
+        this.Clean = !this.Clean;
+        this.Apply();
+        this.OnChange("Clean");
+        if (this.Clean)
+            this.Announce("Clean view — press V to bring the overlays back");
+    }
+
+    // 📝 Called when the panel's own toggles change a visibility key, so the dock and frames follow.
+    Synchronise()
+    {
+        this.Apply();
+    }
+
+    //--------------------------------------------------------------------------------------------------------------------
+    //                                                PRESENTATION
+    //--------------------------------------------------------------------------------------------------------------------
+
+    // 📝 The editor's viewport bar carries the readout and inset toggles; the dock only has to bring the editor back.
+    ConstructDock()
+    {
+        this.DockButtons = {};
+        for (const Name of ["Panel"])
+        {
+            const Button = document.createElement("button");
+            Button.textContent = `⊞ ${OverlayCaptions[Name]}`;
+            Button.title = `Show the ${OverlayCaptions[Name].toLowerCase()}`;
+            Button.addEventListener("click", () => this.Toggle(Name));
+            this.Elements.Dock.appendChild(Button);
+            this.DockButtons[Name] = Button;
+        }
+    }
+
+    Apply()
+    {
+        const Hud = this.QueryVisible("Hud"), Inset = this.QueryVisible("Inset"), Panel = this.QueryVisible("Panel");
+        this.Elements.Hud.classList.toggle("hidden", !Hud);
+        this.Elements.Inset.classList.toggle("hidden", !Inset);
+        // 📝 The editor's outliner and inspector columns fold away together; the viewport takes their room.
+        document.body.classList.toggle("panels-hidden", !Panel);
+        // 📝 The present pass draws the inset; in the clean view it must stop drawing it without forgetting the choice.
+        this.InsetDrawn = Inset;
+        let Closed = 0;
+        for (const [Name, Visible] of [["Panel", Panel]])
+        {
+            this.DockButtons[Name].classList.toggle("hidden", Visible);
+            Closed += Visible ? 0 : 1;
+        }
+        this.Elements.Dock.classList.toggle("hidden", this.Clean || Closed === 0);
+        this.PersistChoices();
+    }
+
+    Announce(Text)
+    {
+        const Notice = this.Elements.Notice;
+        if (!Notice)
+            return;
+        Notice.textContent = Text;
+        Notice.classList.remove("hidden");
+        clearTimeout(this.NoticeTimer);
+        this.NoticeTimer = setTimeout(() => Notice.classList.add("hidden"), 2600);
+    }
+
+    // 📝 Frames the HTML close button and legend over the inset DisplayPresent.wgsl draws: a square of ⌊0.34·H⌋ device
+    //    pixels, 16 device pixels from the top-right corner of the render target, converted here to CSS pixels.
+    PlaceInset(Canvas, ScreenExtent)
+    {
+        if (!ScreenExtent || !Canvas.clientWidth)
+            return;
+        const Ratio = ScreenExtent[0] / Canvas.clientWidth;
+        const Size = Math.floor(ScreenExtent[1] * 0.34);
+        const Style = this.Elements.Inset.style;
+        Style.left   = `${(ScreenExtent[0] - Size - 16) / Ratio}px`;
+        Style.top    = `${16 / Ratio}px`;
+        Style.width  = `${Size / Ratio}px`;
+        Style.height = `${Size / Ratio}px`;
+    }
+}
diff --git a/Experimental/FrontierEngine/Source/Photometry.js b/Experimental/FrontierEngine/Source/Photometry.js
