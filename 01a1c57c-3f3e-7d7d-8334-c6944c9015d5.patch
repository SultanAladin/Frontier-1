+    IsCameraInsideCabin(WorldPos)
+    {
+        if (!WorldPos || !this.Vehicle || this.Vehicle.Hidden)
+            return false;
+        const InvBody = InvertTransform(this.Vehicle.QueryBodyTransform());
+        const Local = TransformPoint(InvBody, WorldPos);
+        // Cabin greenhouse envelope in body-local space (+X forward, +Y left, +Z up)
+        return Math.abs(Local[0]) < 1.35 && Math.abs(Local[1]) < 0.88 && Local[2] > -0.15 && Local[2] < 0.88;
+    }
+
+    BuildEulerScaleTransform(Position, EulerDeg, Scale = [1, 1, 1])
+    {
+        const Deg = Math.PI / 180.0;
+        const Quat = ComposeEulerRad((EulerDeg[0] || 0) * Deg, (EulerDeg[1] || 0) * Deg, (EulerDeg[2] || 0) * Deg);
+        return ConstructRigidTransform(Position, Quat, Scale);
+    }
+
+    BuildLookTransform(Eye, Target, Scale = [1, 1, 1])
+    {
+        let Fwd = NormalizeVector(SubtractVector(Target, Eye));
+        if (!Number.isFinite(Fwd[0]) || LengthVector(Fwd) < 1e-5) Fwd = [1, 0, 0];
+        const WorldUp = Math.abs(Fwd[2]) > 0.985 ? [0, 1, 0] : [0, 0, 1];
+        const Left = NormalizeVector(CrossVector(WorldUp, Fwd));
+        const Up   = NormalizeVector(CrossVector(Fwd, Left));
+        const Sx = Scale[0] ?? 1, Sy = Scale[1] ?? 1, Sz = Scale[2] ?? 1;
+        return new Float32Array([
+            Fwd[0] * Sx,  Fwd[1] * Sx,  Fwd[2] * Sx,  0,
+            Left[0] * Sy, Left[1] * Sy, Left[2] * Sy, 0,
+            Up[0] * Sz,   Up[1] * Sz,   Up[2] * Sz,   0,
+            Eye[0],       Eye[1],       Eye[2],       1
+        ]);
+    }
+
+    ResolveVehicleCameraWorldTransform()
+    {
+        const Body = this.Vehicle ? this.Vehicle.QueryBodyTransform() : ConstructRigidTransform([0, 0, 0], [0, 0, 0, 1]);
+        const Local = this.BuildEulerScaleTransform(
+            this.VehicleCamera.LocalOffset,
+            this.VehicleCamera.LocalEulerDeg,
+            this.VehicleCamera.Scale
+        );
+        return MultiplyTransform(Body, Local);
+    }
