+/* ============================================================================================================================================
+                                                            PROJECTZEROSHELL.CSS
+   ============================================================================================================================================
+   Exact ProjectZeroEditor (port 8081) shell, docking, outliner, viewport toolbar (Edit/Sim/Play), Top Notch Control Center,
+   and Bottom Asset Browser styling for FrontierEngine.
+*/
+
+#shell.pz-shell {
+    display: block;
+    width: 100vw;
+    height: 100vh;
+    overflow: hidden;
+    background: #090909;
+    color: #f0f0f0;
+    font-family: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+    font-size: 13px;
+    font-weight: 300;
+}
+
+#shell.pz-shell .workspace {
+    display: grid;
+    grid-template-columns:
+        minmax(180px, min(var(--left, 316px), 27vw))
+        minmax(240px, 1fr)
+        minmax(195px, min(var(--right, 356px), 31vw));
+    grid-template-rows: minmax(0, 1fr);
+    gap: 2px;
+    width: 100%;
+    height: 100%;
+    background: #262626;
+}
+
+#shell.pz-shell .workspace.inspector-workspace {
+    grid-template-columns: var(--left, 316px) 1fr;
+}
+
+#shell.pz-shell .workspace.inspector-workspace .dock.centre {
+    display: none;
+}
+
+#shell.pz-shell.panels-hidden .workspace,
+body.panels-hidden #shell.pz-shell .workspace {
+    grid-template-columns: 1fr;
+}
+#shell.pz-shell.panels-hidden .dock.left,
+#shell.pz-shell.panels-hidden .dock.right,
+body.panels-hidden #shell.pz-shell .dock.left,
+body.panels-hidden #shell.pz-shell .dock.right {
+    display: none;
+}
+
+.dock {
+    background: #121212;
+    display: flex;
+    flex-direction: column;
+    min-width: 0;
+    min-height: 0;
+    position: relative;
+    overflow: hidden;
+}
+
+.dock.left { border-radius: 0 0 0 8px; }
+.dock.right { border-radius: 0 0 8px 0; }
+
+.tab-strip {
+    height: 30px;
+    flex: none;
+    display: flex;
+    align-items: flex-end;
+    padding: 4px 4px 0 0;
+    background: #0a0a0a;
+    overflow: hidden;
+    gap: 0;
+}
+
+.document-tab {
+    height: 26px;
+    min-width: 110px;
+    padding: 0 14px 0 26px;
+    background: #26262c;
+    clip-path: polygon(14px 0, calc(100% - 14px) 0, 100% 100%, 0 100%);
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    position: relative;
+    cursor: default;
+    font-size: 11px;
+    color: #999;
+    margin-left: -12px;
+    user-select: none;
+}
+
+.document-tab:first-child { margin-left: 0; }
+.document-tab.active {
+    background: #121212;
+    color: #f0f0f0;
+    z-index: 1;
+}
+.document-tab:hover { background: #32323a; }
+.document-tab.active:hover { background: #171717; }
+
+.document-tab button {
+    border: 0;
+    min-height: 18px;
+    height: 18px;
+    width: 18px;
+    padding: 0;
+    border-radius: 50%;
+    background: transparent;
+    color: #888;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    cursor: pointer;
+}
+.document-tab button:hover { background: #444; color: #fff; }
+
+.tab-add {
+    height: 24px;
+    width: 24px;
+    min-height: 24px;
+    border-radius: 50%;
+    border: 1px solid #ffffff0d;
+    padding: 0;
+    margin: 0 0 3px 28px;
+    background: #26262c;
+    color: #bebec4;
+    z-index: 2;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    cursor: pointer;
+}
+.tab-add:hover { background: #35353d; color: #fff; }
+
+.dock-panel-host {
+    flex: 1;
+    min-height: 0;
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+    overflow: hidden;
+}
+
+.divider {
+    position: absolute;
+    top: 30px;
+    bottom: 0;
+    width: 7px;
+    cursor: col-resize;
+    z-index: 6;
+}
+.divider.left { right: -4px; }
+.divider.right { left: -4px; }
+.divider:hover { background: #ffffff20; }
+body.resizing, body.resizing * {
+    cursor: col-resize !important;
+    user-select: none !important;
+}
+
+.return-viewport {
+    position: fixed;
+    right: 14px;
+    top: 3px;
+    height: 24px;
+    min-height: 24px;
+    padding: 0 12px;
+    border-radius: 16px;
+    border: 1px solid #ffffff14;
+    font-size: 10px;
+    z-index: 35;
+    background: #252525;
+    color: #eee;
+    cursor: pointer;
+}
+
+.empty-dock {
+    padding: 40px 20px;
+    color: #666;
+    font-size: 12px;
+}
+
+/* Outliner (ProjectZeroEditor 1:1) */
+#outliner.pz-outliner {
+    width: 100% !important;
+    height: 100% !important;
+    border: 0 !important;
+    background: #121212 !important;
+    display: flex;
+    flex-direction: column;
+    min-height: 0;
+}
+
+.pz-outliner .outliner-heading {
+    height: 63px;
+    padding: 14px 18px 12px 22px;
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    flex: none;
+}
+.pz-outliner .outliner-heading h1 {
+    font-size: 20px;
+    font-weight: 300;
+    letter-spacing: 1px;
+    margin: 0;
+    color: #f0f0f0;
+}
+.pz-outliner .outliner-heading small {
+    font-size: 10px;
+    white-space: nowrap;
+    color: #686868;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+.pz-outliner .outliner-heading button {
+    width: 29px;
+    height: 29px;
+    min-height: 29px;
+    border-radius: 50%;
+    border: 1px solid transparent;
+    background: transparent;
+    padding: 0;
+    margin-left: auto;
+    color: #777;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    cursor: pointer;
+}
+.pz-outliner .outliner-heading button:hover { background: #222; color: #ddd; }
+
+.pz-outliner .stats {
+    display: flex;
+    gap: 8px;
+    padding: 0 14px;
+    flex: none;
+}
+.pz-outliner .stats button {
+    height: 64px;
+    flex: 1;
+    justify-content: flex-start;
+    position: relative;
+    border-radius: 20px;
+    background: #191919;
+    border: 1px solid #2c2c2c;
+    align-items: flex-start;
+    padding: 11px 12px;
+    color: #f0f0f0;
+    cursor: pointer;
+}
+.pz-outliner .stats button:hover { background: #212121; }
+.pz-outliner .stats small {
+    position: absolute;
+    bottom: 10px;
+    left: 12px;
+    font-size: 10px;
+    letter-spacing: 0.5px;
+    color: #a1a1a1;
+}
+.pz-outliner .stats strong {
+    font-size: 28px;
+    font-weight: 300;
+    position: absolute;
+    bottom: 7px;
+    right: 14px;
+}
+.status-disc, .muted-disc {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    width: 22px;
+    height: 22px;
+    border-radius: 50%;
+    background: #34c759;
+    color: #103719;
+    font-size: 11px;
+}
+.muted-disc {
+    background: #242424;
+    color: #5c5c5c;
+}
+
+.pz-outliner .outliner-search {
+    display: flex;
+    padding: 10px 14px 6px;
+    gap: 8px;
+    flex: none;
+}
+.pz-outliner .outliner-search label {
+    height: 40px;
+    display: flex;
+    align-items: center;
+    gap: 8px;
+    padding: 0 12px;
+    background: #191919;
+    border: 1px solid #2c2c2c;
+    border-radius: 22px;
+    flex: 1;
+    min-width: 0;
+    color: #696969;
+}
+.pz-outliner .outliner-search input {
+    width: 100%;
+    border: 0;
+    background: transparent;
+    color: #f0f0f0;
+    font-size: 11px;
+    outline: none;
+}
+.pz-outliner .outliner-search > button {
+    height: 40px;
+    border-radius: 20px;
+    border: 1px solid #2c2c2c;
+    background: #191919;
+    font-size: 10px;
+    color: #939393;
+    padding: 0 12px;
+    display: inline-flex;
+    align-items: center;
+    gap: 5px;
+    cursor: pointer;
+}
+.pz-outliner .outliner-search > button:hover { background: #232323; color: #ddd; }
+
+.pz-outliner .filter-chips {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 5px;
+    padding: 2px 14px 8px;
+}
+.pz-outliner .filter-chips button {
+    min-height: 22px;
+    border-radius: 12px;
+    border: 1px solid #ffffff12;
+    background: #222;
+    color: #ddd;
+    font-size: 10px;
+    padding: 2px 8px;
+    cursor: pointer;
+}
+
+.pz-outliner .outliner-rows {
+    flex: 1;
+    overflow: auto;
+    padding: 4px 10px 10px;
+}
+.pz-outliner .outliner-row {
+    height: 39px;
+    display: flex;
+    align-items: center;
+    gap: 7px;
+    padding: 0 8px 0 calc(4px + var(--depth, 0) * 14px);
+    border: 1px solid transparent;
+    border-radius: 8px;
+    position: relative;
+    outline: none;
+    user-select: none;
+    cursor: pointer;
+    font-size: 12px;
+    white-space: nowrap;
+    color: #bababa;
+}
+.pz-outliner .outliner-row.selected {
+    background: #262626;
+    border-color: #444;
+    color: #f0f0f0;
+}
+.pz-outliner .outliner-row.selected::before {
+    content: "";
+    position: absolute;
+    left: -1px;
+    top: -1px;
+    bottom: -1px;
+    width: 3px;
+    background: #ffb454;
+}
+.pz-outliner .outliner-row:hover:not(.selected) { background: #1c1c1c; }
+.pz-outliner .outliner-row.hidden-row { opacity: 0.42; }
+
+.pz-outliner .row-disclosure {
+    width: 14px;
+    min-height: 18px;
+    height: 18px;
+    padding: 0;
+    border: 0;
+    background: transparent;
+    color: #7b7b7b;
+    flex: none;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    cursor: pointer;
+}
+.pz-outliner .row-disclosure.empty { visibility: hidden; }
+
+.pz-outliner .row-identity {
+    min-width: 0;
+    flex: 1;
+    display: grid;
