index 0000000..3ac6350
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/PlumePressure.wgsl
@@ -0,0 +1,135 @@
+//============================================================================================================================================
+//                                                            PLUMEPRESSURE.WGSL
+//============================================================================================================================================
+// 🧩 Pressure projection of the coarse velocity: divergence, warm-started Jacobi sweeps, gradient subtraction.
+
+// 📝 Solves ∇²q = ∇·u and replaces u with u − ∇q, the divergence-free part. Boundary conditions per neighbour:
+//    a solid cell answers with the centre's q (no flow through the wall — Neumann); a neighbour outside the window
+//    sideways or above is open air at q = 0 (Dirichlet); below the floor is ground (Neumann). q persists between
+//    steps at toroidal texel addresses, so each step starts from the last solution of the same world cells — a few
+//    sweeps then do the work of many (Frontier's CoarseGasField.h starts every step from zero on the CPU). A cell the
+//    window has only just covered restarts from zero.
+//
+//    Bindings per pass: ResolveDivergence 1 → 2 (and clears 3, 4 where newly covered); RelaxPressure 1, 2, 3 → 4;
+//    ProjectVelocity 1, 3 → 5.
+
+//! include "PlumeRecords.wgsl"
+
+@group(0) @binding(0) var<uniform> Plume                       : PlumeRecord;
+@group(0) @binding(1) var VelocityState                        : texture_3d<f32>;
+@group(0) @binding(2) var<storage, read_write> Divergence      : array<f32>;
+@group(0) @binding(3) var<storage, read_write> PressureSource  : array<f32>;
+@group(0) @binding(4) var<storage, read_write> PressureTarget  : array<f32>;
+@group(0) @binding(5) var LatticeTarget                        : texture_storage_3d<rgba16float, write>;
+
+fn ClassifyInside(Local: vec3i) -> bool
+{
+    return all(Local >= vec3i(0)) && all(Local < vec3i(Plume.VelocityExtent.xyz));
+}
+
+fn LoadVelocity(Local: vec3i) -> vec4f
+{
+    let Clamped = clamp(Local, vec3i(0), vec3i(Plume.VelocityExtent.xyz) - vec3i(1));
+    return textureLoad(VelocityState, ResolveVelocityTexel(Plume, Clamped), 0);
+}
+
+fn ResolveLocalIndex(Local: vec3i) -> u32
+{
+    let Extent = vec3i(Plume.VelocityExtent.xyz);
+    return u32((Local.z * Extent.y + Local.y) * Extent.x + Local.x);
+}
+
+fn ResolvePressureIndex(Local: vec3i) -> u32
+{
+    let Extent = vec3i(Plume.VelocityExtent.xyz);
+    let Texel = ResolveVelocityTexel(Plume, Local);
+    return u32((Texel.z * Extent.y + Texel.y) * Extent.x + Texel.x);
+}
+
+// 📝 q at a neighbour under the boundary rules above; Centre is the cell's own q.
+fn ResolveNeighbourPressure(Local: vec3i, Centre: f32) -> f32
+{
+    if (Local.z < 0)
+    {
+        return Centre;
+    }
+    if (!ClassifyInside(Local))
+    {
+        return 0.0;
+    }
+    if (LoadVelocity(Local).w > 0.5)
+    {
+        return Centre;
+    }
+    return PressureSource[ResolvePressureIndex(Local)];
+}
+
+@compute @workgroup_size(4, 4, 4)
+fn ResolveDivergence(@builtin(global_invocation_id) Invocation: vec3u)
+{
+    if (any(Invocation >= Plume.VelocityExtent.xyz))
+    {
+        return;
+    }
+    let Local = vec3i(Invocation);
+    let Own = LoadVelocity(Local);
+    let Scale = 0.5 / Plume.Lattice.y;
+    let Flux = (LoadVelocity(Local + vec3i(1, 0, 0)).x - LoadVelocity(Local - vec3i(1, 0, 0)).x)
+             + (LoadVelocity(Local + vec3i(0, 1, 0)).y - LoadVelocity(Local - vec3i(0, 1, 0)).y)
+             + (LoadVelocity(Local + vec3i(0, 0, 1)).z - LoadVelocity(Local - vec3i(0, 0, 1)).z);
+    Divergence[ResolveLocalIndex(Local)] = select(Flux * Scale, 0.0, Own.w > 0.5);
+    let Position = ProjectVelocityWorld(Plume, Invocation);
+    if (!ClassifyWindowInterior(Position, Plume.PriorVelocityOrigin.xyz, Plume.VelocityExtent.xyz, Plume.Lattice.y, Plume.Lattice.z))
+    {
+        let Index = ResolvePressureIndex(Local);
+        PressureSource[Index] = 0.0;
+        PressureTarget[Index] = 0.0;
+    }
+}
+
+@compute @workgroup_size(4, 4, 4)
+fn RelaxPressure(@builtin(global_invocation_id) Invocation: vec3u)
+{
+    if (any(Invocation >= Plume.VelocityExtent.xyz))
+    {
+        return;
+    }
+    let Local = vec3i(Invocation);
+    let Index = ResolvePressureIndex(Local);
+    let Centre = PressureSource[Index];
+    if (LoadVelocity(Local).w > 0.5)
+    {
+        PressureTarget[Index] = Centre;
+        return;
+    }
+    let Sum = ResolveNeighbourPressure(Local + vec3i(1, 0, 0), Centre) + ResolveNeighbourPressure(Local - vec3i(1, 0, 0), Centre)
+            + ResolveNeighbourPressure(Local + vec3i(0, 1, 0), Centre) + ResolveNeighbourPressure(Local - vec3i(0, 1, 0), Centre)
+            + ResolveNeighbourPressure(Local + vec3i(0, 0, 1), Centre) + ResolveNeighbourPressure(Local - vec3i(0, 0, 1), Centre);
+    let Edge = Plume.Lattice.y;
+    PressureTarget[Index] = (Sum - Divergence[ResolveLocalIndex(Local)] * Edge * Edge) / 6.0;
+}
+
+@compute @workgroup_size(4, 4, 4)
+fn ProjectVelocity(@builtin(global_invocation_id) Invocation: vec3u)
+{
+    if (any(Invocation >= Plume.VelocityExtent.xyz))
+    {
+        return;
+    }
+    let Local = vec3i(Invocation);
+    let Own = LoadVelocity(Local);
+    if (Own.w > 0.5)
+    {
+        textureStore(LatticeTarget, ResolveVelocityTexel(Plume, Local), Own);
+        return;
+    }
+    let Centre = PressureSource[ResolvePressureIndex(Local)];
+    let Scale = 0.5 / Plume.Lattice.y;
+    let Gradient = vec3f(ResolveNeighbourPressure(Local + vec3i(1, 0, 0), Centre) - ResolveNeighbourPressure(Local - vec3i(1, 0, 0), Centre),
+                         ResolveNeighbourPressure(Local + vec3i(0, 1, 0), Centre) - ResolveNeighbourPressure(Local - vec3i(0, 1, 0), Centre),
+                         ResolveNeighbourPressure(Local + vec3i(0, 0, 1), Centre) - ResolveNeighbourPressure(Local - vec3i(0, 0, 1), Centre)) * Scale;
+    var Velocity = Own.xyz - Gradient;
+    let Speed = length(Velocity);
+    Velocity = select(Velocity, Velocity * (PlumeSpeedCeiling / Speed), Speed > PlumeSpeedCeiling);
+    textureStore(LatticeTarget, ResolveVelocityTexel(Plume, Local), vec4f(Velocity, 0.0));
+}
diff --git a/Experimental/FrontierEngine/Shader/PlumeRecords.wgsl b/Experimental/FrontierEngine/Shader/PlumeRecords.wgsl
new file mode 100644
index 0000000..be2f043
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/PlumeRecords.wgsl
@@ -0,0 +1,160 @@
+//============================================================================================================================================
+//                                                            PLUMERECORDS.WGSL
+//============================================================================================================================================
+// 🧩 The smoke-and-fire cell lattices: the step record, the source and fire-light records, and toroidal addressing shared by every plume program.
+
+// 📝 Two cell lattices follow the vehicle, addressed toroidally exactly as the scene distance field's cascades are:
+//    world cell c lives at texel c mod N, so the window moves by relabelling texels, never by copying them (Frontier's
+//    SmokeSpace.h relocates its whole lattice by a copy whenever the carrier leaves the guard band).
+//
+//    | Lattice  | Edge | Carries                                                                                   |
+//    |----------|------|-------------------------------------------------------------------------------------------|
+//    | velocity | 2h   | xyz velocity [m/s], w 1 where the scene distance field is solid                           |
+//    | thermo   | h    | r rubber smoke [-], g temperature above ambient [K], b flame [-], a soot [-]               |
+//    | light    | 2h   | r transmittance toward the sun, g toward the zenith, through the plume                    |
+//
+//    Two particulates, because a burnout and a tyre fire are different smokes: vapourised rubber condenses into a
+//    bright, highly scattering white-grey cloud (albedo ≈ 0.9), while burning rubber sheds black soot that absorbs
+//    almost everything it meets (albedo ≈ 0.1). Both ride the same velocity; the march mixes their optics per sample.
+//    XY wrap; Z does not — the window's floor is fixed under the course and its height covers the plume.
+
+struct PlumeRecord
+{
+    VelocityOrigin      : vec4i,   // [cell] xyz world coarse cell of the window's minimum corner (z is 0), w step ordinal
+    PriorVelocityOrigin : vec4i,   // [cell] xyz the window the lattice state was written in, w source count
+    VelocityExtent      : vec4u,   // [cell] xyz coarse lattice extent, w unused
+    ThermoExtent        : vec4u,   // [cell] xyz fine lattice extent, w inspection (1 shows the cells)
+    Lattice             : vec4f,   // x fine edge h [m], y coarse edge 2h [m], z floor height [m], w step duration [s]
+    Forces              : vec4f,   // x buoyancy [m/s²/K], y smoke weight [m/s²], z vorticity confinement [-], w curl turbulence [m/s]
+    Retention           : vec4f,   // [-] x smoke, y heat, z flame, w velocity — multipliers over this step
+    Wind                : vec4f,   // xyz ambient flow [m/s], w elapsed seconds [s]
+    SourceMinimum       : vec4f,   // xyz bounds of every source [m], w frame duration for moving-solid velocity [s]
+    SourceMaximum       : vec4f,   // xyz [m], w flame emission scale [-]
+    Optical             : vec4f,   // x smoke extinction per density [1/m], y smoke albedo [-], z soot extinction per density [1/m], w march samples
+    Sun                 : vec4f,   // xyz unit direction toward the sun, w soot albedo [-]
+    Combustion          : vec4f,   // x soot shed per flame per second [1/s], y heat released per flame per second [K/s], z soot retention [-], w unused
+    Scattering          : vec4f,   // x multiple-scattering strength [-], y phase anisotropy g [-], z ambient scale [-], w fire-light scale [-]
+    Detail              : vec4f,   // x sub-cell detail strength [-], y detail frequency [1/m], z turbulence frequency [1/m], w unused
+    Flame               : vec4f,   // x core temperature [K], y tip temperature [K], z heat at which a cell reaches the core [K], w unused
+}
+
+struct PlumeSource
+{
+    PositionRadius : vec4f,   // xyz [m] world centre, w [m] Gaussian radius
+    Velocity       : vec4f,   // xyz [m/s] injected momentum
+    Rates          : vec4f,   // x smoke [1/s], y heat [K/s], z flame [1/s], w soot [1/s]
+}
+
+// 📝 Burning tyres and exhaust pops as point lights: the march scatters them inside the smoke and the direct-radiance
+//    pass lights the car and the road with them. Radiance is flux per steradian [lx·m²·k], position the flame centre.
+struct FireLightRecord
+{
+    Count          : vec4u,              // x lights in use
+    PositionRadius : array<vec4f, 4>,    // xyz [m], w [m] source radius that softens the inverse square
+    Radiance       : array<vec4f, 4>,    // rgb intensity, w unused
+}
+
+const PlumeSpeedCeiling : f32 = 40.0;   // [m/s] - no cell is allowed to outrun this, whatever the sources say
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                 TOROIDAL ADDRESSING
+//------------------------------------------------------------------------------------------------------------------------
+
+fn WrapLattice(Cell: vec3i, Extent: vec3u) -> vec3i
+{
+    let Edge = vec3i(Extent);
+    return vec3i(((Cell.xy % Edge.xy) + Edge.xy) % Edge.xy, Cell.z);
+}
+
+// 📝 Texel of a local velocity cell (0 … extent − 1 inside the current window); local may step one cell outside.
+fn ResolveVelocityTexel(Plume: PlumeRecord, Local: vec3i) -> vec3i
+{
+    return WrapLattice(Plume.VelocityOrigin.xyz + Local, Plume.VelocityExtent.xyz);
+}
+
+fn ResolveThermoTexel(Plume: PlumeRecord, Local: vec3i) -> vec3i
+{
+    return WrapLattice(vec3i(2 * Plume.VelocityOrigin.xy, 0) + Local, Plume.ThermoExtent.xyz);
+}
+
+fn ProjectVelocityWorld(Plume: PlumeRecord, Local: vec3u) -> vec3f
+{
+    let Cell = vec3f(Plume.VelocityOrigin.xyz + vec3i(Local)) + 0.5;
+    return vec3f(Cell.xy * Plume.Lattice.y, Plume.Lattice.z + Cell.z * Plume.Lattice.y);
+}
+
+fn ProjectThermoWorld(Plume: PlumeRecord, Local: vec3u) -> vec3f
+{
+    let Cell = vec3f(vec3i(2 * Plume.VelocityOrigin.xy, 0) + vec3i(Local)) + 0.5;
+    return vec3f(Cell.xy * Plume.Lattice.x, Plume.Lattice.z + Cell.z * Plume.Lattice.x);
+}
+
+// 📝 Sampling coordinates: the repeat address mode on U and V performs the wrap; W is clamped.
+fn ProjectVelocityCoordinates(Plume: PlumeRecord, Position: vec3f) -> vec3f
+{
+    let Span = vec3f(Plume.VelocityExtent.xyz) * Plume.Lattice.y;
+    return vec3f(Position.xy / Span.xy, (Position.z - Plume.Lattice.z) / Span.z);
+}
+
+fn ProjectThermoCoordinates(Plume: PlumeRecord, Position: vec3f) -> vec3f
+{
+    let Span = vec3f(Plume.ThermoExtent.xyz) * Plume.Lattice.x;
+    return vec3f(Position.xy / Span.xy, (Position.z - Plume.Lattice.z) / Span.z);
+}
+
+// 📝 A position lies in a window's interior when every trilinear tap it takes is a texel of that window — half a cell
+//    in from each wrapped face, so a sample beside one edge can never read the opposite edge through the wrap.
+fn ClassifyWindowInterior(Position: vec3f, Origin: vec3i, Extent: vec3u, Edge: f32, Floor: f32) -> bool
+{
+    let Local = vec3f(Position.xy / Edge - vec2f(Origin.xy), (Position.z - Floor) / Edge);
+    return all(Local >= vec3f(0.5)) && all(Local <= vec3f(Extent) - vec3f(0.5));
+}
+
+fn ClassifyPriorVelocity(Plume: PlumeRecord, Position: vec3f) -> bool
+{
+    return ClassifyWindowInterior(Position, Plume.PriorVelocityOrigin.xyz, Plume.VelocityExtent.xyz, Plume.Lattice.y, Plume.Lattice.z);
+}
+
+fn ClassifyPriorThermo(Plume: PlumeRecord, Position: vec3f) -> bool
+{
+    return ClassifyWindowInterior(Position, vec3i(2 * Plume.PriorVelocityOrigin.xy, 0), Plume.ThermoExtent.xyz, Plume.Lattice.x, Plume.Lattice.z);
+}
+
+fn ClassifySourceBounds(Plume: PlumeRecord, Position: vec3f) -> bool
+{
+    return Plume.PriorVelocityOrigin.w > 0 && all(Position >= Plume.SourceMinimum.xyz) && all(Position <= Plume.SourceMaximum.xyz);
+}
+
+// 📐 Gaussian source weight exp(−1.7·d²/r²), r floored at three quarters of a cell so a source narrower than the
+//    lattice still deposits; zero beyond 3.5 radii (Frontier's SmokeTransport.slang injection). The centre is lifted
+//    0.55 of a cell, as Frontier's is: a contact patch lies on the supporting plane, and a Gaussian centred there
+//    would spend half its weight in cells the plane makes solid.
+fn ResolveSourceWeight(Source: PlumeSource, Position: vec3f, Edge: f32) -> f32
+{
+    let Radius = max(Source.PositionRadius.w, 0.75 * Edge);
+    let Offset = (Position - Source.PositionRadius.xyz - vec3f(0.0, 0.0, 0.55 * Edge)) / Radius;
+    let Squared = dot(Offset, Offset);
+    return select(exp(-1.7 * Squared), 0.0, Squared > 12.25);
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                   FLAME COLOUR
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📐 The colour of a blackbody at Temperature [K], linear Rec.709, normalised to unit maximum channel: Helland's fit of
+//    the Planckian locus (sRGB-encoded) decoded to linear. Valid 1000–6600 K; a tyre fire's soot glows 1100–1500 K at
+//    the tips and approaches 1800 K in the core.
+fn ResolveBlackbodyColour(Temperature: f32) -> vec3f
+{
+    let Hecto = clamp(Temperature, 1000.0, 6600.0) / 100.0;
+    let Green = clamp((99.4708025861 * log(Hecto) - 161.1195681661) / 255.0, 0.0, 1.0);
+    let Blue = select(clamp((138.5177312231 * log(max(Hecto - 10.0, 1.0)) - 305.0447927307) / 255.0, 0.0, 1.0), 0.0, Hecto <= 19.0);
+    return pow(vec3f(1.0, Green, Blue), vec3f(2.2));
+}
+
+// 📐 Stefan–Boltzmann in relative form: radiance rises with the fourth power of temperature, referred to 1500 K.
+fn ResolveBlackbodyRadiance(Temperature: f32) -> vec3f
+{
+    let Ratio = Temperature / 1500.0;
+    return ResolveBlackbodyColour(Temperature) * (Ratio * Ratio * Ratio * Ratio);
+}
diff --git a/Experimental/FrontierEngine/Shader/PlumeVorticity.wgsl b/Experimental/FrontierEngine/Shader/PlumeVorticity.wgsl
new file mode 100644
index 0000000..3fa7354
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/PlumeVorticity.wgsl
@@ -0,0 +1,75 @@
+//============================================================================================================================================
+//                                                           PLUMEVORTICITY.WGSL
+//============================================================================================================================================
+// 🧩 Vorticity confinement on the coarse velocity lattice: the curl, then a force along N × ω that restores lost swirl.
+
+// 📝 Semi-Lagrangian transport smears small eddies away within a few steps. Confinement (Fedkiw, Stam & Jensen 2001)
+//    measures ω = ∇ × u, finds N = ∇|ω| / ‖∇|ω|‖ pointing toward stronger rotation, and adds ε·h·(N × ω), which spins
+//    the eddies that remain back up — the rolling billows of tyre smoke, at no cost in lattice resolution.
+//    ResolveCurl reads the advected velocity (binding 1) and writes the curl; ConfineVorticity reads both and writes
+//    the confined velocity (binding 3). Cells outside the window read as their own neighbour (zero gradient).
+
+//! include "PlumeRecords.wgsl"
+
+@group(0) @binding(0) var<uniform> Plume               : PlumeRecord;
+@group(0) @binding(1) var VelocityState                : texture_3d<f32>;
+@group(0) @binding(2) var<storage, read_write> Curl    : array<vec4f>;
+@group(0) @binding(3) var LatticeTarget                : texture_storage_3d<rgba16float, write>;
+
+fn LoadVelocity(Local: vec3i) -> vec4f
+{
+    let Clamped = clamp(Local, vec3i(0), vec3i(Plume.VelocityExtent.xyz) - vec3i(1));
+    return textureLoad(VelocityState, ResolveVelocityTexel(Plume, Clamped), 0);
+}
+
+fn ResolveLocalIndex(Local: vec3i) -> u32
+{
+    let Extent = vec3i(Plume.VelocityExtent.xyz);
+    let Clamped = clamp(Local, vec3i(0), Extent - vec3i(1));
+    return u32((Clamped.z * Extent.y + Clamped.y) * Extent.x + Clamped.x);
+}
+
+@compute @workgroup_size(4, 4, 4)
+fn ResolveCurl(@builtin(global_invocation_id) Invocation: vec3u)
+{
+    if (any(Invocation >= Plume.VelocityExtent.xyz))
+    {
+        return;
+    }
+    let Local = vec3i(Invocation);
+    let Scale = 0.5 / Plume.Lattice.y;
+    let Xp = LoadVelocity(Local + vec3i(1, 0, 0)).xyz;
+    let Xm = LoadVelocity(Local - vec3i(1, 0, 0)).xyz;
+    let Yp = LoadVelocity(Local + vec3i(0, 1, 0)).xyz;
+    let Ym = LoadVelocity(Local - vec3i(0, 1, 0)).xyz;
+    let Zp = LoadVelocity(Local + vec3i(0, 0, 1)).xyz;
+    let Zm = LoadVelocity(Local - vec3i(0, 0, 1)).xyz;
+    let ω = vec3f((Yp.z - Ym.z) - (Zp.y - Zm.y), (Zp.x - Zm.x) - (Xp.z - Xm.z), (Xp.y - Xm.y) - (Yp.x - Ym.x)) * Scale;
+    Curl[ResolveLocalIndex(Local)] = vec4f(ω, length(ω));
+}
+
+@compute @workgroup_size(4, 4, 4)
+fn ConfineVorticity(@builtin(global_invocation_id) Invocation: vec3u)
+{
+    if (any(Invocation >= Plume.VelocityExtent.xyz))
+    {
+        return;
+    }
+    let Local = vec3i(Invocation);
+    let Own = LoadVelocity(Local);
+    var Velocity = Own.xyz;
+    if (Own.w < 0.5 && Plume.Forces.z > 0.0)
+    {
+        let Scale = 0.5 / Plume.Lattice.y;
+        let η = vec3f(Curl[ResolveLocalIndex(Local + vec3i(1, 0, 0))].w - Curl[ResolveLocalIndex(Local - vec3i(1, 0, 0))].w,
+                      Curl[ResolveLocalIndex(Local + vec3i(0, 1, 0))].w - Curl[ResolveLocalIndex(Local - vec3i(0, 1, 0))].w,
+                      Curl[ResolveLocalIndex(Local + vec3i(0, 0, 1))].w - Curl[ResolveLocalIndex(Local - vec3i(0, 0, 1))].w) * Scale;
+        let Length = length(η);
+        if (Length > 1.0e-5)
+        {
+            let ω = Curl[ResolveLocalIndex(Local)].xyz;
+            Velocity += Plume.Forces.z * Plume.Lattice.y * cross(η / Length, ω) * Plume.Lattice.w;
+        }
+    }
+    textureStore(LatticeTarget, ResolveVelocityTexel(Plume, Local), vec4f(Velocity, Own.w));
+}
diff --git a/Experimental/FrontierEngine/Shader/RayTraversal.wgsl b/Experimental/FrontierEngine/Shader/RayTraversal.wgsl
new file mode 100644
index 0000000..770349d
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/RayTraversal.wgsl
@@ -0,0 +1,1167 @@
+//============================================================================================================================================
+//                                                            RAYTRAVERSAL.WGSL
+//============================================================================================================================================
+// 🧩 Hardware-agnostic Two-Level BVH Ray-Triangle Intersection (TLAS over scene occupants + Binned-SAH BLAS per mesh),
+//    Two-Layer PBR BSDF Importance Sampling, RIS Next-Event Estimation (Sun + IES Clustered Lights + Fire),
+//    Multiple Importance Sampling (MIS), Russian Roulette, and Multi-Bounce Path Tracing for ReSTIR GI.
+
+//! include "CardSampling.wgsl"
+//! include "SurfaceReflectance.wgsl"
+//! include "PackingCodec.wgsl"
+//! include "DiscrepancySequence.wgsl"
+//! include "FireIllumination.wgsl"
+//! include "LightClusterSpace.wgsl"
+//! include "ReservoirRecords.wgsl"
+
+struct BoundingNode
+{
+    Minimum     : vec3f,
+    LeftOrFirst : u32,
+    Maximum     : vec3f,
+    Count       : u32,
+}
+
+@group(3) @binding(0) var<storage, read> BvhNodes     : array<BoundingNode>;
+@group(3) @binding(1) var<storage, read> BvhTriangles : array<vec4f>;
+@group(3) @binding(2) var<storage, read> RayMaterials : array<MaterialRecord>;
+// 📝 The one declaration of SceneLights: the light records and their world-grid cell masks (LightClusterSpace.js). Every shader that includes
+//    this file reads its lights here; the passes that do not (card relighting) declare it themselves.
+@group(3) @binding(3) var<uniform> SceneLights         : LightClusterRecords;   // a uniform: the temporal pass is at the 8-storage-buffer limit
+
+const TlasLeafBit        : u32 = 0x80000000u;
+const TlasIndexMask      : u32 = 0x7FFFFFFFu;
+const EmptyTlasSentinel  : u32 = 0x7FFFFFFFu;
+const BvhStackCapacity   : u32 = 48u;
+const MaxBvhSteps        : u32 = 384u;
+const RayEpsilon         : f32 = 2.0e-3;
+const SolarAngularRadius : f32 = 0.0047;
+
+struct RayHit
+{
+    Position : vec3f,   // [m]   world-space intersection point
+    Travel   : f32,     // [m]   ray parameter t
+    Normal   : vec3f,   // [-]   interpolated smooth shading normal in world space
+    Geometry : vec3f,   // [-]   geometric triangle normal in world space
+    Identity : u32,     // [-]   Occupant index, GroundIdentity, or SkyIdentity on miss
+    Family   : u32,     // [-]   exact triangle MaterialRecord index
+    Triangle : u32,     // [-]   global index of the struck triangle in BvhTriangles (0xFFFFFFFF: none)
+    Steps    : u32,     // [-]   BVH traversal step count
+    Hit      : bool,
+}
+
+fn SafeReciprocal(Direction: vec3f) -> vec3f
+{
+    let Safe = select(Direction, vec3f(1.0e-9), abs(Direction) < vec3f(1.0e-9));
+    return 1.0 / Safe;
+}
+
+fn IntersectNodeBounds(Origin: vec3f, Reciprocal: vec3f, Minimum: vec3f, Maximum: vec3f, Limit: f32) -> f32
+{
+    let Near  = (Minimum - Origin) * Reciprocal;
+    let Far   = (Maximum - Origin) * Reciprocal;
+    let Low   = min(Near, Far);
+    let High  = max(Near, Far);
+    let Entry = max(max(Low.x, Low.y), max(Low.z, 0.0));
+    let Exit  = min(min(High.x, High.y), min(High.z, Limit));
+    return select(1.0e30, Entry, Entry <= Exit);
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                           TLAS + BLAS CLOSEST-HIT TRAVERSAL
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📐 Exact Two-Level BVH ray-triangle intersection (Möller–Trumbore 1997) with near-first child ordering.
+fn TraceSceneRay(Origin: vec3f, Direction: vec3f, MinimumTravel: f32, MaximumTravel: f32) -> RayHit
+{
+    var Result : RayHit;
+    Result.Position = Origin + Direction * MaximumTravel;
+    Result.Travel   = MaximumTravel;
+    Result.Normal   = -Direction;
+    Result.Geometry = -Direction;
+    Result.Identity = SkyIdentity;
+    Result.Family   = 0u;
+    Result.Triangle = 0xFFFFFFFFu;
+    Result.Steps    = 0u;
+    Result.Hit      = false;
+
+    if (BvhNodes[0].LeftOrFirst == EmptyTlasSentinel && BvhNodes[0].Count == 0u)
+    {
+        return Result;
+    }
+
+    let WorldRecip = SafeReciprocal(Direction);
+    var Stack      : array<u32, BvhStackCapacity>;
+    var Depth      = 1u;
+    Stack[0]       = 0u;
+    var BlasFloor  = 0xFFFFFFFFu;
+
+    var Nearest    = MaximumTravel;
+    var BestTri    = 0xFFFFFFFFu;
+    var BestOcc    = 0xFFFFFFFFu;
+    var BestUV     = vec2f(0.0);
+    var Steps      = 0u;
+
+    var CurrentOcc  = 0xFFFFFFFFu;
+    var OccRoles    = 0u;
+    var LocalOrigin = Origin;
+    var LocalDir    = Direction;
+    var LocalRecip  = WorldRecip;
+
+    while (Depth > 0u && Steps < MaxBvhSteps)
+    {
+        if (Depth <= BlasFloor)
+        {
+            BlasFloor = 0xFFFFFFFFu;
+        }
+        Depth -= 1u;
+        let NodeIdx = Stack[Depth];
+        let Node    = BvhNodes[NodeIdx];
+        Steps += 1u;
+
+        if (BlasFloor == 0xFFFFFFFFu)
+        {
+            if (IntersectNodeBounds(Origin, WorldRecip, Node.Minimum, Node.Maximum, Nearest) >= Nearest)
+            {
+                continue;
+            }
+            if ((Node.Count & TlasLeafBit) != 0u)
+            {
+                CurrentOcc  = Node.Count & TlasIndexMask;
+                let Occ     = Occupants[CurrentOcc];
+                OccRoles    = Occ.Roles;
+                LocalOrigin = (Occ.WorldToLocal * vec4f(Origin, 1.0)).xyz;
+                LocalDir    = (Occ.WorldToLocal * vec4f(Direction, 0.0)).xyz;
+                LocalRecip  = SafeReciprocal(LocalDir);
+                if (Depth < BvhStackCapacity)
+                {
+                    BlasFloor    = Depth;
+                    Stack[Depth] = Node.LeftOrFirst;
+                    Depth += 1u;
+                }
+            }
+            else
+            {
+                let Left  = Node.LeftOrFirst;
+                let Right = Left + 1u;
+                let LDist = IntersectNodeBounds(Origin, WorldRecip, BvhNodes[Left].Minimum, BvhNodes[Left].Maximum, Nearest);
+                let RDist = IntersectNodeBounds(Origin, WorldRecip, BvhNodes[Right].Minimum, BvhNodes[Right].Maximum, Nearest);
+                if (LDist < RDist)
+                {
+                    if (RDist < Nearest && Depth < BvhStackCapacity) { Stack[Depth] = Right; Depth += 1u; }
+                    if (LDist < Nearest && Depth < BvhStackCapacity) { Stack[Depth] = Left;  Depth += 1u; }
+                }
+                else
+                {
+                    if (LDist < Nearest && Depth < BvhStackCapacity) { Stack[Depth] = Left;  Depth += 1u; }
+                    if (RDist < Nearest && Depth < BvhStackCapacity) { Stack[Depth] = Right; Depth += 1u; }
+                }
+            }
+        }
+        else
+        {
+            if (IntersectNodeBounds(LocalOrigin, LocalRecip, Node.Minimum, Node.Maximum, Nearest) >= Nearest)
+            {
+                continue;
+            }
+            if (Node.Count > 0u)
+            {
+                let FirstTri = Node.LeftOrFirst;
+                let TriEnd   = FirstTri + Node.Count;
+                for (var Tri = FirstTri; Tri < TriEnd; Tri += 1u)
+                {
+                    let Base      = Tri * 4u;
+                    let T0        = BvhTriangles[Base];
+                    let RawFamily = bitcast<u32>(T0.w);
+                    if (RawFamily == VehicleGlassFamily)
+                    {
+                        continue;
+                    }
+                    if (RawFamily == TyreFamily && (OccRoles & RoleShredded) != 0u)
+                    {
+                        continue;
+                    }
+                    let E1  = BvhTriangles[Base + 1u].xyz;
+                    let E2  = BvhTriangles[Base + 2u].xyz;
+                    let P   = cross(LocalDir, E2);
+                    let Det = dot(E1, P);
+                    if (abs(Det) < 1.0e-9)
+                    {
+                        continue;
+                    }
+                    let InvDet = 1.0 / Det;
+                    let T      = LocalOrigin - T0.xyz;
+                    let U      = dot(T, P) * InvDet;
+                    if (U < 0.0 || U > 1.0)
+                    {
+                        continue;
+                    }
+                    let Q = cross(T, E1);
+                    let V = dot(LocalDir, Q) * InvDet;
+                    if (V < 0.0 || U + V > 1.0)
+                    {
+                        continue;
+                    }
+                    let Travel = dot(E2, Q) * InvDet;
+                    if (Travel >= MinimumTravel && Travel < Nearest)
+                    {
+                        Nearest = Travel;
+                        BestTri = Tri;
+                        BestOcc = CurrentOcc;
+                        BestUV  = vec2f(U, V);
+                    }
+                }
+            }
+            else
+            {
+                let Left  = Node.LeftOrFirst;
+                let Right = Left + 1u;
+                let LDist = IntersectNodeBounds(LocalOrigin, LocalRecip, BvhNodes[Left].Minimum, BvhNodes[Left].Maximum, Nearest);
+                let RDist = IntersectNodeBounds(LocalOrigin, LocalRecip, BvhNodes[Right].Minimum, BvhNodes[Right].Maximum, Nearest);
+                if (LDist < RDist)
+                {
+                    if (RDist < Nearest && Depth < BvhStackCapacity) { Stack[Depth] = Right; Depth += 1u; }
+                    if (LDist < Nearest && Depth < BvhStackCapacity) { Stack[Depth] = Left;  Depth += 1u; }
+                }
+                else
+                {
+                    if (LDist < Nearest && Depth < BvhStackCapacity) { Stack[Depth] = Left;  Depth += 1u; }
+                    if (RDist < Nearest && Depth < BvhStackCapacity) { Stack[Depth] = Right; Depth += 1u; }
+                }
+            }
+        }
+    }
+
+    Result.Steps = Steps;
+
+    if (BestTri != 0xFFFFFFFFu)
+    {
+        let Base = BestTri * 4u;
+        let T0   = BvhTriangles[Base];
+        let T1   = BvhTriangles[Base + 1u];
+        let T2   = BvhTriangles[Base + 2u];
+        let T3   = BvhTriangles[Base + 3u];
+
+        let NA = UnpackOctahedral(bitcast<u32>(T1.w));
+        let NB = UnpackOctahedral(bitcast<u32>(T2.w));
+        let NC = UnpackOctahedral(bitcast<u32>(T3.w));
+        let W  = 1.0 - BestUV.x - BestUV.y;
+        let LocalShading = normalize(NA * W + NB * BestUV.x + NC * BestUV.y);
+
+        let Occ        = Occupants[BestOcc];
+        var WorldNorm  = normalize((Occ.LocalToWorld * vec4f(LocalShading, 0.0)).xyz);
+        var WorldGeom  = normalize((Occ.LocalToWorld * vec4f(T3.xyz, 0.0)).xyz);
+        if (dot(WorldGeom, Direction) > 0.0)
+        {
+            WorldGeom = -WorldGeom;
+        }
+        if (dot(WorldNorm, Direction) > 0.0)
+        {
+            WorldNorm = -WorldNorm;
+        }
+
+        let RawFamily   = bitcast<u32>(T0.w);
+        Result.Position = Origin + Direction * Nearest;
+        Result.Travel   = Nearest;
+        Result.Normal   = WorldNorm;
+        Result.Geometry = WorldGeom;
+        Result.Family   = select(RawFamily, Occ.MaterialOverride, Occ.MaterialOverride != NoMaterialOverride);
+        Result.Identity = select(BestOcc, GroundIdentity, BestOcc == GroundOccupantIndex);
+        Result.Triangle = BestTri;
+        Result.Hit      = true;
+        return Result;
+    }
+
+    // Far-field horizon ground fallback beyond the authored 220m mesh
+    if (Direction.z < -1.0e-4)
+    {
+        let GroundTravel = (Distance.GroundHeight - Origin.z) / Direction.z;
+        if (GroundTravel >= MinimumTravel && GroundTravel <= MaximumTravel)
+        {
+            Result.Position = Origin + Direction * GroundTravel;
+            Result.Travel   = GroundTravel;
+            Result.Normal   = vec3f(0.0, 0.0, 1.0);
+            Result.Geometry = vec3f(0.0, 0.0, 1.0);
+            Result.Identity = GroundIdentity;
+            Result.Family   = SurroundFamily;
+            Result.Hit      = true;
+        }
+    }
+
+    return Result;
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                           TLAS + BLAS ANY-HIT VISIBILITY
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📐 Exact any-hit shadow ray traversal: exits on the very first triangle intersection in [MinimumTravel, MaximumTravel).
+fn TraceSceneVisibility(Origin: vec3f, Direction: vec3f, MinimumTravel: f32, MaximumTravel: f32) -> f32
+{
+    if (MaximumTravel <= MinimumTravel)
+    {
+        return 1.0;
+    }
+    if (BvhNodes[0].LeftOrFirst == EmptyTlasSentinel && BvhNodes[0].Count == 0u)
+    {
+        return 1.0;
+    }
+
+    let WorldRecip = SafeReciprocal(Direction);
+    var Stack      : array<u32, BvhStackCapacity>;
+    var Depth      = 1u;
+    Stack[0]       = 0u;
+    var BlasFloor  = 0xFFFFFFFFu;
+    var Steps      = 0u;
+
+    var OccRoles    = 0u;
+    var LocalOrigin = Origin;
+    var LocalDir    = Direction;
+    var LocalRecip  = WorldRecip;
+
+    while (Depth > 0u && Steps < MaxBvhSteps)
+    {
+        if (Depth <= BlasFloor)
+        {
+            BlasFloor = 0xFFFFFFFFu;
+        }
+        Depth -= 1u;
+        let NodeIdx = Stack[Depth];
+        let Node    = BvhNodes[NodeIdx];
+        Steps += 1u;
+
+        if (BlasFloor == 0xFFFFFFFFu)
+        {
+            if (IntersectNodeBounds(Origin, WorldRecip, Node.Minimum, Node.Maximum, MaximumTravel) >= MaximumTravel)
+            {
+                continue;
+            }
+            if ((Node.Count & TlasLeafBit) != 0u)
+            {
+                let OccIdx  = Node.Count & TlasIndexMask;
+                let Occ     = Occupants[OccIdx];
+                OccRoles    = Occ.Roles;
+                LocalOrigin = (Occ.WorldToLocal * vec4f(Origin, 1.0)).xyz;
+                LocalDir    = (Occ.WorldToLocal * vec4f(Direction, 0.0)).xyz;
+                LocalRecip  = SafeReciprocal(LocalDir);
+                if (Depth < BvhStackCapacity)
+                {
+                    BlasFloor    = Depth;
+                    Stack[Depth] = Node.LeftOrFirst;
+                    Depth += 1u;
+                }
+            }
+            else
+            {
+                let Left  = Node.LeftOrFirst;
+                let Right = Left + 1u;
+                let LDist = IntersectNodeBounds(Origin, WorldRecip, BvhNodes[Left].Minimum, BvhNodes[Left].Maximum, MaximumTravel);
+                let RDist = IntersectNodeBounds(Origin, WorldRecip, BvhNodes[Right].Minimum, BvhNodes[Right].Maximum, MaximumTravel);
+                if (LDist < RDist)
+                {
+                    if (RDist < MaximumTravel && Depth < BvhStackCapacity) { Stack[Depth] = Right; Depth += 1u; }
+                    if (LDist < MaximumTravel && Depth < BvhStackCapacity) { Stack[Depth] = Left;  Depth += 1u; }
+                }
+                else
+                {
+                    if (LDist < MaximumTravel && Depth < BvhStackCapacity) { Stack[Depth] = Left;  Depth += 1u; }
+                    if (RDist < MaximumTravel && Depth < BvhStackCapacity) { Stack[Depth] = Right; Depth += 1u; }
+                }
+            }
+        }
+        else
+        {
+            if (IntersectNodeBounds(LocalOrigin, LocalRecip, Node.Minimum, Node.Maximum, MaximumTravel) >= MaximumTravel)
+            {
+                continue;
+            }
+            if (Node.Count > 0u)
+            {
+                let FirstTri = Node.LeftOrFirst;
+                let TriEnd   = FirstTri + Node.Count;
+                for (var Tri = FirstTri; Tri < TriEnd; Tri += 1u)
+                {
+                    let Base      = Tri * 4u;
+                    let T0        = BvhTriangles[Base];
+                    let RawFamily = bitcast<u32>(T0.w);
+                    if (RawFamily == VehicleGlassFamily)
+                    {
+                        continue;
+                    }
+                    if (RawFamily == TyreFamily && (OccRoles & RoleShredded) != 0u)
+                    {
+                        continue;
+                    }
+                    let E1  = BvhTriangles[Base + 1u].xyz;
+                    let E2  = BvhTriangles[Base + 2u].xyz;
+                    let P   = cross(LocalDir, E2);
+                    let Det = dot(E1, P);
+                    if (abs(Det) < 1.0e-9)
+                    {
+                        continue;
+                    }
+                    let InvDet = 1.0 / Det;
+                    let T      = LocalOrigin - T0.xyz;
+                    let U      = dot(T, P) * InvDet;
+                    if (U < 0.0 || U > 1.0)
+                    {
+                        continue;
+                    }
+                    let Q = cross(T, E1);
+                    let V = dot(LocalDir, Q) * InvDet;
+                    if (V < 0.0 || U + V > 1.0)
+                    {
+                        continue;
+                    }
+                    let Travel = dot(E2, Q) * InvDet;
+                    if (Travel >= MinimumTravel && Travel < MaximumTravel)
+                    {
+                        return 0.0;
+                    }
+                }
+            }
+            else
+            {
+                let Left  = Node.LeftOrFirst;
+                let Right = Left + 1u;
+                let LDist = IntersectNodeBounds(LocalOrigin, LocalRecip, BvhNodes[Left].Minimum, BvhNodes[Left].Maximum, MaximumTravel);
+                let RDist = IntersectNodeBounds(LocalOrigin, LocalRecip, BvhNodes[Right].Minimum, BvhNodes[Right].Maximum, MaximumTravel);
+                if (LDist < RDist)
+                {
+                    if (RDist < MaximumTravel && Depth < BvhStackCapacity) { Stack[Depth] = Right; Depth += 1u; }
+                    if (LDist < MaximumTravel && Depth < BvhStackCapacity) { Stack[Depth] = Left;  Depth += 1u; }
+                }
+                else
+                {
+                    if (LDist < MaximumTravel && Depth < BvhStackCapacity) { Stack[Depth] = Left;  Depth += 1u; }
+                    if (RDist < MaximumTravel && Depth < BvhStackCapacity) { Stack[Depth] = Right; Depth += 1u; }
+                }
+            }
+        }
+    }
+
+    return 1.0;
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                     SOLAR CONE, RIS LIGHT NEE & BSDF SAMPLING
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📐 Jitters a solar ray within the sun's angular radius (~0.27°) for physically accurate soft penumbrae.
+fn SampleSunConeDirection(SunDirection: vec3f, Pair: vec2f) -> vec3f
+{
+    let Disk  = ProjectUniformDisk(Pair) * SolarAngularRadius;
+    let Basis = ConstructTangentFrame(SunDirection);
+    return normalize(SunDirection + Basis[0] * Disk.x + Basis[1] * Disk.y);
+}
+
+// 📐 Heitz 2018, "Sampling the GGX Distribution of Visible Normals"; view in tangent space, Alpha = Roughness².
+fn ProjectVisibleNormal(View: vec3f, Alpha: f32, Pair: vec2f) -> vec3f
+{
+    let Stretched = normalize(vec3f(Alpha * View.x, Alpha * View.y, max(View.z, 1.0e-4)));
+    let LengthSquared = Stretched.x * Stretched.x + Stretched.y * Stretched.y;
+    let T1 = select(vec3f(1.0, 0.0, 0.0), vec3f(-Stretched.y, Stretched.x, 0.0) * inverseSqrt(LengthSquared), LengthSquared > 0.0);
+    let T2 = cross(Stretched, T1);
+    let Radius = sqrt(Pair.x);
+    let Phi = 2.0 * Pi * Pair.y;
+    let P1 = Radius * cos(Phi);
+    let Interpolant = 0.5 * (1.0 + Stretched.z);
+    let P2 = mix(sqrt(max(0.0, 1.0 - P1 * P1)), Radius * sin(Phi), Interpolant);
+    let Hemisphere = P1 * T1 + P2 * T2 + sqrt(max(0.0, 1.0 - P1 * P1 - P2 * P2)) * Stretched;
+    return normalize(vec3f(Alpha * Hemisphere.x, Alpha * Hemisphere.y, max(1.0e-4, Hemisphere.z)));
+}
+
+// 📐 GGX VNDF reflection PDF (Heitz 2018): D_v(H) / (4 · (V·H)) = D(H) · G1(V) / (4 · (N·V)).
+fn EvaluateGgxVndfPdf(NoV: f32, NoH: f32, VoH: f32, Roughness: f32) -> f32
+{
+    let Alpha  = max(Roughness * Roughness, 1.0e-3);
+    let Alpha2 = Alpha * Alpha;
+    let D      = ResolveGgxDistribution(NoH, Roughness);
+    let G1     = 2.0 * NoV / max(NoV + sqrt(Alpha2 + (1.0 - Alpha2) * NoV * NoV), 1.0e-4);
+    return (D * G1) / max(4.0 * NoV, 1.0e-4);
+}
+
+// 📐 The probability with which the mixture BSDF sampler below picks its specular lobe, and the roughness it samples that lobe with; one definition for the sampler
+//    and for EvaluateBsdfPdf, so the pdf of a direction is the pdf the sampler really used.
+fn ResolveSpecularProbability(Surface: SurfaceSample, NoV: f32) -> f32
+{
+    let F0  = ResolveSpecularColour(Surface);
+    let FresnelLum = ResolveLuminance(ResolveFresnel(F0, NoV)) + Surface.CoatWeight * 0.04;
+    let DiffuseLum = ResolveLuminance(ResolveDiffuseAlbedo(Surface));
+    let SpecProb = FresnelLum / max(FresnelLum + DiffuseLum, 1.0e-4);
+    return select(clamp(SpecProb, 0.15, 0.85), 0.92, Surface.Metalness > 0.9 && Surface.Roughness < 0.25);
+}
+
+fn ResolveEffectiveRoughness(Surface: SurfaceSample) -> f32
+{
+    return clamp(mix(Surface.Roughness, Surface.CoatRoughness, Surface.CoatWeight * 0.5), 0.04, 1.0);
+}
+
+// 📐 The mixture pdf (solid angle) with which SampleSurfaceBsdf would have produced LightDir from View, 0 below the horizon.
+fn EvaluateBsdfPdf(Surface: SurfaceSample, Normal: vec3f, View: vec3f, LightDir: vec3f) -> f32
+{
+    let NoL = dot(Normal, LightDir);
+    if (NoL <= 1.0e-4)
+    {
+        return 0.0;
+    }
+    let NoV  = max(dot(Normal, View), 1.0e-4);
+    let Half = normalize(View + LightDir);
+    let NoH  = saturate(dot(Normal, Half));
+    let VoH  = max(dot(View, Half), 1.0e-4);
+    let DiffPdf = NoL * InversePi;
+    let SpecPdf = EvaluateGgxVndfPdf(NoV, NoH, VoH, ResolveEffectiveRoughness(Surface));
+    return max(mix(DiffPdf, SpecPdf, ResolveSpecularProbability(Surface, NoV)), 1.0e-4);
+}
+
+// 📐 Two-layer PBR BSDF importance sampling (GGX VNDF specular/clearcoat lobe + cosine diffuse lobe) with exact mixture PDF.
+fn SampleSurfaceBsdf(
+    Surface       : SurfaceSample,
+    Normal        : vec3f,
+    View          : vec3f,
+    Seed          : ptr<function, u32>,
+    OutDirection  : ptr<function, vec3f>,
+    OutThroughput : ptr<function, vec3f>,
+    OutPdf        : ptr<function, f32>
+) -> bool
+{
+    let NoV = max(dot(Normal, View), 1.0e-4);
+    let SpecProb       = ResolveSpecularProbability(Surface, NoV);
+    let EffectiveRough = ResolveEffectiveRoughness(Surface);
+
+    let Basis    = ConstructTangentFrame(Normal);
+    let Choice   = AdvanceUniform(Seed);
+    let Pair     = vec2f(AdvanceUniform(Seed), AdvanceUniform(Seed));
+    var LightDir = Normal;
+
+    if (Choice < SpecProb)
+    {
+        let ViewLocal = vec3f(dot(View, Basis[0]), dot(View, Basis[1]), max(dot(View, Basis[2]), 1.0e-3));
+        let HalfLocal = ProjectVisibleNormal(ViewLocal, EffectiveRough * EffectiveRough, Pair);
+        let HalfWorld = normalize(Basis * HalfLocal);
+        LightDir      = reflect(-View, HalfWorld);
+        if (dot(Normal, LightDir) <= 1.0e-4)
+        {
+            LightDir = normalize(Basis * ProjectCosineHemisphere(Pair));
+        }
+    }
+    else
+    {
+        LightDir = normalize(Basis * ProjectCosineHemisphere(Pair));
+    }
+
+    let NoL = dot(Normal, LightDir);
+    if (NoL <= 1.0e-4)
+    {
+        return false;
+    }
+
+    let MixPdf = EvaluateBsdfPdf(Surface, Normal, View, LightDir);
+    let Brdf   = ResolveDirectReflectance(Surface, Normal, View, LightDir);
+    *OutDirection  = LightDir;
+    *OutThroughput = min(Brdf / MixPdf, vec3f(8.0));
+    *OutPdf        = MixPdf;
+    return true;
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                      EMISSIVE CLUSTERS AS LIGHTS (NEXT-EVENT ESTIMATION)
+//------------------------------------------------------------------------------------------------------------------------
+// BEGIN EMISSIVE SAMPLING (Tools/EmissiveParityGpu.mjs extracts exactly this block into a probe shader)
+// 📝 See EmissiveLightSpace.js for the structure and the argument that this is unbiased. In short: an emitter point has two techniques, the BSDF ray that happens to hit it and
+//    the light sample below. The BSDF technique keeps the renderer's own heuristic weight w_b(ω) (EvaluateEmissiveBsdfWeight) and the light technique takes 1 − w_b(ω). Wherever
+//    the light technique is not available (feature off, not ray tracing, outside the grid, a cell with more clusters than slots) the BSDF hit counts in full.
+
+const EmissiveEmptySlot     : u32 = 0x7FFFu;
+const EmissiveSlotCount     : u32 = 8u;
+const EmissiveUnusable      : vec4u = vec4u(0xFFFFFFFFu);
+const EmissiveSamplesPerVertex : u32 = 2u;
+
+struct EmissiveSample
+{
+    Valid    : bool,
+    Position : vec3f,   // [m]  world point on the emitter
+    Normal   : vec3f,   // [-]  its geometric normal (emitters shine from both sides, as the traversal flips normals to face the ray)
+    Radiance : vec3f,   // [-]  emitted radiance, colour × luminance × the emission scale
+    Pdf      : f32,     // [1/m²] density of choosing this point (cluster × triangle × uniform on the triangle)
+}
+
+// 📝 The cell's cluster ids at a world position, or EmissiveUnusable (the feature is off, not ray tracing, no clusters, or the point lies outside the grid): then there is no
+//    light technique at that vertex and every emitter seen from it counts in full.
+fn ResolveEmissiveCell(Position: vec3f) -> vec4u
+{
+    if (!ExtendedEnabled(Frame, ExtendedEmissiveLights) || !FeatureEnabled(Frame, FeatureRayTracing) || SceneLights.Extent.w < 0.5)
+    {
+        return EmissiveUnusable;
+    }
+    let Local = (Position - SceneLights.Minimum.xyz) / SceneLights.Extent.xyz;
+    if (any(Local < vec3f(0.0)) || any(Local >= vec3f(1.0)))
+    {
+        return EmissiveUnusable;
+    }
+    let Cell = min(vec3u(Local * vec3f(LightClusterResolution)), LightClusterResolution - vec3u(1u));
+    return SceneLights.EmissiveCells[Cell.x + LightClusterResolution.x * (Cell.y + LightClusterResolution.y * Cell.z)];
+}
+
+fn EmissiveUsable(Words: vec4u) -> bool
+{
+    return Words.x != 0xFFFFFFFFu;
+}
+
+fn ResolveEmissiveSlot(Words: vec4u, Slot: u32) -> u32
+{
+    let Pair = Words[Slot >> 1u];
+    return select(Pair & 0x7FFFu, (Pair >> 16u) & 0x7FFFu, (Slot & 1u) != 0u);
+}
+
+// 📝 Is this traced hit an emitter the table represents (its occupant carries RoleEmissiveCluster)?
+fn IsTableEmitter(Identity: u32) -> bool
+{
+    return Identity < arrayLength(&Occupants) && (Occupants[Identity].Roles & RoleEmissiveCluster) != 0u;
+}
+
+// 📐 Can this cell's light technique draw the traced hit (occupant, BVH triangle)? Exactly when the triangle is in a cluster the cell lists. The BSDF technique takes the partition's
+//    w_b at such a hit and weight 1 at every other emitter.
+fn IsListedEmitter(Words: vec4u, Identity: u32, Triangle: u32) -> bool
+{
+    if (!EmissiveUsable(Words) || !IsTableEmitter(Identity))
+    {
+        return false;
+    }
+    for (var Slot = 0u; Slot < EmissiveSlotCount; Slot += 1u)
+    {
+        let Id = ResolveEmissiveSlot(Words, Slot);
+        if (Id == EmissiveEmptySlot)
+        {
+            break;
+        }
+        let Cluster = SceneLights.EmissiveClusters[Id];
+        if (Cluster.Meta.x != Identity)
+        {
+            continue;
+        }
+        for (var Index = 0u; Index < Cluster.Meta.z; Index += 1u)
+        {
+            if (bitcast<u32>(SceneLights.EmissiveTriangles[Cluster.Meta.y + Index].A.w) == Triangle)
+            {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+// 📝 The conservative occupant-level version, for screen strikes (which know the occupant but not the triangle): true when ANY cluster of the occupant is listed. Treating a strike
+//    as listed when it need not be only sends that ray down the BVH path instead of the screen, which is always correct.
+fn IsListedOccupant(Words: vec4u, Identity: u32) -> bool
+{
+    if (!EmissiveUsable(Words) || !IsTableEmitter(Identity))
+    {
+        return false;
+    }
+    for (var Slot = 0u; Slot < EmissiveSlotCount; Slot += 1u)
+    {
+        let Id = ResolveEmissiveSlot(Words, Slot);
+        if (Id == EmissiveEmptySlot)
+        {
+            break;
+        }
+        if (SceneLights.EmissiveClusters[Id].Meta.x == Identity)
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+fn ResolveEmissiveTriangleWeight(Triangle: EmissiveTriangleRecord) -> f32
+{
+    return Triangle.E1.w * ResolveLuminance(RayMaterials[bitcast<u32>(Triangle.E2.w)].Emission);
+}
+
+// 📐 The heuristic weight the path tracer has always given the BSDF technique at an emissive hit: a function of the BSDF's pdf for the direction and of the emitter's geometry
+//    (squared distance, cosine at the emitter) and of nothing else. Defined by the pair (vertex, emitter point), so the light technique can evaluate the very same number.
+fn EvaluateEmissiveBsdfWeight(BsdfPdf: f32, Distance: f32, CosineAtEmitter: f32) -> f32
+{
+    let DistSq   = max(Distance * Distance, 0.04);
+    let GeomTerm = max(CosineAtEmitter, 0.05) / DistSq;
+    return clamp((BsdfPdf * BsdfPdf) / max(BsdfPdf * BsdfPdf + GeomTerm * GeomTerm * 0.01, 1.0e-5), 0.15, 1.0);
+}
+
+// 📐 Draws one point on the emitters of a cell: a cluster in proportion to power / (d² + r²), a triangle in proportion to area × luminance, a uniform point on it.
+//    R carries four uniforms (cluster, triangle, the two barycentric coordinates).
+fn SampleEmissiveLight(Position: vec3f, Words: vec4u, R: vec4f) -> EmissiveSample
+{
+    var Result : EmissiveSample;
+    Result.Valid = false;
+    var Weights : array<f32, 8>;
+    var Total = 0.0;
+    var Count = 0u;
+    for (var Slot = 0u; Slot < EmissiveSlotCount; Slot += 1u)
+    {
+        let Id = ResolveEmissiveSlot(Words, Slot);
+        if (Id == EmissiveEmptySlot)
+        {
+            break;
+        }
+        let Cluster = SceneLights.EmissiveClusters[Id];
+        let Toward  = Cluster.CentreReach.xyz - Position;
+        let Weight  = max(bitcast<f32>(Cluster.Meta.w), 0.0) / (dot(Toward, Toward) + Cluster.CentreReach.w * Cluster.CentreReach.w + 1.0e-4);
+        Weights[Slot] = Weight;
+        Total += Weight;
+        Count += 1u;
+    }
+    if (Count == 0u || !(Total > 0.0))
+    {
+        return Result;
+    }
+    var Chosen = Count - 1u;
+    var Running = 0.0;
+    let Pick = R.x * Total;
+    for (var Slot = 0u; Slot < Count; Slot += 1u)
+    {
+        Running += Weights[Slot];
+        if (Pick < Running)
+        {
+            Chosen = Slot;
+            break;
+        }
+    }
+    let ClusterProbability = Weights[Chosen] / Total;
+    let Cluster = SceneLights.EmissiveClusters[ResolveEmissiveSlot(Words, Chosen)];
+    let First = Cluster.Meta.y;
+    let Number = Cluster.Meta.z;
+    var TriangleTotal = 0.0;
+    for (var Index = 0u; Index < Number; Index += 1u)
+    {
+        TriangleTotal += ResolveEmissiveTriangleWeight(SceneLights.EmissiveTriangles[First + Index]);
+    }
+    if (!(TriangleTotal > 0.0))
+    {
+        return Result;
+    }
+    var Triangle = SceneLights.EmissiveTriangles[First + Number - 1u];
+    var TriangleWeight = ResolveEmissiveTriangleWeight(Triangle);
+    var Cumulative = 0.0;
+    let TrianglePick = R.y * TriangleTotal;
+    for (var Index = 0u; Index < Number; Index += 1u)
+    {
+        let Candidate = SceneLights.EmissiveTriangles[First + Index];
+        let Weight    = ResolveEmissiveTriangleWeight(Candidate);
+        Cumulative += Weight;
+        if (TrianglePick < Cumulative)
+        {
+            Triangle       = Candidate;
+            TriangleWeight = Weight;
+            break;
+        }
+    }
+    let Root = sqrt(R.z);
+    let B1   = Root * (1.0 - R.w);
+    let B2   = Root * R.w;
+    let ToWorld = Occupants[Cluster.Meta.x].LocalToWorld;
+    let Point   = (ToWorld * vec4f(Triangle.A.xyz + Triangle.E1.xyz * B1 + Triangle.E2.xyz * B2, 1.0)).xyz;
+    let Edge1   = (ToWorld * vec4f(Triangle.E1.xyz, 0.0)).xyz;
+    let Edge2   = (ToWorld * vec4f(Triangle.E2.xyz, 0.0)).xyz;
+    let Cross   = cross(Edge1, Edge2);
+    let Area    = 0.5 * length(Cross);
+    if (!(Area > 1.0e-9))
+    {
+        return Result;
+    }
+    Result.Valid    = true;
+    Result.Position = Point;
+    Result.Normal   = Cross / (2.0 * Area);
+    Result.Radiance = RayMaterials[bitcast<u32>(Triangle.E2.w)].Emission * Frame.EmissionScale;
+    Result.Pdf      = ClusterProbability * (TriangleWeight / TriangleTotal) / Area;
+    return Result;
+}
+// END EMISSIVE SAMPLING
+
+// 📐 Next-Event Estimation (NEE) at a path vertex:
+//    1. Soft solar cone NEE with exact BVH shadow ray + MIS weight
+//    2. Active tyre fire point light NEE
+//    3. Resampled Importance Sampling (RIS) over the lights of the vertex's grid cell with 1 exact BVH shadow ray
+fn EvaluateDirectNextEvent(
+    Position     : vec3f,
+    Normal       : vec3f,
+    View         : vec3f,
+    Surface      : SurfaceSample,
+    Seed         : ptr<function, u32>,
+    TraceShadows : bool,
+    AllowEmissive : bool
+) -> vec3f
+{
+    var Direct = vec3f(0.0);
+    let Origin = Position + Normal * RayEpsilon;
+
+    // 1. Direct Sun NEE (scaled by Pi to match the engine's exitant radiance convention where DisplayRecombination applies InversePi)
+    let Pair   = vec2f(AdvanceUniform(Seed), AdvanceUniform(Seed));
+    let SunDir = SampleSunConeDirection(Frame.SunDirection, Pair);
+    if (dot(Normal, SunDir) > 0.0)
+    {
+        let SunBrdf = ResolveDirectReflectance(Surface, Normal, View, SunDir) * Pi;
+        if (any(SunBrdf > vec3f(0.0)))
+        {
+            var SunVis = 1.0;
+            if (TraceShadows && FeatureEnabled(Frame, FeatureDirectShadow))
+            {
+                SunVis = TraceSceneVisibility(Origin, SunDir, RayEpsilon, 400.0);
+            }
+            Direct += Frame.SunIlluminance * SunVis * SunBrdf;
+        }
+    }
+
+    // 2. Tyre Fire NEE
+    let Fire = ResolveFireArrival(Position, Normal);
+    if (any(Fire.Illuminance > vec3f(0.0)))
+    {
+        Direct += Fire.Illuminance * ResolveDirectReflectance(Surface, Normal, View, Fire.Direction) * Pi;
+    }
+
+    // 3. Inline RIS over Clustered Photometric / IES Lights (street lamps, headlights, fog beams, roof floodlights)
+    var SelectedContrib = vec3f(0.0);
+    var SelectedDir     = vec3f(0.0, 0.0, 1.0);
+    var SelectedDist    = 0.0;
+    var SelectedWeight  = 0.0;
+    var WeightSum       = 0.0;
+    var SelectedEmissive = false;
+
+    // 📝 Only the lights whose reach touches this vertex's grid cell are candidates (LightClusterSpace.wgsl); a vertex outside the grid
+    //    takes them all, so none is ever skipped.
+    var Candidates = ResolveLightCandidates(Position);
+    while (Candidates != 0u)
+    {
+        let LightIdx = firstTrailingBit(Candidates);
+        Candidates &= Candidates - 1u;
+        let Light = SceneLights.Lights[LightIdx];
+        let Arrival = EvaluateLightArrival(Light, Position, Normal);
+        if (all(Arrival <= vec3f(1.0e-5)))
+        {
+            continue;
+        }
+        let Toward  = Light.PositionType.xyz - Position;
+        let Dist    = length(Toward);
+        let LDir    = Toward / max(Dist, 1.0e-4);
+        let Contrib = Arrival * ResolveDirectReflectance(Surface, Normal, View, LDir) * Pi;
+        let Weight  = ResolveLuminance(Contrib);
+        if (Weight <= 1.0e-5)
+        {
+            continue;
+        }
+        WeightSum += Weight;
+        if (AdvanceUniform(Seed) * WeightSum < Weight)
+        {
+            SelectedContrib = Contrib;
+            SelectedDir     = LDir;
+            SelectedDist    = Dist;
+            SelectedWeight  = Weight;
+            SelectedEmissive = false;
+        }
+    }
+
+    // 4. The emissive clusters of the vertex's cell: EmissiveSamplesPerVertex independent point samples, each an unbiased estimate of ALL the emitters' share of the light
+    //    (the light technique's 1 − w_b), merged into the same resampling as the lights above so one shadow ray serves the lot. An estimate is random, so it carries its 1/pdf
+    //    in its contribution; the resampling identity holds for any realisation of the candidates.
+    if (AllowEmissive)
+    {
+        let Words = ResolveEmissiveCell(Position);
+        if (EmissiveUsable(Words))
+        {
+            for (var Sample = 0u; Sample < EmissiveSamplesPerVertex; Sample += 1u)
+            {
+                let Draw = vec4f(AdvanceUniform(Seed), AdvanceUniform(Seed), AdvanceUniform(Seed), AdvanceUniform(Seed));
+                let Emitter = SampleEmissiveLight(Position, Words, Draw);
+                if (!Emitter.Valid)
+                {
+                    continue;
+                }
+                let Toward = Emitter.Position - Position;
+                let Dist   = length(Toward);
+                let LDir   = Toward / max(Dist, 1.0e-4);
+                if (dot(Normal, LDir) <= 1.0e-4)
+                {
+                    continue;
+                }
+                let CosEmitter = abs(dot(Emitter.Normal, LDir));
+                let BsdfWeight = EvaluateEmissiveBsdfWeight(EvaluateBsdfPdf(Surface, Normal, View, LDir), Dist, CosEmitter);
+                let Scale      = CosEmitter * (1.0 - BsdfWeight) / (max(Dist * Dist, 1.0e-4) * max(Emitter.Pdf, 1.0e-8) * f32(EmissiveSamplesPerVertex));
+                let Contrib    = ResolveDirectReflectance(Surface, Normal, View, LDir) * Emitter.Radiance * Scale;
+                let Weight     = ResolveLuminance(Contrib);
+                if (!(Weight > 1.0e-5))
+                {
+                    continue;
+                }
+                WeightSum += Weight;
+                if (AdvanceUniform(Seed) * WeightSum < Weight)
+                {
+                    SelectedContrib  = Contrib;
+                    SelectedDir      = LDir;
+                    SelectedDist     = Dist;
+                    SelectedWeight   = Weight;
+                    SelectedEmissive = true;
+                }
+            }
+        }
+    }
+
+    if (SelectedWeight > 0.0)
+    {
+        var LightVis = 1.0;
+        if (TraceShadows || SelectedEmissive)
+        {
+            LightVis = TraceSceneVisibility(Origin, SelectedDir, RayEpsilon, max(SelectedDist - 0.08, RayEpsilon));
+        }
+        let RisWeight = WeightSum / SelectedWeight;
+        Direct += SelectedContrib * LightVis * RisWeight;
+    }
+
+    return Direct;
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                           MULTI-BOUNCE PATH TRACER
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📐 Traces a full multi-bounce path starting along (Origin, FirstDirection), returning the first bounce surface vertex
+//    x_s and the complete multi-bounce incoming radiance L_s gathered along the path for ReSTIR GI resampling.
+fn TraceMultiBouncePath(Origin: vec3f, PrimaryNormal: vec3f, FirstDirection: vec3f, Seed: ptr<function, u32>) -> ReservoirSample
+{
+    let Hit1 = TraceSceneRay(Origin, FirstDirection, RayEpsilon, 500.0);
+    if (!Hit1.Hit)
+    {
+        var SkySample : ReservoirSample;
+        SkySample.Position = Origin + FirstDirection * SkyReach;
+        SkySample.Normal   = -FirstDirection;
+        SkySample.Radiance = SampleSkyRadiance(FirstDirection);
+        SkySample.Identity = SkyIdentity;
+        return SkySample;
+    }
+
+    let Mat1  = RayMaterials[Hit1.Family];
+    let Surf1 = ProjectSurfaceSample(Mat1);
+
+    // Bounce 1 direct emission + Next-Event Estimation. The primary vertex x_v is where the cosine-sampled candidate starts: when the emitter structure covers it
+    // (DirectRadiance adds the light technique there) the emission this candidate finds at its first hit takes the BSDF technique's share of the partition, w_b with the
+    // cosine pdf the candidate was drawn with; elsewhere it counts in full, as it always did.
+    var EmissionWeight = 1.0;
+    let PrimaryPosition = Origin - PrimaryNormal * RayEpsilon;
+    if (IsListedEmitter(ResolveEmissiveCell(PrimaryPosition), Hit1.Identity, Hit1.Triangle))
+    {
+        EmissionWeight = EvaluateEmissiveBsdfWeight(max(dot(PrimaryNormal, FirstDirection), 0.0) * InversePi, length(Hit1.Position - PrimaryPosition),
+                                                    abs(dot(Hit1.Geometry, FirstDirection)));
+    }
+    var TotalRadiance = Surf1.Emission * Frame.EmissionScale * EmissionWeight;
+    TotalRadiance += EvaluateDirectNextEvent(Hit1.Position, Hit1.Normal, -FirstDirection, Surf1, Seed, true, true);
+    // 📝 The cell whose light technique the vertex the next BSDF sample leaves from has (it sampled the emitters in its own next-event estimation just above, or below for later
+    //    vertices); unusable where it had none.
+    var VertexWords = ResolveEmissiveCell(Hit1.Position);
+
+    let MaxBounces     = ResolveMaxBounces(Frame);
+    var PathThroughput = vec3f(1.0);
+    var CurrPos        = Hit1.Position;
+    var CurrNormal     = Hit1.Normal;
+    var CurrView       = -FirstDirection;
+    var CurrSurf       = Surf1;
+    var CurrIdentity   = Hit1.Identity;
+    var EscapedToSky   = false;
+
+    // Secondary & higher-order path bounces (bounce 2 .. MaxBounces)
+    for (var Bounce = 2u; Bounce <= MaxBounces; Bounce += 1u)
+    {
+        var NextDir    = CurrNormal;
+        var BounceThru = vec3f(0.0);
+        var BsdfPdf    = 1.0;
+        if (!SampleSurfaceBsdf(CurrSurf, CurrNormal, CurrView, Seed, &NextDir, &BounceThru, &BsdfPdf))
+        {
+            break;
+        }
+        PathThroughput *= BounceThru;
+
+        // Russian Roulette termination
+        if (FeatureEnabled(Frame, FeatureRussianRoulette) && Bounce >= 2u)
+        {
+            let Survival = clamp(max(PathThroughput.r, max(PathThroughput.g, PathThroughput.b)), 0.12, 0.95);
+            if (AdvanceUniform(Seed) > Survival)
+            {
+                break;
+            }
+            PathThroughput /= Survival;
+        }
+
+        let HitB = TraceSceneRay(CurrPos + CurrNormal * RayEpsilon, NextDir, RayEpsilon, 350.0);
+        if (!HitB.Hit)
+        {
+            TotalRadiance += PathThroughput * SampleSkyRadiance(NextDir);
+            EscapedToSky = true;
+            break;
+        }
+
+        let MatB  = RayMaterials[HitB.Family];
+        let SurfB = ProjectSurfaceSample(MatB);
+
+        // MIS weight on secondary emissive hits. Legacy (emissive lights off): the renderer's heuristic, which had no light technique to balance and lost energy. Emissive lights on:
+        // a table emitter seen from a vertex that sampled the emitters takes w_b (the light technique has 1 − w_b); everything else counts in full.
+        var MisWeight = 1.0;
+        if (!ExtendedEnabled(Frame, ExtendedEmissiveLights))
+        {
+            let DistSq   = max(HitB.Travel * HitB.Travel, 0.04);
+            let CosAtHit = max(dot(HitB.Normal, -NextDir), 0.05);
+            let GeomTerm = CosAtHit / DistSq;
+            MisWeight    = clamp((BsdfPdf * BsdfPdf) / max(BsdfPdf * BsdfPdf + GeomTerm * GeomTerm * 0.01, 1.0e-5), 0.15, 1.0);
+        }
+        else if (IsListedEmitter(VertexWords, HitB.Identity, HitB.Triangle))
+        {
+            MisWeight = EvaluateEmissiveBsdfWeight(BsdfPdf, length(HitB.Position - CurrPos), abs(dot(HitB.Geometry, -NextDir)));
+        }
+
+        TotalRadiance += PathThroughput * SurfB.Emission * Frame.EmissionScale * MisWeight;
+
+        VertexWords = EmissiveUnusable;
+        if (FeatureEnabled(Frame, FeatureMultiBounceNEE))
+        {
+            let DirectB = EvaluateDirectNextEvent(HitB.Position, HitB.Normal, -NextDir, SurfB, Seed, Bounce <= 2u, true);
+            TotalRadiance += PathThroughput * DirectB;
+            VertexWords = ResolveEmissiveCell(HitB.Position);
+        }
+
+        CurrPos      = HitB.Position;
+        CurrNormal   = HitB.Normal;
+        CurrView     = -NextDir;
+        CurrSurf     = SurfB;
+        CurrIdentity = HitB.Identity;
+    }
+
+    // Infinite-bounce radiosity cache tail beyond MaxBounces
+    if (!EscapedToSky && FeatureEnabled(Frame, FeatureCardRadiosity))
+    {
+        let TailClip = ResolveFinestClip(CurrPos, 1.0);
+        let CardTail = SampleCardRadiance(CurrPos, CurrNormal, CurrIdentity, ResolveCardTolerance(TailClip));
+        if (CardTail.w > 0.0)
+        {
+            TotalRadiance += PathThroughput * ResolveDiffuseAlbedo(CurrSurf) * InversePi * CardTail.rgb * 0.35;
+        }
+    }
+
+    // Firefly & boiling suppression clamp on individual path samples
+    if (FeatureEnabled(Frame, FeatureFireflyFilter))
+    {
+        let Lum = ResolveLuminance(TotalRadiance);
+        let MaxLum = 24.0;
+        if (Lum > MaxLum)
+        {
+            TotalRadiance *= MaxLum / Lum;
+        }
+    }
+
+    var OutSample : ReservoirSample;
+    OutSample.Position = Hit1.Position;
+    OutSample.Normal   = Hit1.Normal;
+    OutSample.Radiance = max(TotalRadiance, vec3f(0.0));
+    OutSample.Identity = Hit1.Identity;
+    return OutSample;
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                      MULTI-BOUNCE RAY-TRACED REFLECTIONS
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📐 Traces a chained multi-bounce specular / GGX-VNDF reflection path up to ResolveReflectionBounces(Frame) bounces
+//    through the TLAS/BLAS triangle hierarchy, shading each hit with emission, direct NEE (Sun + Fire + RIS IES lights
+//    with BVH shadow rays), indirect diffuse lighting, and recursive Fresnel reflection continuation.
+fn TraceMultiBounceReflection(
+    Origin           : vec3f,
+    FirstDirection   : vec3f,
+    PrimaryRoughness : f32,
+    Seed             : ptr<function, u32>
+) -> vec3f
+{
+    let MaxReflBounces   = ResolveReflectionBounces(Frame);
+    var TotalRadiance    = vec3f(0.0);
+    var Throughput       = vec3f(1.0);
+    var RayOrigin        = Origin;
+    var RayDir           = FirstDirection;
+    var CurrentRoughness = PrimaryRoughness;
+
+    for (var Bounce = 1u; Bounce <= MaxReflBounces; Bounce += 1u)
+    {
+        let Hit = TraceSceneRay(RayOrigin, RayDir, RayEpsilon, 500.0);
+        if (!Hit.Hit)
+        {
+            var SkyRad = SampleSkyRadiance(RayDir);
+            let SunCos = dot(RayDir, Frame.SunDirection);
+            if (CurrentRoughness < 0.22 && SunCos > 0.9994)
+            {
+                SkyRad += Frame.SunIlluminance * smoothstep(0.9994, 0.99995, SunCos) * 45.0;
+            }
+            TotalRadiance += Throughput * SkyRad;
+            break;
+        }
+
+        let HitSurf     = ProjectSurfaceSample(RayMaterials[Hit.Family]);
+        let ViewDir     = -RayDir;
+        var HitRadiance = HitSurf.Emission * Frame.EmissionScale;
+
+        // Direct Next-Event Estimation (Sun cone + Fire + RIS over 32 IES lights with exact BVH shadow rays)
+        HitRadiance += EvaluateDirectNextEvent(Hit.Position, Hit.Normal, ViewDir, HitSurf, Seed, Bounce <= 2u, false) * InversePi;
+
+        // Indirect diffuse illumination on the reflected surface so shadowed faces retain natural colour and depth
+        let DiffuseAlbedo = ResolveDiffuseAlbedo(HitSurf);
+        if (any(DiffuseAlbedo > vec3f(1.0e-3)))
+        {
+            var AmbientIrr = SampleSkyRadiance(Hit.Normal) * (0.28 + 0.28 * saturate(Hit.Normal.z));
+            if (FeatureEnabled(Frame, FeatureCardRadiosity))
+            {
+                let Clip = ResolveFinestClip(Hit.Position, 1.0);
+                let Card = SampleCardRadiance(Hit.Position, Hit.Normal, Hit.Identity, ResolveCardTolerance(Clip));
+                if (Card.w > 0.0)
+                {
+                    AmbientIrr = max(AmbientIrr, Card.rgb * InversePi);
+                }
+            }
+            HitRadiance += DiffuseAlbedo * AmbientIrr;
+        }
+
+        TotalRadiance += Throughput * HitRadiance;
+
+        if (Bounce >= MaxReflBounces)
+        {
+            break;
+        }
+
+        // Recursive specular / clearcoat Fresnel continuation for reflection bounce b + 1
+        let NoV          = max(dot(Hit.Normal, ViewDir), 1.0e-4);
+        let HitRoughness = select(HitSurf.Roughness, HitSurf.CoatRoughness, HitSurf.CoatWeight > 0.0);
+        let F0           = ResolveSpecularColour(HitSurf);
+        var SpecWeight   = ResolveFresnel(F0, NoV) * (1.0 - 0.55 * HitSurf.Roughness);
+        if (HitSurf.CoatWeight > 0.0)
+        {
+            let CoatF  = ResolveFresnel(vec3f(0.04), NoV).x * HitSurf.CoatWeight * (1.0 - 0.35 * HitSurf.CoatRoughness);
+            SpecWeight = SpecWeight * (1.0 - CoatF) + vec3f(CoatF);
+        }
+        Throughput *= SpecWeight;
+        if (max(Throughput.r, max(Throughput.g, Throughput.b)) < 0.015)
+        {
+            break;
+        }
+
+        let Basis         = ConstructTangentFrame(Hit.Normal);
+        let TangentView   = transpose(Basis) * ViewDir;
+        let Pair          = vec2f(AdvanceUniform(Seed), AdvanceUniform(Seed));
+        let CombinedRough = clamp(sqrt(CurrentRoughness * CurrentRoughness + HitRoughness * HitRoughness), 0.03, 1.0);
+        let Half          = Basis * ProjectVisibleNormal(TangentView, CombinedRough * CombinedRough, Pair);
+        var NextDir       = reflect(-ViewDir, Half);
+        if (dot(NextDir, Hit.Normal) <= 1.0e-4)
+        {
+            NextDir = reflect(-ViewDir, Hit.Normal);
+        }
+        if (dot(NextDir, Hit.Normal) <= 1.0e-4)
+        {
+            break;
+        }
+        RayOrigin        = Hit.Position + Hit.Normal * RayEpsilon;
+        RayDir           = NextDir;
+        CurrentRoughness = CombinedRough;
+    }
+
+    return min(TotalRadiance, vec3f(200.0));
+}
diff --git a/Experimental/FrontierEngine/Shader/ReflectionTraversal.wgsl b/Experimental/FrontierEngine/Shader/ReflectionTraversal.wgsl
new file mode 100644
index 0000000..5f78daf
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/ReflectionTraversal.wgsl
@@ -0,0 +1,120 @@
+//============================================================================================================================================
+//                                                         REFLECTIONTRAVERSAL.WGSL
+//============================================================================================================================================
+// 🧩 Glossy reflection rays: a GGX visible-normal sample per resampling pixel, traced across the screen, then the distance field.
+
+// 📝 The specular counterpart of the indirect candidate, traced the same two-part way: across the screen through the
+//    nearest-depth pyramid, then through the scene distance field from the last point the screen proved unoccluded.
+//    The ray reads the sample exitance where it lands and the sky where it escapes. Surfaces rougher than
+//    RoughnessCutoff are left to the resolve, which substitutes the diffuse irradiance there exactly as Lumen reuses
+//    its diffuse gather for rough reflections.
+
+//! include "CardSampling.wgsl"
+//! include "ScreenTraversal.wgsl"
+//! include "SurfaceReflectance.wgsl"
+//! include "PackingCodec.wgsl"
+//! include "DiscrepancySequence.wgsl"
+//! include "RayTraversal.wgsl"
+
+@group(0) @binding(1) var<storage, read> Materials : array<MaterialRecord>;
+@group(0) @binding(2) var SurfaceAttributes        : texture_2d<f32>;
+@group(0) @binding(3) var SurfaceDepth             : texture_depth_2d;
+@group(0) @binding(4) var ReflectionTarget         : texture_storage_2d<rgba16float, write>;
+
+const RoughnessCutoff : f32 = 0.5;
+
+@compute @workgroup_size(8, 8)
+fn TraverseReflection(@builtin(global_invocation_id) Invocation: vec3u)
+{
+    let TracePixel = Invocation.xy;
+    if (any(vec2f(TracePixel) >= Frame.TraceExtent))
+    {
+        return;
+    }
+    let ScreenPixel = min(vec2i(TracePixel * Frame.TraceScale), vec2i(Frame.ScreenExtent) - vec2i(1));
+    let Depth = textureLoad(SurfaceDepth, ScreenPixel, 0);
+    if (Depth <= 0.0)
+    {
+        textureStore(ReflectionTarget, vec2i(TracePixel), vec4f(0.0));
+        return;
+    }
+    let Attributes = textureLoad(SurfaceAttributes, ScreenPixel, 0);
+    let Surface = ProjectSurfaceSample(Materials[u32(Attributes.z + 0.5)]);
+    let Roughness = select(Surface.Roughness, Surface.CoatRoughness, Surface.CoatWeight > 0.0);
+    let UseRtReflections = FeatureEnabled(Frame, FeatureRayTracing) && FeatureEnabled(Frame, FeatureRayTracedReflections);
+    let Cutoff = select(RoughnessCutoff, ResolveReflectionRoughness(Frame), UseRtReflections);
+    if (Roughness > Cutoff)
+    {
+        textureStore(ReflectionTarget, vec2i(TracePixel), vec4f(0.0));
+        return;
+    }
+    let Position = ReconstructWorldPosition(vec2f(ScreenPixel) + 0.5, Depth);
+    let Normal = DecodeOctahedral(Attributes.xy);
+    let View = normalize(Frame.CameraPosition - Position);
+    let Frame3 = ConstructTangentFrame(Normal);
+    let TangentView = transpose(Frame3) * View;
+    let Pair = ProjectTemporalPair(TracePixel, Frame.FrameIndex, 29u);
+    let Half = Frame3 * ProjectVisibleNormal(TangentView, Roughness * Roughness, Pair);
+    var Direction = reflect(-View, Half);
+    if (dot(Direction, Normal) <= 0.0)
+    {
+        Direction = reflect(-View, Normal);
+    }
+
+    // 📝 Lumen's two-part trace: the screen first (nearest-depth walk, contact detail finer than any voxel or BVH leaf needs), then, where
+    //    the screen cannot settle the ray, the BVH multi-bounce tracer when the BVH renderer is active or the scene distance field resumed from the last point
+    //    the screen proved unoccluded.
+    let Bias = ResolveSurfaceBias(Position);
+    var Strike: ScreenHit;
+    if (ScreenConsumerEnabled(Frame, ExtendedScreenReflection))
+    {
+        Strike = TraverseScreenDepth(Position + Normal * ResolveScreenBias(ResolveViewDepth(Position)), Direction, 300.0, ScreenTraversalSteps);
+    }
+    var Radiance = vec3f(0.0);
+    if (Strike.Hit)
+    {
+        Radiance = ResolveStrikeRadiance(Strike);
+    }
+    else if (UseRtReflections)
+    {
+        var Seed = ConstructPixelSeed(TracePixel, Frame.FrameIndex, 41u);
+        Radiance = TraceMultiBounceReflection(Position + Normal * RayEpsilon, Direction, Roughness, &Seed);
+    }
+    else
+    {
+        // 📝 Multi-bounce SDF reflection loop: honours ResolveReflectionBounces(Frame) when SDF mode is selected.
+        let MaxReflBounces = ResolveReflectionBounces(Frame);
+        var RayOrigin      = Position + Normal * Bias;
+        var RayDir         = Direction;
+        var ResumeTravel   = max(0.5 * Bias, Strike.Travel - Bias);
+        var Throughput     = vec3f(1.0);
+        var CurRoughness   = Roughness;
+        for (var Bounce = 0u; Bounce < MaxReflBounces; Bounce++)
+        {
+            let Hit = TraverseSceneDistance(RayOrigin, RayDir, ResumeTravel, 300.0, CurRoughness * 0.05);
+            let BounceExitance = ResolveContinuedRadiance(Hit, RayDir);
+            if (!Hit.Hit)
+            {
+                Radiance += Throughput * BounceExitance;
+                break;
+            }
+            // Deposit diffuse / emissive surface-card exitance at this hit, then continue specularly if bounces remain.
+            let HitCos = max(dot(-RayDir, Hit.Normal), 0.0);
+            let F0     = vec3f(0.18);
+            let Fresnel = F0 + (vec3f(1.0) - F0) * pow(1.0 - HitCos, 5.0);
+            if (Bounce + 1u >= MaxReflBounces || CurRoughness > 0.45)
+            {
+                Radiance += Throughput * BounceExitance;
+                break;
+            }
+            Radiance += Throughput * (vec3f(1.0) - Fresnel) * BounceExitance;
+            Throughput *= Fresnel;
+            let NextBias = ResolveSurfaceBias(Hit.Position);
+            RayOrigin    = Hit.Position + Hit.Normal * NextBias;
+            RayDir       = reflect(RayDir, Hit.Normal);
+            ResumeTravel = 0.5 * NextBias;
+            CurRoughness = min(1.0, CurRoughness + 0.14);
+        }
+    }
+    textureStore(ReflectionTarget, vec2i(TracePixel), vec4f(min(Radiance, vec3f(200.0)), 1.0));
+}
diff --git a/Experimental/FrontierEngine/Shader/ReservoirRecords.wgsl b/Experimental/FrontierEngine/Shader/ReservoirRecords.wgsl
new file mode 100644
index 0000000..a999b1c
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/ReservoirRecords.wgsl
@@ -0,0 +1,105 @@
+//============================================================================================================================================
+//                                                          RESERVOIRRECORDS.WGSL
+//============================================================================================================================================
+// 🧩 ReSTIR GI reservoirs (Ouyang et al. 2021): the reconnection vertex, its radiance, W and M, and weighted merging.
+
+// 📝 A sample is the secondary vertex a cosine ray from a primary surface reached in the scene distance field: its
+//    position, its distance-field normal, the card radiance it sends back and the occupant it belongs to. A ray that
+//    escaped stores its direction pushed far away and SkyIdentity, and is treated directionally under every shift.
+//
+//    32 bytes per reservoir: position 12, packed normal 4, packed half radiance + identity 8, W 4, M 4.
+
+//! include "PackingCodec.wgsl"
+//! include "DistanceRecords.wgsl"
+
+struct ReservoirRecord
+{
+    SamplePosition : vec3f,   // [m]   reconnection vertex x_s
+    SampleNormal   : u32,     // [-]   octahedral n_s
+    Radiance       : vec2u,   // [-]   half rgb radiance, identity in the fourth half
+    Weight         : f32,     // [-]   unbiased contribution weight W
+    Tally          : f32,     // [-]   M
+}
+
+struct ReservoirSample
+{
+    Position : vec3f,
+    Normal   : vec3f,
+    Radiance : vec3f,
+    Identity : u32,
+}
+
+struct Reservoir
+{
+    Sample    : ReservoirSample,
+    WeightSum : f32,
+    Tally     : f32,
+    Weight    : f32,
+    Adopted   : bool,   // the selected sample came from another pixel's reservoir
+}
+
+const SkyReach : f32 = 10000.0;   // [m] - how far an escaped direction is pushed to become a position
+
+fn ConstructEmptyReservoir() -> Reservoir
+{
+    var Empty: Reservoir;
+    Empty.Sample.Position = vec3f(0.0);
+    Empty.Sample.Normal   = vec3f(0.0, 0.0, 1.0);
+    Empty.Sample.Radiance = vec3f(0.0);
+    Empty.Sample.Identity = SkyIdentity;
+    Empty.WeightSum = 0.0;
+    Empty.Tally     = 0.0;
+    Empty.Weight    = 0.0;
+    Empty.Adopted   = false;
+    return Empty;
+}
+
+fn PackReservoir(Source: Reservoir) -> ReservoirRecord
+{
+    var Record: ReservoirRecord;
+    Record.SamplePosition = Source.Sample.Position;
+    Record.SampleNormal   = PackOctahedral(Source.Sample.Normal);
+    Record.Radiance       = PackHalfTriple(min(Source.Sample.Radiance, vec3f(60000.0)), f32(Source.Sample.Identity));
+    Record.Weight         = Source.Weight;
+    Record.Tally          = Source.Tally;
+    return Record;
+}
+
+fn UnpackReservoir(Record: ReservoirRecord) -> Reservoir
+{
+    var Result = ConstructEmptyReservoir();
+    let Radiance = UnpackHalfTriple(Record.Radiance);
+    Result.Sample.Position = Record.SamplePosition;
+    Result.Sample.Normal   = UnpackOctahedral(Record.SampleNormal);
+    Result.Sample.Radiance = Radiance.rgb;
+    Result.Sample.Identity = u32(Radiance.w + 0.5);
+    Result.Weight = Record.Weight;
+    Result.Tally  = Record.Tally;
+    return Result;
+}
+
+// 📐 Weighted reservoir sampling: accumulate w into Σw and M into the tally, keep the candidate with probability w/Σw.
+fn MergeReservoir(Target: ptr<function, Reservoir>, Candidate: ReservoirSample, Weight: f32, Tally: f32, Random: f32) -> bool
+{
+    (*Target).WeightSum += Weight;
+    (*Target).Tally     += Tally;
+    if (Weight > 0.0 && Random * (*Target).WeightSum < Weight)
+    {
+        (*Target).Sample = Candidate;
+        return true;
+    }
+    return false;
+}
+
+fn ResolveSampleDirection(Sample: ReservoirSample, Position: vec3f) -> vec3f
+{
+    return normalize(Sample.Position - Position);
+}
+
+// 📐 Target function p̂(y) = luminance(L(y)) · max(0, n_v · ω) at the shading point (x_v, n_v): the integrand of the
+//    irradiance without the visibility term, which the reuse passes test explicitly where they need it.
+fn ResolveReservoirTarget(Sample: ReservoirSample, Position: vec3f, Normal: vec3f) -> f32
+{
+    let Cosine = dot(Normal, ResolveSampleDirection(Sample, Position));
+    return select(0.0, ResolveLuminance(Sample.Radiance) * Cosine, Cosine > 0.0);
+}
diff --git a/Experimental/FrontierEngine/Shader/ReservoirSpatial.wgsl b/Experimental/FrontierEngine/Shader/ReservoirSpatial.wgsl
new file mode 100644
index 0000000..be6c589
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/ReservoirSpatial.wgsl
@@ -0,0 +1,176 @@
+//============================================================================================================================================
+//                                                          RESERVOIRSPATIAL.WGSL
+//============================================================================================================================================
+// 🧩 ReSTIR GI spatial reuse with the reconnection-shift Jacobian, 1/Z bias correction, a visibility test, and the resolve.
+
+// 📝 Per resampling pixel r with primary surface (x_v, n_v):
+//    ① its own temporal reservoir seeds the spatial reservoir;
+//    ② SpatialCount nearby reservoirs q are proposed in a disk; a proposal is refused unless its surface agrees in
+//       normal and depth. Its sample y = (x_s, n_s, L) is reconnected to x_v, so its weight carries the solid-angle
+//       Jacobian |∂ω_r/∂ω_q| = (cos φ_r / cos φ_q)·(‖x_q − x_s‖² / ‖x_v − x_s‖²); escaped samples are directional
+//       and carry 1. Extreme Jacobians are refused rather than clamped;
+//    ③ Z sums the tallies of every domain whose own surface sees the chosen y above its horizon, so W = Σw/(Z·p̂(y));
+//    ④ an adopted y is traced for visibility from x_v and, if occluded, the pixel falls back to its own reservoir;
+//    ⑤ resolve: E = L(y) · max(0, n_v·ω_y) · W, the demodulated irradiance the variance integrator receives.
+
+//! include "CardSampling.wgsl"
+//! include "ReservoirRecords.wgsl"
+//! include "DiscrepancySequence.wgsl"
+//! include "RayTraversal.wgsl"
+
+@group(0) @binding(1) var Guide                            : texture_2d<f32>;
+@group(0) @binding(2) var SurfaceDepth                     : texture_depth_2d;
+@group(0) @binding(3) var<storage, read> CurrentReservoirs : array<ReservoirRecord>;
+@group(0) @binding(4) var IrradianceTarget                 : texture_storage_2d<rgba16float, write>;
+
+const ProposalCapacity : u32 = 8u;
+
+fn ResolveTracePosition(TracePixel: vec2i) -> vec3f
+{
+    let ScreenPixel = min(TracePixel * i32(Frame.TraceScale), vec2i(Frame.ScreenExtent) - vec2i(1));
+    return ReconstructWorldPosition(vec2f(ScreenPixel) + 0.5, textureLoad(SurfaceDepth, ScreenPixel, 0));
+}
+
+fn ResolveReconnectionJacobian(Sample: ReservoirSample, Receiver: vec3f, Donor: vec3f) -> f32
+{
+    if (Sample.Identity == SkyIdentity)
+    {
+        return 1.0;
+    }
+    let ToDonor    = Donor - Sample.Position;
+    let ToReceiver = Receiver - Sample.Position;
+    let DonorSquared    = max(dot(ToDonor, ToDonor), 1.0e-6);
+    let ReceiverSquared = max(dot(ToReceiver, ToReceiver), 1.0e-6);
+    let CosineDonor    = abs(dot(Sample.Normal, ToDonor)) * inverseSqrt(DonorSquared);
+    let CosineReceiver = abs(dot(Sample.Normal, ToReceiver)) * inverseSqrt(ReceiverSquared);
+    return (CosineReceiver / max(CosineDonor, 1.0e-4)) * (DonorSquared / ReceiverSquared);
+}
+
+@compute @workgroup_size(8, 8)
+fn ResampleSpatial(@builtin(global_invocation_id) Invocation: vec3u)
+{
+    let TracePixel = vec2i(Invocation.xy);
+    let Extent = vec2i(Frame.TraceExtent);
+    if (any(TracePixel >= Extent))
+    {
+        return;
+    }
+    let GuideTexel = textureLoad(Guide, TracePixel, 0);
+    if (GuideTexel.w < 0.5)
+    {
+        textureStore(IrradianceTarget, TracePixel, vec4f(0.0));
+        return;
+    }
+    let Normal    = DecodeOctahedral(GuideTexel.xy);
+    let ViewDepth = GuideTexel.z;
+    let Position  = ResolveTracePosition(TracePixel);
+    var Seed = ConstructPixelSeed(vec2u(TracePixel), Frame.FrameIndex, 23u);
+
+    // ① own reservoir
+    let Own = UnpackReservoir(CurrentReservoirs[u32(TracePixel.y * Extent.x + TracePixel.x)]);
+    var Spatial = ConstructEmptyReservoir();
+    MergeReservoir(&Spatial, Own.Sample, ResolveReservoirTarget(Own.Sample, Position, Normal) * Own.Weight * Own.Tally, Own.Tally,
+                   AdvanceUniform(&Seed));
+
+    // ② proposals
+    var DonorPositions : array<vec3f, 8>;
+    var DonorNormals   : array<vec3f, 8>;
+    var DonorTallies   : array<f32, 8>;
+    var DonorCount = 0u;
+    if (FeatureEnabled(Frame, FeatureSpatialReuse))
+    {
+        let Count = min(Frame.SpatialCount, ProposalCapacity);
+        for (var Proposal = 0u; Proposal < Count; Proposal++)
+        {
+            let Offset = ProjectUniformDisk(vec2f(AdvanceUniform(&Seed), AdvanceUniform(&Seed))) * Frame.SpatialRadius;
+            let Donor = clamp(TracePixel + vec2i(round(Offset)), vec2i(0), Extent - vec2i(1));
+            if (all(Donor == TracePixel))
+            {
+                continue;
+            }
+            let DonorGuide = textureLoad(Guide, Donor, 0);
+            let DonorNormal = DecodeOctahedral(DonorGuide.xy);
+            if (DonorGuide.w < 0.5 || dot(DonorNormal, Normal) < 0.9 || abs(DonorGuide.z - ViewDepth) > 0.1 * ViewDepth)
+            {
+                continue;
+            }
+            let Reservoir = UnpackReservoir(CurrentReservoirs[u32(Donor.y * Extent.x + Donor.x)]);
+            if (Reservoir.Tally <= 0.0 || Reservoir.Weight <= 0.0)
+            {
+                continue;
+            }
+            let DonorPosition = ResolveTracePosition(Donor);
+            if (abs(dot(DonorPosition - Position, Normal)) > 0.08 * max(ViewDepth, 0.5))
+            {
+                continue;
+            }
+            let Jacobian = ResolveReconnectionJacobian(Reservoir.Sample, Position, DonorPosition);
+            let MaxJac   = select(8.0, 5.0, FeatureEnabled(Frame, FeatureFireflyFilter));
+            if (Jacobian > MaxJac || Jacobian < (1.0 / MaxJac) || Jacobian != Jacobian)
+            {
+                continue;
+            }
+            let Target = ResolveReservoirTarget(Reservoir.Sample, Position, Normal);
+            if (MergeReservoir(&Spatial, Reservoir.Sample, Target * Reservoir.Weight * Reservoir.Tally * Jacobian, Reservoir.Tally,
+                               AdvanceUniform(&Seed)))
+            {
+                Spatial.Adopted = true;
+            }
+            DonorPositions[DonorCount] = DonorPosition;
+            DonorNormals[DonorCount]   = DonorNormal;
+            DonorTallies[DonorCount]   = Reservoir.Tally;
+            DonorCount++;
+        }
+    }
+
+    // ④ visibility of an adopted sample from this surface
+    if (Spatial.Adopted && FeatureEnabled(Frame, FeatureVisibilityReuse))
+    {
+        let Toward  = Spatial.Sample.Position - Position;
+        let Length  = length(Toward);
+        var Visible = 1.0;
+        if (FeatureEnabled(Frame, FeatureRayTracing))
+        {
+            let Reach = select(Length - 3.0 * RayEpsilon, 400.0, Spatial.Sample.Identity == SkyIdentity);
+            Visible   = TraceSceneVisibility(Position + Normal * RayEpsilon, Toward / max(Length, 1.0e-4), RayEpsilon, max(Reach, 0.0));
+        }
+        else
+        {
+            let Bias  = ResolveSurfaceBias(Position);
+            let Reach = select(Length - 2.0 * ResolveSurfaceBias(Spatial.Sample.Position), 300.0, Spatial.Sample.Identity == SkyIdentity);
+            Visible   = TraverseSceneVisibility(Position + Normal * Bias, Toward / max(Length, 1.0e-4), 0.5 * Bias, max(Reach, 0.0));
+        }
+        if (Visible < 0.5)
+        {
+            Spatial = Own;
+            Spatial.WeightSum = ResolveReservoirTarget(Own.Sample, Position, Normal) * Own.Weight * Own.Tally;
+            Spatial.Adopted = false;
+            DonorCount = 0u;
+        }
+    }
+
+    // ③ 1/Z bias correction over the domains that could have produced y
+    let Chosen = Spatial.Sample;
+    var Z = select(0.0, Own.Tally, ResolveReservoirTarget(Chosen, Position, Normal) > 0.0);
+    for (var Donor = 0u; Donor < DonorCount; Donor++)
+    {
+        if (ResolveReservoirTarget(Chosen, DonorPositions[Donor], DonorNormals[Donor]) > 0.0)
+        {
+            Z += DonorTallies[Donor];
+        }
+    }
+    let Target = ResolveReservoirTarget(Chosen, Position, Normal);
+    let Weight = select(0.0, Spatial.WeightSum / (Z * Target), Target > 0.0 && Z > 0.0);
+
+    // ⑤ resolve the demodulated irradiance
+    let Cosine = max(dot(Normal, ResolveSampleDirection(Chosen, Position)), 0.0);
+    var Irradiance = Chosen.Radiance * Cosine * Weight;
+    let Luminance  = ResolveLuminance(Irradiance);
+    let ClampScale = select(40.0, 22.0, FeatureEnabled(Frame, FeatureFireflyFilter));
+    let Limit      = ClampScale * max(ResolveLuminance(Frame.SunIlluminance), 0.5);
+    if (Luminance > Limit)
+    {
+        Irradiance *= Limit / Luminance;
+    }
+    textureStore(IrradianceTarget, TracePixel, vec4f(Irradiance, 1.0));
+}
diff --git a/Experimental/FrontierEngine/Shader/ReservoirTemporal.wgsl b/Experimental/FrontierEngine/Shader/ReservoirTemporal.wgsl
new file mode 100644
index 0000000..86150a8
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/ReservoirTemporal.wgsl
@@ -0,0 +1,244 @@
+//============================================================================================================================================
+//                                                          RESERVOIRTEMPORAL.WGSL
+//============================================================================================================================================
+// 🧩 ReSTIR GI initial candidate and temporal reuse: a cosine ray (screen, then scene distance field), then the prior reservoir.
+
+// 📝 Per resampling pixel:
+//    ① the primary surface (x_v, n_v) is read from the surface projection and written to this frame's guide;
+//    ② one cosine-weighted ray is traced — first across the screen through the nearest-depth pyramid, then, where the
+//       screen cannot settle it, through the ONE scene distance field from the last point the screen proved unoccluded;
+//       its radiance is the sample exitance at the hit (or the sky on an escape) — this is the candidate, with source
+//       pdf cosθ/π whichever tracer answered;
+//    ③ the prior frame's reservoir is found by motion reprojection and validated against the prior guide; its
+//       reconnection vertex is carried with its occupant's motion, its radiance re-resolved by the same exitance rule, and
+//       (on a rotating quarter of pixels) its visibility re-traced, so a vehicle driving between x_v and x_s darkens
+//       the reuse instead of leaving a ghost; M is clamped to TemporalTallyLimit;
+//    ④ W = Σw / (M · p̂(y)) is stored for the spatial pass and for the next frame.
+
+//! include "CardSampling.wgsl"
+//! include "ScreenTraversal.wgsl"
+//! include "ReservoirRecords.wgsl"
+//! include "DiscrepancySequence.wgsl"
+//! include "RayTraversal.wgsl"
+
+@group(0) @binding(1) var SurfaceAttributes                   : texture_2d<f32>;
+@group(0) @binding(2) var SurfaceDepth                        : texture_depth_2d;
+@group(0) @binding(3) var SurfaceMotion                       : texture_2d<f32>;
+@group(0) @binding(4) var PreviousGuide                       : texture_2d<f32>;
+@group(0) @binding(5) var GuideTarget                         : texture_storage_2d<rgba16float, write>;
+@group(0) @binding(6) var<storage, read> PreviousReservoirs   : array<ReservoirRecord>;
+@group(0) @binding(7) var<storage, read_write> CurrentReservoirs : array<ReservoirRecord>;
+
+const DiffuseConeSlope : f32 = 0.006;
+
+fn ResolveScreenPixel(TracePixel: vec2u) -> vec2i
+{
+    return min(vec2i(TracePixel * Frame.TraceScale), vec2i(Frame.ScreenExtent) - vec2i(1));
+}
+
+// 📝 Carries a reconnection vertex that lies on a moving occupant from where it was last frame to where it is now.
+fn CarryReservoirSample(Sample: ReservoirSample) -> ReservoirSample
+{
+    var Carried = Sample;
+    if (Sample.Identity < arrayLength(&Occupants))
+    {
+        let Occupant = Occupants[Sample.Identity];
+        if ((Occupant.Roles & RoleDynamic) != 0u)
+        {
+            let Local = Occupant.PreviousWorldToLocal * vec4f(Sample.Position, 1.0);
+            Carried.Position = (Occupant.LocalToWorld * Local).xyz;
+            let LocalNormal = (Occupant.PreviousWorldToLocal * vec4f(Sample.Normal, 0.0)).xyz;
+            Carried.Normal = normalize((Occupant.LocalToWorld * vec4f(LocalNormal, 0.0)).xyz);
+        }
+    }
+    return Carried;
+}
+
+fn RefreshSampleRadiance(Sample: ReservoirSample) -> vec3f
+{
+    if (Sample.Identity == SkyIdentity)
+    {
+        return SampleSkyRadiance(-Sample.Normal);
+    }
+    if (FeatureEnabled(Frame, FeatureRayTracing))
+    {
+        return Sample.Radiance;
+    }
+    let Level = ResolveFinestClip(Sample.Position, 1.0);
+    let Exitance = ResolveSampleExitance(Sample.Position, Sample.Normal, Sample.Identity, ResolveCardTolerance(Level));
+    return select(Sample.Radiance, Exitance.rgb, Exitance.w > 0.0);
+}
+
+@compute @workgroup_size(8, 8)
+fn ResampleTemporal(@builtin(global_invocation_id) Invocation: vec3u)
+{
+    let TracePixel = Invocation.xy;
+    let Extent = vec2u(Frame.TraceExtent);
+    if (any(TracePixel >= Extent))
+    {
+        return;
+    }
+    let Index = TracePixel.y * Extent.x + TracePixel.x;
+    let ScreenPixel = ResolveScreenPixel(TracePixel);
+    let Depth = textureLoad(SurfaceDepth, ScreenPixel, 0);
+    if (Depth <= 0.0)
+    {
+        textureStore(GuideTarget, vec2i(TracePixel), vec4f(0.0));
+        CurrentReservoirs[Index] = PackReservoir(ConstructEmptyReservoir());
+        return;
+    }
+
+    // ① primary surface
+    let Position  = ReconstructWorldPosition(vec2f(ScreenPixel) + 0.5, Depth);
+    let Normal    = DecodeOctahedral(textureLoad(SurfaceAttributes, ScreenPixel, 0).xy);
+    let ViewDepth = ResolveViewDepth(Position);
+    let ExpectedDepth = ResolvePriorViewDepth(Position);
+    // 📝 Guide: octahedral normal, view depth, and 1 + the depth this point had last frame (w ≥ 1 marks valid).
+    textureStore(GuideTarget, vec2i(TracePixel), vec4f(EncodeOctahedral(Normal), ViewDepth, 1.0 + ExpectedDepth));
+    var Seed = ConstructPixelSeed(TracePixel, Frame.FrameIndex, 11u);
+
+    // ② initial candidates: per candidate the screen first (nearest-depth walk), then the BVH path tracer (BVH renderer) or the scene
+    //    distance field in SDF mode, resumed from the last point the screen proved unoccluded
+    let Bias         = ResolveSurfaceBias(Position);
+    let Basis        = ConstructTangentFrame(Normal);
+    let UseRayTrace  = FeatureEnabled(Frame, FeatureRayTracing);
+    let InitialCount = select(1u, ResolveInitialCandidates(Frame), UseRayTrace);
+    var Current      = ConstructEmptyReservoir();
+
+    for (var CandIdx = 0u; CandIdx < InitialCount; CandIdx += 1u)
+    {
+        let Pair      = ProjectTemporalPair(TracePixel, Frame.FrameIndex + CandIdx * 37u, 3u + CandIdx * 2u);
+        let Direction = Basis * ProjectCosineHemisphere(Pair);
+        var Strike: ScreenHit;
+        if (ScreenConsumerEnabled(Frame, ExtendedScreenIndirect))
+        {
+            Strike = TraverseScreenDepth(Position + Normal * ResolveScreenBias(ViewDepth), Direction, 300.0, ScreenTraversalSteps);
+        }
+        // 📝 A screen strike on an emitter the table represents would count its emission in full while DirectRadiance's light sample already supplies the light technique's
+        //    share: let that ray take the BVH path, whose first-hit weight is the BSDF technique's share of the partition.
+        if (Strike.Hit && UseRayTrace && IsListedOccupant(ResolveEmissiveCell(Position), Strike.Identity))
+        {
+            Strike.Hit = false;
+        }
+        var Candidate : ReservoirSample;
+        if (Strike.Hit)
+        {
+            Candidate.Position = Strike.Position;
+            Candidate.Normal   = Strike.Normal;
+            Candidate.Identity = Strike.Identity;
+            Candidate.Radiance = ResolveStrikeRadiance(Strike);
+        }
+        else if (UseRayTrace)
+        {
+            Candidate = TraceMultiBouncePath(Position + Normal * RayEpsilon, Normal, Direction, &Seed);
+        }
+        else
+        {
+            // 📝 Backed off by one bias so a surface the screen saw the ray reach is still found by the distance field.
+            let Resume = max(0.5 * Bias, Strike.Travel - Bias);
+            let Hit = TraverseSceneDistance(Position + Normal * Bias, Direction, Resume, 300.0, DiffuseConeSlope);
+            if (Hit.Hit)
+            {
+                Candidate.Position = Hit.Position;
+                Candidate.Normal   = Hit.Normal;
+                Candidate.Identity = Hit.Identity;
+                var Gathered       = ResolveContinuedRadiance(Hit, Direction);
+                // 📝 Multi-bounce SDF GI continuation when MaxBounces > 1 in SDF mode.
+                let MaxGiBounces   = ResolveMaxBounces(Frame);
+                var BouncePos      = Hit.Position;
+                var BounceNormal   = Hit.Normal;
+                var BounceWeight   = 0.45;
+                for (var GiBounce = 1u; GiBounce < MaxGiBounces; GiBounce++)
+                {
+                    let BouncePair = vec2f(AdvanceUniform(&Seed), AdvanceUniform(&Seed));
+                    let BounceDir  = ConstructTangentFrame(BounceNormal) * ProjectCosineHemisphere(BouncePair);
+                    let BounceBias = ResolveSurfaceBias(BouncePos);
+                    let NextHit    = TraverseSceneDistance(BouncePos + BounceNormal * BounceBias, BounceDir, 0.5 * BounceBias, 120.0, DiffuseConeSlope * 2.0);
+                    if (!NextHit.Hit)
+                    {
+                        Gathered += BounceWeight * SampleSkyRadiance(BounceDir);
+                        break;
+                    }
+                    Gathered += BounceWeight * ResolveContinuedRadiance(NextHit, BounceDir);
+                    BouncePos    = NextHit.Position;
+                    BounceNormal = NextHit.Normal;
+                    BounceWeight *= 0.42;
+                }
+                Candidate.Radiance = Gathered;
+            }
+            else
+            {
+                Candidate.Position = Position + Direction * SkyReach;
+                Candidate.Normal   = -Direction;
+                Candidate.Identity = SkyIdentity;
+                Candidate.Radiance = SampleSkyRadiance(Direction);
+            }
+        }
+        let Cosine        = max(dot(Normal, Direction), 0.0);
+        let SourcePdf     = Cosine * InversePi;
+        let InitialWeight = select(0.0, ResolveLuminance(Candidate.Radiance) * Cosine / SourcePdf, SourcePdf > 1.0e-6);
+        MergeReservoir(&Current, Candidate, InitialWeight, 1.0, AdvanceUniform(&Seed));
+    }
+
+    if (InitialCount > 1u && Current.Tally > 0.0)
+    {
+        let InitTarget    = ResolveReservoirTarget(Current.Sample, Position, Normal);
+        let InitW         = select(0.0, Current.WeightSum / (Current.Tally * InitTarget), InitTarget > 0.0);
+        Current.WeightSum = InitTarget * InitW;
+        Current.Weight    = InitW;
+        Current.Tally     = 1.0;
+    }
+
+    // ③ temporal reuse
+    if (FeatureEnabled(Frame, FeatureTemporalReuse))
+    {
+        let Motion = textureLoad(SurfaceMotion, ScreenPixel, 0).xy;
+        let PriorScreen = vec2f(ScreenPixel) + 0.5 - Motion;
+        let PriorTrace = vec2i(floor((PriorScreen - 0.5) / f32(Frame.TraceScale) + 0.5));
+        if (all(PriorTrace >= vec2i(0)) && all(PriorTrace < vec2i(Extent)))
+        {
+            let PriorGuide = textureLoad(PreviousGuide, PriorTrace, 0);
+            let PriorNormal = DecodeOctahedral(PriorGuide.xy);
+            let Similar = PriorGuide.w > 0.5 && dot(PriorNormal, Normal) > 0.85
+                        && ClassifyPriorDepth(PriorGuide.z, ExpectedDepth, ViewDepth);
+            if (Similar)
+            {
+                var Prior = UnpackReservoir(PreviousReservoirs[u32(PriorTrace.y) * Extent.x + u32(PriorTrace.x)]);
+                if (Prior.Tally > 0.0)
+                {
+                    var Reused = CarryReservoirSample(Prior.Sample);
+                    if (FeatureEnabled(Frame, FeatureRadianceRefresh))
+                    {
+                        Reused.Radiance = RefreshSampleRadiance(Reused);
+                    }
+                    var Target = ResolveReservoirTarget(Reused, Position, Normal);
+                    let Validate = ((TracePixel.x + TracePixel.y * 3u + Frame.FrameIndex) & 3u) == 0u;
+                    if (FeatureEnabled(Frame, FeatureVisibilityReuse) && Validate && Target > 0.0)
+                    {
+                        let Toward = Reused.Position - Position;
+                        let Length = length(Toward);
+                        var Visible = 1.0;
+                        if (UseRayTrace)
+                        {
+                            let Reach = select(Length - 3.0 * RayEpsilon, 400.0, Reused.Identity == SkyIdentity);
+                            Visible   = TraceSceneVisibility(Position + Normal * RayEpsilon, Toward / max(Length, 1.0e-4), RayEpsilon, max(Reach, 0.0));
+                        }
+                        else
+                        {
+                            let Reach = select(Length - 2.0 * ResolveSurfaceBias(Reused.Position), 300.0, Reused.Identity == SkyIdentity);
+                            Visible   = TraverseSceneVisibility(Position + Normal * Bias, Toward / max(Length, 1.0e-4), 0.5 * Bias, max(Reach, 0.0));
+                        }
+                        Target *= Visible;
+                    }
+                    let Tally = min(Prior.Tally, Frame.TemporalTallyLimit);
+                    MergeReservoir(&Current, Reused, Target * Prior.Weight * Tally, Tally, AdvanceUniform(&Seed));
+                }
+            }
+        }
+    }
+
+    // ④ unbiased contribution weight
+    let Selected = ResolveReservoirTarget(Current.Sample, Position, Normal);
+    Current.Weight = select(0.0, Current.WeightSum / (Current.Tally * Selected), Selected > 0.0 && Current.Tally > 0.0);
+    CurrentReservoirs[Index] = PackReservoir(Current);
+}
diff --git a/Experimental/FrontierEngine/Shader/SceneRecords.wgsl b/Experimental/FrontierEngine/Shader/SceneRecords.wgsl
new file mode 100644
index 0000000..f175d85
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/SceneRecords.wgsl
@@ -0,0 +1,223 @@
+//============================================================================================================================================
+//                                                            SCENERECORDS.WGSL
+//============================================================================================================================================
+// 🧩 Record layouts shared by every program — frame, occupant, surface card and material — matching the host encoders.
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                     FRAME RECORD
+//------------------------------------------------------------------------------------------------------------------------
+
+
+
+struct FrameRecord
+{
+    ViewProjection                   : mat4x4f,   // [-]    jittered, this frame
+    InverseViewProjection            : mat4x4f,   // [-]    inverse of the jittered projection
+    UnjitteredViewProjection         : mat4x4f,   // [-]    this frame, no sub-pixel offset
+    PreviousUnjitteredViewProjection : mat4x4f,   // [-]    previous frame, no sub-pixel offset
+    View                             : mat4x4f,   // [-]    world → view
+    CameraPosition                   : vec3f,     // [m]
+    FrameIndex                       : u32,       // [-]    monotonic since bring-up
+    SunDirection                     : vec3f,     // [-]    unit, toward the light
+    ElapsedSeconds                   : f32,       // [s]
+    SunIlluminance                   : vec3f,     // [lx·k] after atmospheric transmittance
+    SkyScale                         : f32,       // [-]    multiplies the sky-view radiance
+    ScreenExtent                     : vec2f,     // [px]
+    InverseScreenExtent              : vec2f,     // [1/px]
+    TraceExtent                      : vec2f,     // [px]   resampling resolution
+    InverseTraceExtent               : vec2f,     // [1/px]
+    Jitter                           : vec2f,     // [ndc]  sub-pixel offset folded into ViewProjection
+    TraceScale                       : u32,       // [-]    screen pixels per resampling pixel along one axis
+    Features                         : u32,       // [-]    FeatureBit mask
+    InspectionMode                   : u32,       // [-]    display inspection selector
+    TemporalTallyLimit               : f32,       // [-]    M clamp for temporal reuse
+    SpatialRadius                    : f32,       // [px]   resampling-space radius of spatial reuse
+    SpatialCount                     : u32,       // [-]    spatial candidates per pixel
+    NightSkyRadiance                 : vec3f,     // [-]    floor radiance of the night sky
+    EmissionScale                    : f32,       // [-]    multiplies every authored emission
+    SliceHeight                      : f32,       // [m]    inspection slice through the distance field
+    ExposureCompensation             : f32,       // [EV]
+    IndirectScale                    : f32,       // [-]    multiplies the resolved indirect term
+    DistanceInspection               : u32,       // [-]    distance inspection selector
+    FocusPosition                    : vec3f,     // [m]    centre of the scene distance field cascades
+    InsetEnabled                     : u32,       // [-]    draw the distance slice inset
+    FireLightPosition                : vec3f,     // [m]    power-weighted centre of the burning tyres
+    FireLightIntensity               : f32,       // [-]    point intensity; 0 when nothing burns
+    FireLightColour                  : vec3f,     // [-]    chromaticity of the flame light
+    FireLightReach                   : f32,       // [m]    influence radius
+    CameraNear                       : f32,       // [m]    near plane of the reversed infinite projection; device depth = CameraNear / view depth
+    Features2                        : u32,       // [-]    ExtendedFeature mask (screen traces, light grid, emissive lights)
+}
+
+// 📝 FeatureBit — the toggles the control panel exposes, read by the programs that honour them.
+const FeatureIndirect          : u32 = 1u;
+const FeatureTemporalReuse     : u32 = 2u;
+const FeatureSpatialReuse      : u32 = 4u;
+const FeatureVisibilityReuse   : u32 = 8u;
+const FeatureVarianceKernel    : u32 = 16u;
+const FeatureReflection        : u32 = 32u;
+const FeatureCardRadiosity     : u32 = 64u;
+const FeatureTemporalAntialias : u32 = 128u;
+const FeatureDirectShadow      : u32 = 256u;
+const FeatureAutoExposure      : u32 = 512u;
+const FeatureRadianceRefresh   : u32 = 1024u;
+const FeatureTemporalRestart   : u32 = 2048u;   // [-] set for one frame: every temporal history restarts
+const FeatureSmokeComposite    : u32 = 4096u;   // [-] smoke and plume composited over the recombined radiance
+const FeatureRayTracing        : u32 = 8192u;   // [-] software BVH (TLAS/BLAS) multi-bounce ReSTIR path tracer
+const FeatureRayTracedShadows  : u32 = 16384u;  // [-] exact BVH visibility for solar cone & clustered IES lights
+const FeatureRussianRoulette      : u32 = 32768u;  // [-] throughput-weighted Russian roulette termination
+const FeatureFireflyFilter        : u32 = 65536u;  // [-] Jacobian & variance firefly/boiling suppression
+const FeatureMultiBounceNEE       : u32 = 131072u; // [-] Next-Event Estimation + RIS at secondary path vertices
+const FeatureRayTracedReflections : u32 = 262144u; // [-] exact TLAS/BLAS multi-bounce ray-traced reflections
+// 📝 Bits 20-22, 24-26 and 28-30 of Features carry MaxBounces, InitialCandidates and ReflectionBounces (RayTraversal.wgsl), so the
+//    32 bits are spent. Every later toggle lives in the second word, Frame.Features2, where the bits cannot collide with those.
+
+// 📝 ExtendedFeature — Frame.Features2.
+const ExtendedScreenTraversal  : u32 = 1u;    // [-] master gate: screen traces ahead of the RT / distance-field tracer (default off)
+const ExtendedScreenIndirect   : u32 = 2u;    // [-] screen traces for ReSTIR GI candidates (needs the master gate)
+const ExtendedScreenReflection : u32 = 4u;    // [-] screen traces for reflection rays (needs the master gate)
+const ExtendedLightGrid        : u32 = 8u;    // [-] world light grid culling; off = every receiver tests every light (the reference)
+const ExtendedEmissiveLights   : u32 = 16u;   // [-] emissive-triangle clusters are sampled as lights (next-event estimation)
+const ExtendedIesProfiles      : u32 = 32u;   // [-] the light beams follow their IES (LM-63) photometric profiles instead of the analytic beam shapes
+const ExtendedCockpitExposure  : u32 = 64u;   // [-] windshield-weighted auto-exposure metering when camera is inside the vehicle cabin
+
+fn ExtendedEnabled(Frame: FrameRecord, Bit: u32) -> bool
+{
+    return (Frame.Features2 & Bit) != 0u;
+}
+
+// 📝 A screen trace runs only when the master gate and its consumer's bit are both set.
+fn ScreenConsumerEnabled(Frame: FrameRecord, Consumer: u32) -> bool
+{
+    return ExtendedEnabled(Frame, ExtendedScreenTraversal) && ExtendedEnabled(Frame, Consumer);
+}
+
+fn FeatureEnabled(Frame: FrameRecord, Bit: u32) -> bool
+{
+    return (Frame.Features & Bit) != 0u;
+}
+
+fn ResolveMaxBounces(Frame: FrameRecord) -> u32
+{
+    let Encoded = (Frame.Features >> 20u) & 7u;
+    return select(Encoded, 3u, Encoded == 0u);
+}
+
+fn ResolveInitialCandidates(Frame: FrameRecord) -> u32
+{
+    let Encoded = (Frame.Features >> 24u) & 7u;
+    return select(Encoded, 2u, Encoded == 0u);
+}
+
+fn ResolveReflectionBounces(Frame: FrameRecord) -> u32
+{
+    let Encoded = (Frame.Features >> 28u) & 7u;
+    return select(Encoded, 2u, Encoded == 0u);
+}
+
+fn ResolveDistanceInspectionMode(Frame: FrameRecord) -> u32
+{
+    return Frame.DistanceInspection & 15u;
+}
+
+fn ResolveReflectionRoughness(Frame: FrameRecord) -> f32
+{
+    let Encoded = (Frame.DistanceInspection >> 8u) & 255u;
+    return select(0.80, f32(Encoded) / 255.0, Encoded > 0u);
+}
+
+fn ResolveReflectionScale(Frame: FrameRecord) -> f32
+{
+    let Encoded = (Frame.DistanceInspection >> 16u) & 0xFFFFu;
+    return select(1.0, max(f32(Encoded) - 1.0, 0.0) / 1000.0, Encoded > 0u);
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                   OCCUPANT RECORD
+//------------------------------------------------------------------------------------------------------------------------
+
+struct OccupantRecord
+{
+    LocalToWorld         : mat4x4f,   // [-]
+    WorldToLocal         : mat4x4f,   // [-]
+    PreviousLocalToWorld : mat4x4f,   // [-]
+    PreviousWorldToLocal : mat4x4f,   // [-]
+    WorldMinimum         : vec3f,     // [m]  current world bounds
+    Roles                : u32,       // [-]  OccupantRole mask
+    WorldMaximum         : vec3f,     // [m]
+    MaterialOverride     : u32,       // [-]  0xFFFFFFFF keeps the per-facet family
+    VolumeMinimum        : vec3f,     // [m]  local corner of distance texel (0,0,0)
+    VoxelExtent          : f32,       // [m]  distance volume voxel edge
+    VolumeTexelOrigin    : vec3f,     // [texel] placement inside the volume space
+    FirstCard            : u32,       // [-]
+    VolumeTexelExtent    : vec3f,     // [texel] resolution
+    CardCount            : u32,       // [-]
+}
+
+const RoleRaster   : u32 = 1u;
+const RoleDistance : u32 = 2u;
+const RoleCards    : u32 = 4u;
+const RoleDynamic  : u32 = 8u;
+const RoleFallback : u32 = 16u;   // card-less: FirstCard carries the packed albedo
+const RoleEmissiveCluster : u32 = 64u;   // represented in the emissive light table (EmissiveLightSpace.js)
+const RoleShredded : u32 = 32u;   // fractured / shredded tyre piece: ray traversal passes through its TyreFamily rubber
+const NoMaterialOverride : u32 = 0xFFFFFFFFu;
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                     CARD RECORD
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📝 One oriented card of an occupant: an axis-aligned face of the occupant's local card bounds, looking inward.
+//    Axis 0 +X, 1 −X, 2 +Y, 3 −Y, 4 +Z, 5 −Z names the outward normal of the face the card lies on.
+struct CardRecord
+{
+    LocalMinimum : vec3f,   // [m]
+    Axis         : u32,     // [-]
+    LocalMaximum : vec3f,   // [m]
+    Occupant     : u32,     // [-]
+    TexelOrigin  : vec2u,   // [texel] tile corner in the card texel space
+    TexelExtent  : vec2u,   // [texel] tile size
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                   MATERIAL RECORD
+//------------------------------------------------------------------------------------------------------------------------
+
+struct MaterialRecord
+{
+    Albedo        : vec3f,   // [-]  linear Rec.709 reflectance
+    Roughness     : f32,     // [-]  perceptual
+    Emission      : vec3f,   // [-]  colour × luminance
+    Metalness     : f32,     // [-]
+    CoatWeight    : f32,     // [-]
+    CoatRoughness : f32,     // [-]
+    SpecularLevel : f32,     // [-]  dielectric F0
+    Transmission  : f32,     // [-]
+    // 📝 Index of refraction; 0 keeps the surface opaque. The record is 64 bytes, its size rounded to 16 by WGSL: the
+    //    host writes 16 floats per material (MaterialRecordBytes in MaterialSpecification.js).
+    IndexOfRefraction : f32, // [-]  > 1 bends transmitted light by Snell's law (DisplayRefraction.wgsl)
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                   SHARED CONSTANTS
+//------------------------------------------------------------------------------------------------------------------------
+
+const Pi           : f32 = 3.14159265358979;
+const InversePi    : f32 = 0.31830988618379;
+const LuminanceRec709 : vec3f = vec3f(0.2126, 0.7152, 0.0722);
+
+fn ResolveLuminance(Radiance: vec3f) -> f32
+{
+    return dot(Radiance, LuminanceRec709);
+}
+
+// 📐 Builds an orthonormal tangent frame around a unit normal (Duff et al. 2017, branchless).
+fn ConstructTangentFrame(Normal: vec3f) -> mat3x3f
+{
+    let Sign = select(-1.0, 1.0, Normal.z >= 0.0);
+    let a = -1.0 / (Sign + Normal.z);
+    let b = Normal.x * Normal.y * a;
+    let Tangent   = vec3f(1.0 + Sign * Normal.x * Normal.x * a, Sign * b, -Sign * Normal.x);
+    let Bitangent = vec3f(b, Sign + Normal.y * Normal.y * a, -Normal.y);
+    return mat3x3f(Tangent, Bitangent, Normal);
+}
diff --git a/Experimental/FrontierEngine/Shader/ScreenTraversal.wgsl b/Experimental/FrontierEngine/Shader/ScreenTraversal.wgsl
new file mode 100644
index 0000000..4aebabf
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/ScreenTraversal.wgsl
@@ -0,0 +1,296 @@
+//============================================================================================================================================
+//                                                           SCREENTRAVERSAL.WGSL
+//============================================================================================================================================
+// 🧩 Screen traces ahead of the scene distance field: a walk over the nearest-depth pyramid of this frame, as Lumen does.
+
+// 📝 Lumen answers a gather or reflection ray in two parts. It first walks the ray across the screen through a pyramid of
+//    nearest depths, which resolves contact detail far finer than any distance-field voxel. A ray the screen cannot
+//    settle — it leaves the viewport, passes behind a surface, strikes the back of one, or exhausts its steps — goes on
+//    through the ONE scene distance field, starting from the last point the screen proved unoccluded. That point is
+//    sound: wherever the ray lies in front of the nearest depth of a tile, nothing rastered stands between it and the eye,
+//    and everything inside the viewport is rastered. Group 3, bindings 4 to 8, carries what the walk reads (bindings 0 to 3 are the BVH of RayTraversal.wgsl).
+//
+//    The radiance a sample point sends back follows one rule for every consumer (ResolveSampleExitance): the diffuse
+//    exitance the previous frame resolved at that point — the quantity a surface card stores, at screen resolution with
+//    shadow-map visibility — where this frame's screen shows the point and the previous frame's depth confirms it was
+//    visible there too; the surface cards everywhere else. Card radiance and screen radiance never differ in kind.
+
+//! include "CardSampling.wgsl"
+//! include "PackingCodec.wgsl"
+
+@group(3) @binding(4) var NearestDepth      : texture_2d<f32>;   // [-] reversed depth; level L holds the nearest of each 2^L tile
+@group(3) @binding(5) var PriorNearestDepth : texture_2d<f32>;   // [-] the same pyramid one frame earlier; level 0 is read
+@group(3) @binding(6) var ScreenAttributes  : texture_2d<f32>;   // [-] octahedral normal in xy, material family in z
+@group(3) @binding(8) var ScreenIdentity    : texture_2d<f32>;   // [-] occupant identity (GroundIdentity for the course plane), r16float
+@group(3) @binding(7) var PriorExitance     : texture_2d<f32>;   // [-] previous frame's diffuse exitance per pixel
+
+const ScreenSinkTolerance     : f32 = 0.0015;   // [-] relative depth a grazing ray may sink below a tile and still pass over it
+const ScreenRelativeThickness : f32 = 0.02;     // [-] relative depth behind a surface that still counts as striking it
+const ScreenAbsoluteThickness : f32 = 0.03;     // [m] floor of that thickness near the eye
+const ScreenExitanceAgreement : f32 = 0.02;     // [-] relative depth agreement that confirms a point in a depth lattice
+const ScreenUnreachedTravel   : f32 = 1.0e30;   // [-] parameter of a boundary the walk can never reach
+
+struct ScreenHit
+{
+    Position : vec3f,   // [m]   on the ray, at the struck surface
+    Travel   : f32,     // [m]   ray parameter at the strike, or at the last point the screen proved unoccluded
+    Normal   : vec3f,   // [-]   shading normal of the struck pixel
+    Identity : u32,     // [-]   occupant identity of the struck pixel (GroundIdentity for the course plane)
+    Hit      : bool,
+}
+
+// 📝 World → (u, v, reversed depth) through this frame's jittered projection, the one the depth was rastered with.
+fn ProjectScreenPoint(Position: vec3f) -> vec3f
+{
+    let Clip = Frame.ViewProjection * vec4f(Position, 1.0);
+    let Ndc = Clip.xyz / Clip.w;
+    return vec3f(Ndc.x * 0.5 + 0.5, 0.5 - Ndc.y * 0.5, Ndc.z);
+}
+
+fn ReconstructScreenPoint(Point: vec3f) -> vec3f
+{
+    let Clip = Frame.InverseViewProjection * vec4f(Point.x * 2.0 - 1.0, 1.0 - Point.y * 2.0, Point.z, 1.0);
+    return Clip.xyz / Clip.w;
+}
+
+// 📝 Normal offset of a screen-trace origin: about two pixels of footprint, far below the distance-field bias, so the
+//    walk keeps the creases the distance field cannot resolve.
+fn ResolveScreenBias(ViewDepth: f32) -> f32
+{
+    return 0.004 + 0.002 * ViewDepth;
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                  NEAREST-DEPTH WALK
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📐 Stackless walk over the pyramid in (u, v, d) space, where a world segment stays a segment because the projection is
+//    projective. At level L the ray either ① lies in front of the tile's nearest depth and crosses to the tile's exit
+//    boundary — then it climbs a level — or ② meets the tile's nearest-depth plane first, or already lies behind it —
+//    then it descends. Descending below level 0 means the ray has met the depth surface at one pixel, which is a strike
+//    if the ray lies within the surface thickness, faces the surface, and has left its own neighbourhood.
+fn TraverseScreenDepth(Origin: vec3f, Direction: vec3f, MaximumTravel: f32, StepLimit: u32) -> ScreenHit
+{
+    var Result: ScreenHit;
+    Result.Hit      = false;
+    Result.Travel   = 0.0;
+    Result.Position = Origin;
+    Result.Normal   = -Direction;
+    Result.Identity = SkyIdentity;
+
+    // ① keep the far end in front of the eye, then clip the projected segment to the viewport
+    let OriginDepth = ResolveViewDepth(Origin);
+    let DepthRate = -(Frame.View * vec4f(Direction, 0.0)).z;
+    var Reach = MaximumTravel;
+    if (DepthRate < 0.0)
+    {
+        Reach = min(Reach, (OriginDepth - 2.0 * Frame.CameraNear) / -DepthRate);
+    }
+    if (OriginDepth <= 2.0 * Frame.CameraNear || Reach <= 0.0)
+    {
+        return Result;
+    }
+    let Start = ProjectScreenPoint(Origin);
+    if (any(Start.xy <= vec2f(0.0)) || any(Start.xy >= vec2f(1.0)))
+    {
+        return Result;
+    }
+    let Projected = ProjectScreenPoint(Origin + Direction * Reach) - Start;
+    var Exit = 1.0;
+    for (var Axis = 0u; Axis < 2u; Axis++)
+    {
+        if (Projected[Axis] > 0.0)
+        {
+            Exit = min(Exit, (1.0 - Start[Axis]) / Projected[Axis]);
+        }
+        else if (Projected[Axis] < 0.0)
+        {
+            Exit = min(Exit, -Start[Axis] / Projected[Axis]);
+        }
+    }
+    // 📝 Re-parameterised over the visible part only, so one pixel is never a vanishing fraction of the parameter.
+    let Delta = Projected * Exit;
+
+    let BaseExtent = vec2f(textureDimensions(NearestDepth, 0));
+    let LevelCount = i32(textureNumLevels(NearestDepth));
+    let Moving     = abs(Delta) > vec3f(1.0e-12);
+    let Inverse    = select(vec3f(ScreenUnreachedTravel), 1.0 / select(vec3f(1.0), Delta, Moving), Moving);
+    // 📝 A component that does not move takes the forward side, so its boundary lies at +∞ rather than −∞.
+    let Receding   = (Delta.xy < vec2f(0.0)) & Moving.xy;
+    let ExitSide   = select(vec2f(1.0), vec2f(0.0), Receding);
+    let Nudge      = select(vec2f(0.005), vec2f(-0.005), Receding) / BaseExtent;
+
+    // ② leave the origin pixel before the first comparison: a surface never occludes itself
+    let StartPixel = floor(Start.xy * BaseExtent);
+    let FirstCrossing = ((StartPixel + ExitSide) / BaseExtent + Nudge - Start.xy) * Inverse.xy;
+    var Travel = min(FirstCrossing.x, FirstCrossing.y);
+
+    // ③ the walk
+    var Level = 0;
+    var Descended = false;
+    for (var Iteration = 0u; Iteration < StepLimit; Iteration++)
+    {
+        if (Travel > 1.0)
+        {
+            break;
+        }
+        let Point      = Start + Delta * Travel;
+        let Resolution = BaseExtent * exp2(-f32(Level));
+        let Cell       = floor(Point.xy * Resolution);
+        let Texel      = clamp(vec2i(Cell), vec2i(0), vec2i(textureDimensions(NearestDepth, Level)) - vec2i(1));
+        let Tolerated  = textureLoad(NearestDepth, Texel, Level).r * (1.0 - ScreenSinkTolerance);
+        let Crossing   = ((Cell + ExitSide) / Resolution + Nudge - Start.xy) * Inverse.xy;
+        let Boundary   = min(Crossing.x, Crossing.y);
+        var Sinking    = ScreenUnreachedTravel;
+        if (Delta.z < 0.0 && Moving.z)
+        {
+            Sinking = (Tolerated - Start.z) * Inverse.z;
+        }
+        let InFront = Point.z > Tolerated;
+        if (InFront)
+        {
+            Travel = min(Boundary, Sinking);
+        }
+        if (InFront && Boundary < Sinking)
+        {
+            Level = min(Level + 1, LevelCount - 1);
+        }
+        else
+        {
+            Level--;
+            if (Level < 0)
+            {
+                Descended = true;
+                break;
+            }
+        }
+    }
+
+    // ④ the last point the walk proved unoccluded is where the distance field takes over
+    let Settled = Start + Delta * clamp(Travel, 0.0, 1.0);
+    Result.Travel = max(dot(ReconstructScreenPoint(Settled) - Origin, Direction), 0.0);
+    if (!Descended)
+    {
+        return Result;
+    }
+
+    // ⑤ validate the strike
+    let Pixel = vec2i(floor(Settled.xy * BaseExtent));
+    if (any(Pixel < vec2i(0)) || any(Pixel >= vec2i(BaseExtent)) || all(abs(Pixel - vec2i(StartPixel)) <= vec2i(1)))
+    {
+        return Result;
+    }
+    let SurfaceDepth = textureLoad(NearestDepth, Pixel, 0).r;
+    if (SurfaceDepth <= 0.0)
+    {
+        return Result;
+    }
+    let Attributes = textureLoad(ScreenAttributes, Pixel, 0);
+    let Normal = DecodeOctahedral(Attributes.xy);
+    if (dot(Normal, Direction) >= 0.0)
+    {
+        return Result;
+    }
+    let SurfaceView = Frame.CameraNear / SurfaceDepth;
+    let RayView     = Frame.CameraNear / max(Settled.z, 1.0e-12);
+    if (RayView - SurfaceView > max(ScreenRelativeThickness * SurfaceView, ScreenAbsoluteThickness))
+    {
+        return Result;
+    }
+    Result.Hit      = true;
+    Result.Position = Origin + Direction * Result.Travel;
+    Result.Normal   = Normal;
+    Result.Identity = u32(Attributes.w + 0.5);
+    return Result;
+}
+
+//------------------------------------------------------------------------------------------------------------------------
+//                                                  SAMPLE EXITANCE
+//------------------------------------------------------------------------------------------------------------------------
+
+// 📝 The previous frame's diffuse exitance at a world point, or w = 0 where it cannot be trusted. ① This frame's screen
+//    must show the point at its pixel — same depth, same occupant — so a point hidden now never borrows the surface in
+//    front of it. ② A point on a moving occupant is carried back by that occupant's previous transform. ③ The previous
+//    frame's depth must agree at the reprojected pixel, which rejects every disocclusion.
+fn ResolvePriorExitance(Position: vec3f, Identity: u32) -> vec4f
+{
+    let Point = ProjectScreenPoint(Position);
+    if (any(Point.xy <= vec2f(0.0)) || any(Point.xy >= vec2f(1.0)) || Point.z <= 0.0)
+    {
+        return vec4f(0.0);
+    }
+    let Extent = vec2f(textureDimensions(NearestDepth, 0));
+    let Pixel = vec2i(Point.xy * Extent);
+    let Surface = textureLoad(NearestDepth, Pixel, 0).r;
+    if (Surface <= 0.0 || abs(Point.z - Surface) > ScreenExitanceAgreement * Surface)
+    {
+        return vec4f(0.0);
+    }
+    if (u32(textureLoad(ScreenIdentity, Pixel, 0).r + 0.5) != Identity)
+    {
+        return vec4f(0.0);
+    }
+
+    var Prior = Position;
+    if (Identity < arrayLength(&Occupants))
+    {
+        let Occupant = Occupants[Identity];
+        if ((Occupant.Roles & RoleDynamic) != 0u)
+        {
+            Prior = (Occupant.PreviousLocalToWorld * (Occupant.WorldToLocal * vec4f(Position, 1.0))).xyz;
+        }
+    }
+    let PriorClip = Frame.PreviousUnjitteredViewProjection * vec4f(Prior, 1.0);
+    if (PriorClip.w <= Frame.CameraNear)
+    {
+        return vec4f(0.0);
+    }
+    let PriorNdc = PriorClip.xyz / PriorClip.w;
+    let PriorPoint = vec2f(PriorNdc.x * 0.5 + 0.5, 0.5 - PriorNdc.y * 0.5);
+    if (any(PriorPoint <= vec2f(0.0)) || any(PriorPoint >= vec2f(1.0)))
+    {
+        return vec4f(0.0);
+    }
+    let PriorPixel = vec2i(PriorPoint * Extent);
+    let PriorSurface = textureLoad(PriorNearestDepth, PriorPixel, 0).r;
+    if (PriorSurface <= 0.0 || abs(PriorNdc.z - PriorSurface) > ScreenExitanceAgreement * PriorSurface)
+    {
+        return vec4f(0.0);
+    }
+    return vec4f(textureLoad(PriorExitance, PriorPixel, 0).rgb, 1.0);
+}
+
+// 📝 Radiance leaving a sample point, by the one rule above. Returns (radiance, coverage) as SampleCardRadiance does.
+//    A temporal restart (a lighting discontinuity, a resize) leaves the previous frame stale, so the cards answer alone.
+fn ResolveSampleExitance(Position: vec3f, Normal: vec3f, Identity: u32, Tolerance: f32) -> vec4f
+{
+    if (ExtendedEnabled(Frame, ExtendedScreenTraversal) && !FeatureEnabled(Frame, FeatureTemporalRestart))
+    {
+        let Screen = ResolvePriorExitance(Position, Identity);
+        if (Screen.w > 0.0)
+        {
+            return Screen;
+        }
+    }
+    return SampleCardRadiance(Position, Normal, Identity, Tolerance);
+}
+
+// 📝 What a ray the distance field finished brings back: the sky on an escape, the sample exitance at a surface.
+fn ResolveContinuedRadiance(Hit: TraversalHit, Direction: vec3f) -> vec3f
+{
+    if (!Hit.Hit)
+    {
+        return SampleSkyRadiance(Direction);
+    }
+    let Exitance = ResolveSampleExitance(Hit.Position, Hit.Normal, Hit.Identity, ResolveCardTolerance(Hit.Level));
+    return select(vec3f(0.0), Exitance.rgb, Exitance.w > 0.0);
+}
+
+// 📝 What a screen strike brings back. The strike lies on the rastered surface itself, so the card tolerance is that of
+//    the finest cascade holding the point.
+fn ResolveStrikeRadiance(Strike: ScreenHit) -> vec3f
+{
+    let Tolerance = ResolveCardTolerance(ResolveFinestClip(Strike.Position, 1.0));
+    let Exitance = ResolveSampleExitance(Strike.Position, Strike.Normal, Strike.Identity, Tolerance);
+    return select(vec3f(0.0), Exitance.rgb, Exitance.w > 0.0);
+}
diff --git a/Experimental/FrontierEngine/Shader/ShadowRaster.wgsl b/Experimental/FrontierEngine/Shader/ShadowRaster.wgsl
new file mode 100644
index 0000000..529bb98
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/ShadowRaster.wgsl
@@ -0,0 +1,88 @@
+//============================================================================================================================================
+//                                                            SHADOWRASTER.WGSL
+//============================================================================================================================================
+// 🧩 Depth-only projection of every rastered occupant into one cascade of the sun's shadow depth.
+
+//! include "SceneRecords.wgsl"
+//! include "EffectRecords.wgsl"
+//! include "VehicleVisual.wgsl"
+
+struct CascadeRecord
+{
+    LightViewProjection : mat4x4f,
+}
+
+@group(0) @binding(0) var<uniform> Cascade             : CascadeRecord;
+@group(0) @binding(1) var<storage, read> Occupants     : array<OccupantRecord>;
+@group(0) @binding(2) var<uniform> Effect              : EffectRecord;   // the vehicle program only
+@group(0) @binding(3) var<storage, read> VehicleState  : VehicleRecord;  // the vehicle program only
+
+// 📝 OccupantOffset: as in SurfaceRaster.wgsl, a composite fragment set's vertices name their own occupant.
+@vertex
+fn ShadowVertex(@location(0) Position: vec3f, @location(1) OccupantOffset: u32,
+                @builtin(instance_index) OccupantIndex: u32) -> @builtin(position) vec4f
+{
+    let World = Occupants[OccupantIndex + OccupantOffset].LocalToWorld * vec4f(Position, 1.0);
+    return Cascade.LightViewProjection * World;
+}
+
+// 📝 The vehicle program, for the car's runs only: rigid wheel damage visibility and the steering wheel's turn as in
+//    the surface raster; see-through glazing casts no shadow (the sun reaches the cabin through it); and while the
+//    car derezzes or rezzes its shadow comes apart with it — the fragment stage drops exactly the cells the surface
+//    raster drops.
+struct MaskedShadowVarying
+{
+    @builtin(position) Position         : vec4f,
+    @location(0) BodyLocal              : vec3f,
+    @location(1) @interpolate(flat) Glass : u32,
+}
+
+@vertex
+fn MaskedShadowVertex(@location(0) Position: vec3f, @location(1) OccupantOffset: u32, @location(2) Family: u32,
+                      @builtin(instance_index) OccupantIndex: u32) -> MaskedShadowVarying
+{
+    let Index = OccupantIndex + OccupantOffset;
+    var Local = Position;
+    if (Index >= 1u && Index < 5u)
+    {
+        Local = ResolveWheelVertex(Index - 1u, Family, Position, vec3f(0.0, 0.0, 1.0)).Position;
+    }
+    else if (Index == 0u)
+    {
+        Local = DeformBodyVertex(Family, Position, vec3f(0.0, 0.0, 1.0)).Position;
+    }
+    let World = Occupants[Index].LocalToWorld * vec4f(Local, 1.0);
+    var Varying: MaskedShadowVarying;
+    Varying.Position = Cascade.LightViewProjection * World;
+    Varying.BodyLocal = (Occupants[0].WorldToLocal * World).xyz;
+    Varying.Glass = select(0u, 1u, Index == 0u && Family == VehicleGlassFamily);
+    return Varying;
+}
+
+@fragment
+fn MaskedShadowFragment(Varying: MaskedShadowVarying)
+{
+    if (Varying.Glass == 1u && VehicleState.Cabin.y > 0.5)
+    {
+        discard;
+    }
+    if (Effect.MaskMode == 0u)
+    {
+        return;
+    }
+    if (Effect.MaskMode == 3u)
+    {
+        discard;
+    }
+    let Unit = (Varying.BodyLocal - Effect.BodyMinimum.xyz) / max(Effect.BodyMaximum.xyz - Effect.BodyMinimum.xyz, vec3f(1.0e-3));
+    let Elapsed = Effect.Clock - Effect.MaskStart;
+    let Seed = u32(Effect.Emitters[0].Centre.w);
+    if (Effect.MaskMode == 1u && Elapsed >= ResolveDerezRelease(Unit, Seed, Effect.Style, 1.0))
+    {
+        discard;
+    }
+    if (Effect.MaskMode == 2u && Elapsed < ResolveRezArrival(Unit, Seed, Effect.Style, 1.0))
+    {
+        discard;
+    }
+}
diff --git a/Experimental/FrontierEngine/Shader/SkyProjection.wgsl b/Experimental/FrontierEngine/Shader/SkyProjection.wgsl
new file mode 100644
index 0000000..6682052
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/SkyProjection.wgsl
@@ -0,0 +1,22 @@
+//============================================================================================================================================
+//                                                            SKYPROJECTION.WGSL
+//============================================================================================================================================
+// 🧩 The sky-view parametrisation: absolute azimuth on U, square-root elevation on V so the horizon receives the texels.
+
+// 📐 u = φ/2π + ½,  v = ½ − ½·sign(e)·√(|e| / (π/2)); v = 0 is the zenith row, ½ the horizon, 1 the nadir.
+fn ProjectSkyCoordinates(Direction: vec3f) -> vec2f
+{
+    let Azimuth   = atan2(Direction.y, Direction.x);
+    let Elevation = asin(clamp(Direction.z, -1.0, 1.0));
+    let U = Azimuth * (0.5 / 3.14159265358979) + 0.5;
+    let V = 0.5 - 0.5 * sign(Elevation) * sqrt(abs(Elevation) / 1.5707963267949);
+    return vec2f(U, V);
+}
+
+fn ReconstructSkyDirection(Coordinates: vec2f) -> vec3f
+{
+    let Azimuth = (Coordinates.x - 0.5) * 2.0 * 3.14159265358979;
+    let Signed  = (0.5 - Coordinates.y) * 2.0;
+    let Elevation = sign(Signed) * Signed * Signed * 1.5707963267949;
+    return vec3f(cos(Elevation) * cos(Azimuth), cos(Elevation) * sin(Azimuth), sin(Elevation));
+}
diff --git a/Experimental/FrontierEngine/Shader/SparkRaster.wgsl b/Experimental/FrontierEngine/Shader/SparkRaster.wgsl
new file mode 100644
index 0000000..2ee9af3
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/SparkRaster.wgsl
@@ -0,0 +1,86 @@
+//============================================================================================================================================
+//                                                             SPARKRASTER.WGSL
+//============================================================================================================================================
+// 🧩 Sparks as streaks: each one a screen-aligned quad from where the camera saw it a frame ago to where it sees it now, additive.
+
+// 📝 Per instance (SparkSequence.js): the head (now) and the tail (a frame ago) in world space, the spark's width and its
+//    blackbody radiance. The head projects through this frame's camera and the tail through last frame's, so the
+//    streak is the spark's motion as the camera saw it over the frame — a shutter's blur: sparks thrown off a wheel
+//    stream back from a car the camera follows. The quad spans head to tail in screen space, at least a pixel wide so
+//    a distant spark stays visible and never longer than a fifth of the screen (a camera cut), with a soft profile
+//    across and a brighter head; drawn over the resolved image (unjittered), depth-tested against the opaque surface,
+//    added.
+
+//! include "FrameDescriptor.wgsl"
+
+struct SparkVarying
+{
+    @builtin(position) Position : vec4f,
+    @location(0) Radiance       : vec3f,
+    @location(2) Shape          : vec2f,   // pixel-width factor, shutter fraction
+    @location(1) Profile        : vec2f,   // x across [-1, 1], y along [0 tail, 1 head]
+}
+
+fn ProjectPixels(Clip: vec4f) -> vec2f
+{
+    return Clip.xy / Clip.w * 0.5 * Frame.ScreenExtent;
+}
+
+@vertex
+fn SparkVertex(@builtin(vertex_index) VertexIndex: u32, @location(0) Head: vec4f, @location(1) Tail: vec4f,
+               @location(2) Radiance: vec4f) -> SparkVarying
+{
+    var Varying: SparkVarying;
+    let HeadClip = Frame.UnjitteredViewProjection * vec4f(Head.xyz, 1.0);
+    var TailClip = Frame.PreviousUnjitteredViewProjection * vec4f(Tail.xyz, 1.0);
+    if (HeadClip.w < 0.05)
+    {
+        Varying.Position = vec4f(0.0, 0.0, -2.0, 1.0);
+        return Varying;
+    }
+    if (TailClip.w < 0.05)
+    {
+        TailClip = HeadClip;
+    }
+    let Up = vec3f(Frame.View[0].y, Frame.View[1].y, Frame.View[2].y);
+    let HeadPixels = ProjectPixels(HeadClip);
+    var TailPixels = ProjectPixels(TailClip);
+    // Bound the raster footprint: close-up glowing chips must not become large billboards.
+    let Width = clamp(length(ProjectPixels(Frame.UnjitteredViewProjection * vec4f(Head.xyz + Up * Head.w, 1.0)) - HeadPixels), 0.65, 1.35);
+    let PixelWidth = select(1.0, clamp(Tail.w, 0.35, 1.0), Tail.w > 0.0);
+    let Shutter = select(1.0, clamp(Radiance.w, 0.15, 1.0), Radiance.w > 0.0);
+    TailPixels = mix(HeadPixels, TailPixels, Shutter);
+    var Along = HeadPixels - TailPixels;
+    let Longest = 0.2 * Frame.ScreenExtent.y;
+    if (length(Along) > Longest)
+    {
+        TailPixels = HeadPixels - Along * (Longest / length(Along));
+        Along = HeadPixels - TailPixels;
+    }
+    let Length = length(Along);
+    Along = select(vec2f(1.0, 0.0), Along / max(Length, 1.0e-4), Length > 1.0e-3);
+    let Across = vec2f(-Along.y, Along.x);
+    // 📝 Corners: (along, across) — tail end pushed back and head end forward by half a width so a still spark is a dot.
+    var Corners = array<vec2f, 6>(vec2f(0.0, -1.0), vec2f(1.0, -1.0), vec2f(1.0, 1.0), vec2f(0.0, -1.0), vec2f(1.0, 1.0), vec2f(0.0, 1.0));
+    let Corner = Corners[VertexIndex % 6u];
+    // 📝 Both ends take the head's depth: the tail's clip position belongs to last frame's camera, and a streak a few
+    //    centimetres long sits at one depth for the test anyway.
+    let BasePixels = select(TailPixels, HeadPixels, Corner.x > 0.5);
+    let Offset = Across * Corner.y * Width * PixelWidth * mix(0.22, 1.0, Corner.x) * 0.5 + Along * (Corner.x - 0.5) * Width * PixelWidth;
+    let Pixels = BasePixels + Offset;
+    Varying.Position = vec4f(Pixels / (0.5 * Frame.ScreenExtent) * HeadClip.w, HeadClip.z, HeadClip.w);
+    // 📝 Energy: a spark's light spread over a streak longer than its width is shared out along it.
+    let Spread = Width / max(Length + Width, Width);
+    Varying.Radiance = Radiance.rgb * mix(0.35, 1.0, Spread) * Frame.EmissionScale;
+    Varying.Profile = vec2f(Corner.y, Corner.x);
+    Varying.Shape = vec2f(PixelWidth,Shutter);
+    return Varying;
+}
+
+@fragment
+fn SparkFragment(Varying: SparkVarying) -> @location(0) vec4f
+{
+    let Across = pow(max(0.0, 1.0 - Varying.Profile.x * Varying.Profile.x), 2.0);
+    let Head = mix(mix(0.08, 0.35, Varying.Shape.y), 1.0, pow(Varying.Profile.y, mix(0.7,1.8,Varying.Shape.x)));
+    return vec4f(Varying.Radiance * Across * Head, 0.0);
+}
diff --git a/Experimental/FrontierEngine/Shader/SurfaceRaster.wgsl b/Experimental/FrontierEngine/Shader/SurfaceRaster.wgsl
new file mode 100644
index 0000000..1ff4476
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/SurfaceRaster.wgsl
@@ -0,0 +1,266 @@
+//============================================================================================================================================
+//                                                            SURFACERASTER.WGSL
+//============================================================================================================================================
+// 🧩 Primary visibility: every rastered occupant projected into depth, shading normal, material family and screen motion.
+
+//! include "FrameDescriptor.wgsl"
+//! include "PackingCodec.wgsl"
+//! include "EffectRecords.wgsl"
+//! include "VehicleVisual.wgsl"
+//! include "DistanceRecords.wgsl"
+
+@group(0) @binding(1) var<storage, read> Occupants : array<OccupantRecord>;
+@group(0) @binding(2) var TyreMarks                 : texture_2d<f32>;   // r deposit [0, 1], g lateral coordinate (0: untouched)
+@group(0) @binding(3) var TyreMarkSampler           : sampler;
+@group(0) @binding(4) var<uniform> Effect           : EffectRecord;
+@group(0) @binding(5) var<storage, read> VehicleState : VehicleRecord;
+
+const VehicleOccupantCount : u32 = 5u;   // the body and four wheels lead the occupant list
+
+struct SurfaceVarying
+{
+    @builtin(position) Position             : vec4f,
+    @location(0) Normal                     : vec3f,
+    @location(1) @interpolate(flat) Family  : u32,
+    @location(2) CurrentClip                : vec4f,
+    @location(3) PreviousClip               : vec4f,
+    @location(4) WorldPosition              : vec3f,
+    @location(5) @interpolate(flat) Vehicle : u32,
+    @location(6) BodyLocal                  : vec3f,   // car-body frame, for the derez mask
+    @location(7) @interpolate(flat) Identity : u32,   // occupant identity in the distance field's vocabulary
+}
+
+struct SurfaceTargets
+{
+    @location(0) Attributes : vec4f,   // xy octahedral shading normal, z material family, w 1 + glow (× albedo, as emission)
+    @location(1) Motion     : vec2f,   // [px] current minus previous screen position
+    @location(2) Identity   : f32,     // occupant identity for screen traces, GroundIdentity for the course plane
+}
+
+// 📝 The vehicle's own motion in the vertex stage: shredded rubber is hidden; rigid wheel meshes keep their authored form, the cabin's
+//    steering wheel turns about its column and the cockpit takes its scale and offset (VehicleVisual.wgsl), before the
+//    occupant transform.
+fn DeformVehicleVertex(Index: u32, Family: u32, Position: vec3f, Normal: vec3f) -> DeformedVertex
+{
+    var Moved: DeformedVertex;
+    Moved.Position = Position;
+    Moved.Normal = Normal;
+    if (Index >= 1u && Index < VehicleOccupantCount)
+    {
+        return ResolveWheelVertex(Index - 1u, Family, Position, Normal);
+    }
+    if (Index == 0u)
+    {
+        return DeformBodyVertex(Family, Position, Normal);
+    }
+    return Moved;
+}
+
+// 📝 OccupantOffset is zero for every facet but a composite set's: a fractured prop's fragments share one facet set
+//    and one draw, each vertex naming its own fragment occupant relative to the draw's first instance.
+@vertex
+fn SurfaceVertex(@location(0) Position: vec3f, @location(1) Family: u32, @location(2) Normal: vec3f,
+                 @location(3) OccupantOffset: u32, @builtin(instance_index) OccupantIndex: u32) -> SurfaceVarying
+{
+    let Index    = OccupantIndex + OccupantOffset;
+    let Occupant = Occupants[Index];
+    let Moved    = DeformVehicleVertex(Index, Family, Position, Normal);
+    let World    = Occupant.LocalToWorld * vec4f(Moved.Position, 1.0);
+    let Previous = Occupant.PreviousLocalToWorld * vec4f(Moved.Position, 1.0);
+    var Varying: SurfaceVarying;
+    Varying.Position      = Frame.ViewProjection * World;
+    Varying.CurrentClip   = Frame.UnjitteredViewProjection * World;
+    Varying.PreviousClip  = Frame.PreviousUnjitteredViewProjection * Previous;
+    Varying.Normal        = (Occupant.LocalToWorld * vec4f(Moved.Normal, 0.0)).xyz;
+    Varying.Family        = select(Family, Occupant.MaterialOverride, Occupant.MaterialOverride != NoMaterialOverride);
+    Varying.WorldPosition = World.xyz;
+    Varying.Vehicle       = select(0u, 1u, Index < VehicleOccupantCount);
+    Varying.BodyLocal     = (Occupants[0].WorldToLocal * World).xyz;
+    // 📝 The identity a screen trace reports for this surface, in the distance field's vocabulary: the occupant index for
+    //    every carded occupant, GroundIdentity for the course plane, whose cards belong to the ground tiles. Identities
+    //    stay below 2048, so the half-float attribute holds them exactly.
+    Varying.Identity      = select(GroundIdentity, Index, (Occupant.Roles & RoleCards) != 0u);
+    return Varying;
+}
+
+// 📝 Rubber on a marked road pixel, from the two-channel deposit: the deposit is filtered bilinearly, the lateral
+//    coordinate among touched texels only (an untouched neighbour has no idea where any tread was), and the result
+//    is cut to the tread — 0 ≤ lateral ≤ 1, antialiased over a pixel — with the tread's four grooves taken out of it.
+fn SampleRoadMark(World: vec2f, PixelFootprint: f32, Rim: bool) -> f32
+{
+    let Extent = vec2f(TyreMarkExtentX, TyreMarkExtentY);
+    let Texels = vec2f(textureDimensions(TyreMarks));
+    let Coordinates = (World - vec2f(TyreMarkOriginX, TyreMarkOriginY)) / Extent;
+    if (any(Coordinates <= vec2f(0.0)) || any(Coordinates >= vec2f(1.0)))
+    {
+        return 0.0;
+    }
+    let Position = Coordinates * Texels - 0.5;
+    let Corner = vec2i(floor(Position));
+    let Fraction = Position - floor(Position);
+    var Deposit = 0.0;
+    var Lateral = 0.0;
+    var LateralWeight = 0.0;
+    for (var Tap = 0u; Tap < 4u; Tap++)
+    {
+        let Offset = vec2i(i32(Tap & 1u), i32(Tap >> 1u));
+        let Texel = clamp(Corner + Offset, vec2i(0), vec2i(Texels) - vec2i(1));
+        let Weight = select(1.0 - Fraction.x, Fraction.x, Offset.x == 1) * select(1.0 - Fraction.y, Fraction.y, Offset.y == 1);
+        let Channels = textureLoad(TyreMarks, Texel, 0);
+        let Value = select(Channels.xy, Channels.zw, Rim);
+        Deposit += Value.x * Weight;
+        if (Value.y > 0.5 / 255.0)
+        {
+            Lateral += ((Value.y * 255.0 - 1.0) / 254.0 * 1.5 - 0.25) * Weight;
+            LateralWeight += Weight;
+        }
+    }
+    if (LateralWeight <= 1.0e-4 || Deposit <= 0.0)
+    {
+        return 0.0;
+    }
+    Lateral /= LateralWeight;
+    // 📝 Edges: a pixel's footprint in lateral units, so the edge is one pixel wide at any distance.
+    let Soft = max(PixelFootprint / select(TyreMarkPatchWidth, 0.06, Rim), 0.02);
+    let Inside = smoothstep(-Soft, Soft, Lateral) * smoothstep(-Soft, Soft, 1.0 - Lateral);
+    var Grooves = 0.0;
+    for (var Groove = 0u; Groove < 4u; Groove++)
+    {
+        let Centre = 0.2 + 0.2 * f32(Groove);
+        Grooves = max(Grooves, 1.0 - smoothstep(0.022, 0.022 + Soft, abs(Lateral - Centre)));
+    }
+    let Normalised = Deposit / max(LateralWeight, 0.25);
+    return clamp(Normalised, 0.0, 1.0) * Inside * (1.0 - select(0.55 * Grooves, 0.0, Rim));
+}
+
+fn ProjectScreenPixel(Clip: vec4f) -> vec2f
+{
+    let Ndc = Clip.xy / Clip.w;
+    return vec2f(Ndc.x * 0.5 + 0.5, 0.5 - Ndc.y * 0.5) * Frame.ScreenExtent;
+}
+
+@fragment
+fn SurfaceFragment(Varying: SurfaceVarying) -> SurfaceTargets
+{
+    // 📝 Derivatives first, in uniform control flow: the pixel's footprint on the ground for the tyre-mark edges, and
+    //    the facet's own orientation for the soft tyre's guard below.
+    let Footprint = length(fwidth(Varying.WorldPosition.xy));
+    let Across = cross(dpdx(Varying.WorldPosition), dpdy(Varying.WorldPosition));
+    var Normal = normalize(Varying.Normal);
+    let View = normalize(Frame.CameraPosition - Varying.WorldPosition);
+    // 📝 Every surface shades two-sided: an open facet seen from behind turns its normal toward the viewer.
+    if (dot(Normal, View) < 0.0)
+    {
+        Normal = -Normal;
+    }
+    // 📝 A soft tyre squashed nearly to its rim folds tighter than its facets can follow: where the deformed shading
+    //    normal turns more than ~80° from the facet it lies on, it is bent back toward the facet's own orientation.
+    if (Varying.Vehicle == 1u && Varying.Family == TyreFamily && dot(Across, Across) > 1.0e-20)
+    {
+        let Facet = normalize(Across) * select(1.0, -1.0, dot(Across, View) < 0.0);
+        if (dot(Normal, Facet) < 0.17)
+        {
+            Normal = normalize(mix(Facet, Normal, 0.3));
+        }
+    }
+    // 📝 Tyre rubber: a road pixel becomes the rubber family with probability equal to the deposit under it. The
+    //    threshold is an interleaved gradient that changes every frame, so temporal antialiasing averages the coin
+    //    flips into a smooth darkening — and no lighting program needs to know the marks exist.
+    var Family = Varying.Family;
+    var Glow = 0.0;
+    // 📝 See-through glazing: the car's glass leaves the opaque raster (the cabin overlay draws it over what lies
+    //    behind, tinted and reflecting the sky).
+    if (Varying.Vehicle == 1u && Family == VehicleGlassFamily && VehicleState.Cabin.y > 0.5)
+    {
+        discard;
+    }
+    let Marked = (Family >= MarkedFamilyFirst && Family <= MarkedFamilyLast) || (Family >= MarkedFamilyExtraFirst && Family <= MarkedFamilyExtraLast);
+    if (Marked)
+    {
+        let Deposit = SampleRoadMark(Varying.WorldPosition.xy, Footprint, false);
+        let RimDeposit = SampleRoadMark(Varying.WorldPosition.xy, Footprint, true);
+        let Pixel = Varying.Position.xy + vec2f(5.588238 * f32(Frame.FrameIndex % 32u));
+        let Threshold = fract(52.9829189 * fract(dot(Pixel, vec2f(0.06711056, 0.00583715))));
+        if (Deposit > Threshold)
+        {
+            Family = TyreMarkFamily;
+        }
+        if (RimDeposit > Threshold) { Family = RimMarkFamily; }
+    }
+    // 📝 The derez mask: a car pixel whose cell has been released is gone (its cubes have left, EffectRaster), and the
+    //    cells about to go glow — white-hot at the edge, cyan behind it. Rez is the same clock run backwards.
+    if (Varying.Vehicle == 1u && Effect.MaskMode != 0u)
+    {
+        if (Effect.MaskMode == 3u)
+        {
+            discard;
+        }
+        let Unit = (Varying.BodyLocal - Effect.BodyMinimum.xyz) / max(Effect.BodyMaximum.xyz - Effect.BodyMinimum.xyz, vec3f(1.0e-3));
+        let Elapsed = Effect.Clock - Effect.MaskStart;
+        let Seed = u32(Effect.Emitters[0].Centre.w);
+        // 📝 With face colours the glowing cells keep their own family and glow in its colour; otherwise the
+        //    palette's families stand in.
+        let Faces = Effect.Colour.x > 0.5;
+        if (Effect.MaskMode == 1u)
+        {
+            let Release = ResolveDerezRelease(Unit, Seed, Effect.Style, 1.0);
+            if (Elapsed >= Release)
+            {
+                discard;
+            }
+            if (Elapsed > Release - EffectHotSeconds)
+            {
+                Family = select(DerezHotFamily, Family, Faces);
+                Glow = select(0.0, 3.0 * Effect.Colour.y, Faces);
+            }
+            else if (Elapsed > Release - EffectGlowSeconds)
+            {
+                Family = select(select(DerezGlowFamily, DerezGlitchFamily, Effect.Style == 1u), Family, Faces);
+                Glow = select(0.0, Effect.Colour.y, Faces);
+            }
+        }
+        else
+        {
+            let Arrival = ResolveRezArrival(Unit, Seed, Effect.Style, 1.0);
+            if (Elapsed < Arrival)
+            {
+                discard;
+            }
+            if (Elapsed < Arrival + EffectHotSeconds)
+            {
+                Family = select(DerezHotFamily, Family, Faces);
+                Glow = select(0.0, 3.0 * Effect.Colour.y, Faces);
+            }
+            else if (Elapsed < Arrival + EffectGlowSeconds)
+            {
+                Family = select(select(DerezGlowFamily, DerezGlitchFamily, Effect.Style == 1u), Family, Faces);
+                Glow = select(0.0, Effect.Colour.y, Faces);
+            }
+        }
+    }
+    if (Varying.Vehicle == 1u && Family == 6u && VehicleState.Cabin.z > 0.5)
+    {
+        let TexMode = u32(round(VehicleState.Cabin.z));
+        let P = Varying.BodyLocal;
+        if (TexMode == 1u)
+        {
+            let U = sin((P.x + P.y) * 95.0) * cos((P.x - P.y + P.z) * 95.0);
+            Normal = normalize(Normal + vec3f(U * 0.08, -U * 0.08, U * 0.03));
+        }
+        else if (TexMode == 2u)
+        {
+            let Grain = sin(P.y * 220.0 + P.z * 140.0) * 0.5 + sin(P.y * 430.0) * 0.5;
+            Normal = normalize(Normal + vec3f(0.0, Grain * 0.10, Grain * 0.05));
+        }
+        else if (TexMode == 3u)
+        {
+            let Hx = sin(P.x * 58.0) * sin((0.5 * P.x + 0.866 * (P.y + P.z)) * 58.0);
+            Normal = normalize(Normal + vec3f(Hx * 0.075, Hx * 0.075, -Hx * 0.04));
+        }
+    }
+    var Targets: SurfaceTargets;
+    Targets.Attributes = vec4f(EncodeOctahedral(Normal), f32(Family), 1.0 + Glow);
+    Targets.Identity   = f32(Varying.Identity);
+    Targets.Motion     = ProjectScreenPixel(Varying.CurrentClip) - ProjectScreenPixel(Varying.PreviousClip);
+    return Targets;
+}
diff --git a/Experimental/FrontierEngine/Shader/SurfaceReflectance.wgsl b/Experimental/FrontierEngine/Shader/SurfaceReflectance.wgsl
new file mode 100644
index 0000000..14eeabf
--- /dev/null
+++ b/Experimental/FrontierEngine/Shader/SurfaceReflectance.wgsl
@@ -0,0 +1,110 @@
+//============================================================================================================================================
+//                                                         SURFACEREFLECTANCE.WGSL
+//============================================================================================================================================
+// 🧩 The one reflectance model every shading site uses: Lambert diffuse, GGX specular, and the automotive clear coat.
+
+// 📝 Shared by the direct term, the resolved indirect term and the reflection resolve so the first bounce and every
+//    later one agree on what a surface reflects (Slate's IlluminationGroundwork §5 constraint, applied here).
+
+//! include "SceneRecords.wgsl"
+
+struct SurfaceSample
+{
+    Albedo        : vec3f,   // [-]
+    Roughness     : f32,     // [-]  perceptual, clamped away from zero
+    Metalness     : f32,     // [-]
+    SpecularLevel : f32,     // [-]  dielectric F0
+    CoatWeight    : f32,     // [-]
+    CoatRoughness : f32,     // [-]
+    Emission      : vec3f,   // [-]
+    Transmission  : f32,     // [-]
+}
+
+fn ProjectSurfaceSample(Material: MaterialRecord) -> SurfaceSample
+{
+    var Surface: SurfaceSample;
+    Surface.Albedo        = Material.Albedo;
+    Surface.Roughness     = clamp(Material.Roughness, 0.03, 1.0);
+    Surface.Metalness     = Material.Metalness;
+    Surface.SpecularLevel = Material.SpecularLevel;
+    Surface.CoatWeight    = Material.CoatWeight;
+    Surface.CoatRoughness = clamp(Material.CoatRoughness, 0.03, 1.0);
+    Surface.Emission      = Material.Emission;
+    Surface.Transmission  = Material.Transmission;
+    return Surface;
+}
+
+fn ResolveDiffuseAlbedo(Surface: SurfaceSample) -> vec3f
+{
+    return Surface.Albedo * (1.0 - Surface.Metalness);
+}
+
+fn ResolveSpecularColour(Surface: SurfaceSample) -> vec3f
+{
+    return mix(vec3f(Surface.SpecularLevel), Surface.Albedo, Surface.Metalness);
+}
+
+// 📐 Schlick's Fresnel.
+fn ResolveFresnel(F0: vec3f, Cosine: f32) -> vec3f
+{
+    let Complement = 1.0 - clamp(Cosine, 0.0, 1.0);
+    let Fifth = Complement * Complement * Complement * Complement * Complement;
+    return F0 + (vec3f(1.0) - F0) * Fifth;
+}
+
+// 📐 GGX / Trowbridge–Reitz distribution with α = roughness².
+fn ResolveGgxDistribution(NdotH: f32, Roughness: f32) -> f32
+{
+    let α = Roughness * Roughness;
+    let α2 = α * α;
+    let Denominator = NdotH * NdotH * (α2 - 1.0) + 1.0;
+    return α2 / (Pi * Denominator * Denominator);
+}
+
+// 📐 Height-correlated Smith visibility V = G / (4·n·l·n·v) (Heitz 2014).
+fn ResolveSmithVisibility(NdotL: f32, NdotV: f32, Roughness: f32) -> f32
+{
+    let α = Roughness * Roughness;
+    let α2 = α * α;
+    let Lambda_V = NdotL * sqrt(NdotV * NdotV * (1.0 - α2) + α2);
+    let Lambda_L = NdotV * sqrt(NdotL * NdotL * (1.0 - α2) + α2);
+    return 0.5 / max(Lambda_V + Lambda_L, 1.0e-6);
+}
+
+// 📐 Karis' analytic fit of the split-sum environment response (scale, bias) for F0·A + B.
+fn ResolveEnvironmentResponse(NdotV: f32, Roughness: f32) -> vec2f
+{
+    let c0 = vec4f(-1.0, -0.0275, -0.572, 0.022);
+    let c1 = vec4f(1.0, 0.0425, 1.04, -0.04);
+    let r = Roughness * c0 + c1;
+    let a004 = min(r.x * r.x, exp2(-9.28 * NdotV)) * r.x + r.y;
+    return vec2f(-1.04, 1.04) * a004 + r.zw;
+}
+
+// 📝 Radiance reflected toward V from a distant light of illuminance E along L: a pigment layer under a clear coat whose
+//    Fresnel transmittance attenuates the layer beneath, as a coated automotive finish does.
+fn ResolveDirectReflectance(Surface: SurfaceSample, Normal: vec3f, View: vec3f, Light: vec3f) -> vec3f
+{
+    let NdotL = dot(Normal, Light);
+    if (NdotL <= 0.0)
+    {
+        return vec3f(0.0);
+    }
+    let NdotV = max(dot(Normal, View), 1.0e-4);
+    let Half  = normalize(Light + View);
+    let NdotH = max(dot(Normal, Half), 0.0);
+    let VdotH = max(dot(View, Half), 0.0);
+    let F0 = ResolveSpecularColour(Surface);
+    let Fresnel = ResolveFresnel(F0, VdotH);
+    let Specular = Fresnel * ResolveGgxDistribution(NdotH, Surface.Roughness) * ResolveSmithVisibility(NdotL, NdotV, Surface.Roughness);
+    let Diffuse = ResolveDiffuseAlbedo(Surface) * InversePi * (vec3f(1.0) - Fresnel);
+    var Layer = (Diffuse + Specular) * NdotL;
+    if (Surface.CoatWeight > 0.0)
+    {
+        let CoatFresnel = ResolveFresnel(vec3f(0.04), VdotH).x * Surface.CoatWeight;
+        let Coat = CoatFresnel * ResolveGgxDistribution(NdotH, Surface.CoatRoughness)
+                 * ResolveSmithVisibility(NdotL, NdotV, Surface.CoatRoughness) * NdotL;
+        Layer = Layer * (1.0 - CoatFresnel) + vec3f(Coat);
+    }
+    return Layer;
+}
diff --git a/Experimental/FrontierEngine/Shader/TyreContactProjection.wgsl b/Experimental/FrontierEngine/Shader/TyreContactProjection.wgsl
new file mode 100644
