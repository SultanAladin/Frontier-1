+  const AH = [-900, -450, 0, 450, 900];
+  AH.forEach((z, i) => {
+    addRoad(g, artH[i], [{ x: -CORE, y: 0, z }, { x: 0, y: 0, z }, { x: CORE, y: 0, z }], { name: `St ${z}` });
+    use(artH[i]);
+  });
