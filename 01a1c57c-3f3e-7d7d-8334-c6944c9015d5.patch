+            this.Shell?.Announce("Maximum studio light fixtures reached");
+            return null;
+        }
+        const IsPoint = Kind === "Point";
+        const Angle = Index * 1.15;
+        const Radius = 5.4;
+        const Pos = [Math.cos(Angle) * Radius, Math.sin(Angle) * Radius, 3.8];
+        const Target = this.Vehicle ? this.Vehicle.Position : [0, 0, 0.5];
+        const Dir = NormalizeVector(SubtractVector(Target, Pos));
