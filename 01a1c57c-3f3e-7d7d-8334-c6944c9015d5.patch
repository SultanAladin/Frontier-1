+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Frontier · Cluster LOD Lab</title><style>
+:root{color-scheme:dark;--bg:#101419;--panel:#171d24;--line:#2c3540;--muted:#90a0af;--ink:#edf4fa;--mint:#82e3c3}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px system-ui,sans-serif}header{height:78px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 30px;gap:20px}.brand{font-size:13px;letter-spacing:3px;font-weight:750}.brand b{color:var(--mint)}.sub{color:var(--muted);font-size:12px;margin-top:7px;letter-spacing:.2px}.tag{font-size:11px;color:var(--mint);border:1px solid #32574f;border-radius:20px;padding:7px 13px}main{display:grid;grid-template-columns:minmax(0,1fr) 320px;min-height:710px}section.stage{position:relative;min-width:0;background:radial-gradient(ellipse at 50% 40%,#202e3a,#10171d 70%);overflow:hidden}canvas{display:block;width:100%;height:680px;touch-action:none;cursor:grab}canvas:active{cursor:grabbing}.stagehead{position:absolute;top:25px;left:28px;right:28px;display:flex;justify-content:space-between;gap:10px;pointer-events:none}.eyebrow{color:var(--mint);font-size:10px;letter-spacing:2px;font-weight:650}h1{font-size:27px;letter-spacing:-.8px;margin:7px 0}p{line-height:1.6;color:var(--muted)}.stagehead p{margin:0;max-width:450px;font-size:12px}.modebar{position:absolute;bottom:70px;left:28px;display:flex;gap:6px;background:#141b22e8;padding:5px;border:1px solid var(--line);border-radius:9px}button{font:inherit;color:var(--muted);border:1px solid var(--line);background:#202831;border-radius:6px;padding:8px 12px;cursor:pointer}button:hover{border-color:#728899;color:white}button.active{color:#10231e;background:var(--mint);border-color:var(--mint)}.hint{position:absolute;left:28px;bottom:29px;color:var(--muted);font-size:11px}.legend{position:absolute;right:26px;bottom:80px;background:#141b22dd;padding:14px;border:1px solid var(--line);border-radius:9px;font-size:10px}.legend div{margin:7px 0}.dot{display:inline-block;width:7px;height:7px;margin-right:8px;border-radius:2px}.hud{position:absolute;right:25px;top:136px;text-align:right;pointer-events:none}.hud strong{font:28px ui-monospace,monospace;letter-spacing:-1px}.hud small{display:block;color:var(--muted);font-size:10px;margin:3px 0 17px}.badge{position:absolute;left:28px;top:141px;font-size:11px;color:#afbdd0;max-width:230px;background:#141b22c9;border:1px solid var(--line);padding:9px 12px;border-radius:6px}aside{padding:24px;border-left:1px solid var(--line);background:var(--panel)}aside h2{font-size:15px;margin:0 0 20px}label.range{display:block;margin:21px 0 7px;font-size:12px;color:#ccd8e3}output{float:right;color:var(--mint);font-family:ui-monospace,monospace}input[type=range]{width:100%;accent-color:var(--mint);height:5px;margin:10px 0}.small{font-size:11px;color:var(--muted);line-height:1.55}.divider{border-top:1px solid var(--line);margin:23px 0}.check{display:flex;gap:10px;align-items:center;margin:14px 0;font-size:12px}input[type=checkbox]{accent-color:var(--mint);width:15px;height:15px}.row{display:flex;gap:7px}.row button{flex:1;font-size:12px}.note{margin-top:20px;padding:13px;background:#10231f;color:#acd0c3;border:1px solid #2c5147;border-radius:8px;font-size:11px;line-height:1.6}.foot{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border-top:1px solid var(--line)}.foot article{background:var(--bg);padding:22px 28px}.foot h3{font-size:12px;margin:0 0 7px}.foot p{font-size:12px;margin:0}.foot span{color:var(--mint);margin-right:8px}a{color:var(--mint)}footer{padding:20px 28px;color:var(--muted);font-size:11px;border-top:1px solid var(--line)}:focus-visible{outline:2px solid var(--mint);outline-offset:4px}@media(max-width:850px){main{grid-template-columns:1fr}aside{border-left:0;border-top:1px solid var(--line)}canvas{height:600px}.foot{grid-template-columns:1fr}.stagehead{left:18px}.stagehead h1{font-size:23px}header{padding:0 18px}.tag{display:none}.hud{top:215px}.badge{top:150px}.legend{bottom:133px}}
