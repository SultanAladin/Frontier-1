+      box(struct, P(0, off - 0.25, deckY - deckT - 1.4), P(len, off + 0.25, deckY - deckT), tx, tz);
+    }
+    for (let i = 1; i < nSpans; i++) {
+      const s = (i / nSpans) * len;
