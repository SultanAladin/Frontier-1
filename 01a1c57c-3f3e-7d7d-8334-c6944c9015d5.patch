+    rng=random.Random(98);body=''
+    for row in range(5):
+        for col in range(5):
+            x=49+col*37+rng.uniform(-9,9);y=52+row*36+rng.uniform(-8,8)
+            r=rng.uniform(1.8,3.6);length=rng.uniform(11,27)
