+                (1 - G * G) / Math.max(0.01, (1 + G * G - 2 * G * Mu) ** 1.5),
+              );
+            for (let I = 0; I < 20; I++) {
+              const P = Add(Eye, D, Start + (I + 0.5) * DS),
