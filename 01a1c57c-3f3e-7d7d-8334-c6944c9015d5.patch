+            Id: `studio-light-${Index}`,
+            Name: IsPoint ? `Studio Point ${Index + 1}` : `Studio Key Spot ${Index + 1}`,
+            Role: IsPoint ? "Accent Omni" : "Spot Fixture",
+            Enabled: true,
+            SoftboxLinked: false,
+            Type: IsPoint ? LightType.Omni : LightType.Floodlight,
+            Position: Pos,
+            Direction: Dir,
+            Colour: [1.0, 0.96, 0.90],
+            Intensity: IsPoint ? 240.0 : 520.0,
+            Reach: 32.0,
+            Params: [Math.cos(16.0 * Math.PI / 180.0), Math.cos(44.0 * Math.PI / 180.0), 0.0, 1.0]
