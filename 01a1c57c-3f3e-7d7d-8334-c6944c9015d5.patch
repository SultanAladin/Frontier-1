diff --git a/Experimental/FrontierEngine/Style/FrontierEditor.css b/Experimental/FrontierEngine/Style/FrontierEditor.css
new file mode 100644
index 0000000..4a73cb4
--- /dev/null
+++ b/Experimental/FrontierEngine/Style/FrontierEditor.css
@@ -0,0 +1,1984 @@
+/*==========================================================================================================================================
+                                                            FRONTIEREDITOR.CSS
+==========================================================================================================================================
+ 🧩 The Frontier Editor's look for the exhibit: outliner, viewport and inspector columns, cards, metrics, sliders and switches.
+
+ 📝 Tokens transcribed from Experimental/FrontierEditor/style.css and the native C++ conversion recorded in
+    Docs/FrontierEditorComponents.md: DM Sans 13 px on #101010; outliner #161616 with 43 px tree rows; cards as a
+    #222 → #1f1f1f gradient with a #2f2f2f border and 18 px radius; 45 px weight-300 metrics; 3 px slider rails
+    (#c5c5c5 fill over #444) with an 11 px thumb ringed in #222; pills, switches and segmented controls as in the native
+    Fracture and Gas cards. Only the exhibit's own additions (the viewport header, the status bar) are new.
+==========================================================================================================================================*/
+
+@font-face { font-family: "DM Sans"; font-style: normal; font-weight: 300; font-display: swap; src: url("Fonts/dm-sans-latin-300-normal.woff2") format("woff2"); }
+@font-face { font-family: "DM Sans"; font-style: normal; font-weight: 400; font-display: swap; src: url("Fonts/dm-sans-latin-400-normal.woff2") format("woff2"); }
+@font-face { font-family: "DM Sans"; font-style: normal; font-weight: 500; font-display: swap; src: url("Fonts/dm-sans-latin-500-normal.woff2") format("woff2"); }
+
+:root
+{
+    --ground: #101010;
+    --column: #161616;
+    --edge: #2a2a2a;
+    --text: #dcdcdc;
+    --soft: #b4b4b4;
+    --muted: #7d7d7d;
+    --faint: #5c5c5c;
+    --accent: #c5c5c5;
+    --on: #3ec46d;
+    --warn: #e0a24a;
+    --fail: #ff6b6b;
+    --mono: "JetBrains Mono", Consolas, "Courier New", monospace;
+    color-scheme: dark;
+}
+
+*
+{
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+}
+
+html, body
+{
+    width: 100%;
+    height: 100%;
+    overflow: hidden;
+    background: var(--ground);
+    color: var(--text);
+    font: 400 13px/1.35 "DM Sans", -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
+    font-synthesis: none;
+}
+
+button
+{
+    font: inherit;
+    color: inherit;
+    background: none;
+    border: 0;
+    cursor: pointer;
+    transition: background .18s, color .18s, opacity .18s, border-color .18s;
+}
+
+input, select
+{
+    font: inherit;
+    color: inherit;
+}
+
+.hidden
+{
+    display: none !important;
+}
+
+.glyph
+{
+    display: inline-flex;
+    flex: none;
+}
+
+/*------------------------------------------------------------------------------------------------------------------------------------------
+                                                                  SHELL
+------------------------------------------------------------------------------------------------------------------------------------------*/
+
+#shell
+{
+    position: absolute;
+    inset: 0;
+    display: grid;
+    grid-template-columns: 288px minmax(0, 1fr) 380px;
+    grid-template-rows: minmax(0, 1fr) 28px;
+    grid-template-areas: "outliner viewport inspector" "status status status";
+}
+
+body.panels-hidden #shell
+{
+    grid-template-columns: 0 minmax(0, 1fr) 0;
+}
+
+#shell.is-dockable
+{
+    display: flex;
+    flex-direction: column;
+}
+
+#shell.is-dockable > #status
+{
+    flex: 0 0 28px;
+}
+
+.column
+{
+    min-width: 0;
+    min-height: 0;
+    display: flex;
+    flex-direction: column;
+    background: var(--column);
+}
+
+.column-tabs
+{
+    flex: none;
+    height: 34px;
+    display: flex;
+    align-items: stretch;
+    background: #0d0d0d;
+    border-bottom: 1px solid var(--edge);
+}
+
+.column-tab
+{
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    padding: 0 12px 0 16px;
+    font-size: 11px;
+    color: #cfcfcf;
+    background: var(--column);
+    border-right: 1px solid var(--edge);
+}
+
+.column-tab button
+{
+    display: grid;
+    place-items: center;
+    width: 18px;
+    height: 18px;
+    border-radius: 5px;
+    color: #8a8a8a;
+}
+
+.column-tab button:hover
+{
+    background: #2a2a2a;
+    color: #e0e0e0;
+}
+
+.column-tabs .tab-fill
+{
+    flex: 1;
+}
+
+/*------------------------------------------------------------------------------------------------------------------------------------------
+                                                                OUTLINER
+------------------------------------------------------------------------------------------------------------------------------------------*/
+
+#outliner
+{
+    grid-area: outliner;
+    border-right: 1px solid var(--edge);
+}
+
+.outliner-body
+{
+    flex: 1;
+    min-height: 0;
+    overflow-y: auto;
+    padding: 22px 14px 14px;
+    display: flex;
+    flex-direction: column;
+    scrollbar-width: thin;
+    scrollbar-color: #2f2f2f transparent;
+}
+
+.brand
+{
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    padding: 0 8px 26px;
+    font-size: 23px;
+    letter-spacing: -1.1px;
+    font-weight: 500;
+}
+
+.brand .brand-symbol
+{
+    display: flex;
+    transform: rotate(-10deg);
+    color: #c2c2c2;
+}
+
+.brand .brand-dot
+{
+    color: #a8a8a8;
+}
+
+.brand .version
+{
+    margin-left: auto;
+    font-size: 9px;
+    letter-spacing: 1.4px;
+    color: #6f6f6f;
+    font-weight: 500;
+}
+
+.scene-label
+{
+    color: #717171;
+    font-size: 9px;
+    font-weight: 600;
+    letter-spacing: 1.6px;
+    padding: 0 10px;
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+}
+
+.status-dot
+{
+    height: 5px;
+    width: 5px;
+    background: var(--on);
+    border-radius: 100%;
+    display: inline-block;
+    box-shadow: 0 0 6px #3ec46d88;
+}
+
+.scene-title
+{
+    font-size: 16px;
+    padding: 10px 10px 20px;
+    letter-spacing: -.4px;
+}
+
+.scene-title-button
+{
+    width: 100%;
+    display: flex;
+    align-items: center;
+    gap: 5px;
+    margin: 4px 0 12px;
+    padding: 8px 10px;
+    border-radius: 10px;
+    text-align: left;
+    color: #e4e4e4;
+    transition: background 120ms ease, color 120ms ease;
+}
+
+.scene-title-button:hover
+{
+    background: #202020;
+    color: #ffffff;
+}
+
+.scene-title-button .glyph
+{
+    margin-left: auto;
+    color: #7c7c7c;
+}
+
+.scene-title .scene-extension
+{
+    color: #6f6f6f;
+}
+
+.count-tiles
+{
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 9px;
+    padding: 0 2px 16px;
+}
+
+.count-tile
+{
+    position: relative;
+    height: 62px;
+    padding: 10px 12px;
+    border-radius: 14px;
+    background: #1c1c1c;
+    border: 1px solid #2c2c2c;
+}
+
+.count-tile .count-icon
+{
+    width: 22px;
+    height: 22px;
+    border-radius: 50%;
+    display: grid;
+    place-items: center;
+    background: var(--on);
+    color: #0b2414;
+}
+
+.count-tile.hidden-count .count-icon
+{
+    background: #2c2c2c;
+    color: #8a8a8a;
+}
+
+.count-tile .count-caption
+{
+    position: absolute;
+    left: 12px;
+    bottom: 8px;
+    font-size: 10px;
+    color: #9a9a9a;
+}
+
+.count-tile .count-value
+{
+    position: absolute;
+    right: 13px;
+    top: 13px;
+    font-size: 27px;
+    font-weight: 300;
+    letter-spacing: -1px;
+    color: #e6e6e6;
+}
+
+.outliner-heading
+{
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    padding: 0 10px 10px;
+}
+
+.outliner-heading h2
+{
+    font-size: 12px;
+    font-weight: 500;
+}
+
+.outliner-heading h2 span
+{
+    font-size: 10px;
+    color: #7e7e7e;
+    border: 1px solid #313131;
+    border-radius: 5px;
+    padding: 2px 5px;
+    margin-left: 6px;
+}
+
+.search
+{
+    height: 34px;
+    display: flex;
+    align-items: center;
+    gap: 9px;
+    background: #1d1d1d;
+    border: 1px solid #282828;
+    border-radius: 8px;
+    padding: 0 11px;
+    margin: 0 4px 18px;
+    color: #707070;
+}
+
+.search input
+{
+    width: 100%;
+    border: 0;
+    background: transparent;
+    font-size: 11px;
+    color: #cccccc;
+    outline: none;
+}
+
+.search input::placeholder
+{
+    color: #767676;
+}
+
+.group
+{
+    margin-bottom: 16px;
+}
+
+.group-label
+{
+    display: flex;
+    align-items: center;
+    width: 100%;
+    font-size: 10px;
+    color: #818181;
+    padding: 0 10px 8px;
+    gap: 7px;
+    letter-spacing: .3px;
+}
+
+.group-count
+{
+    margin-left: auto;
+    color: #575757;
+    font-size: 9px;
+}
+
+.tree-row
+{
+    display: flex;
+    margin: 2px 2px;
+    border-radius: 8px;
+    height: 38px;
+    border: 1px solid transparent;
+    position: relative;
+}
+
+.tree-row:hover
+{
+    background: #202020;
+}
+
+.tree-row.selected
+{
+    background: linear-gradient(110deg, #333, #292929);
+    border-color: #434343;
+    box-shadow: inset 0 1px #ffffff06, 0 3px 8px #0002;
+}
+
+.tree-row.selected::before
+{
+    content: "";
+    position: absolute;
+    width: 2px;
+    height: 16px;
+    background: var(--entity-colour, #e8e8e8);
+    left: -4px;
+    top: 10px;
+    border-radius: 2px;
+}
+
+.tree-row.nested .object-button
+{
+    padding-left: 38px;
+}
+
+.object-button
+{
+    display: flex;
+    align-items: center;
+    gap: 11px;
+    flex: 1;
