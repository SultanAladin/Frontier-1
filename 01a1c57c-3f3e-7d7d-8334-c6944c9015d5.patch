+  const shade=.28+.72*Math.max(0,dot(n,light)),base=mode==='clusters'?colors[t.n]:[144,177,185];
+  const checker=(Math.floor(t.uv[0]*36)+Math.floor(t.uv[1]*18))%2;
+  const tint=mode==='shaded'&&$('uv').checked?(checker?.85:1.06):1;
