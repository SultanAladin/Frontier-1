+.pz-outliner .outliner-row:hover .visibility,
+.pz-outliner .outliner-row.selected .visibility { opacity: 1; }
+.pz-outliner .visibility:disabled { opacity: 0.2 !important; cursor: default; }
+
+.pz-outliner .outliner-footer {
+    height: 45px;
+    flex: none;
+    display: flex;
+    gap: 12px;
+    padding: 7px 15px;
+    border-top: 1px solid #ffffff06;
+    background: #151515;
+    overflow: hidden;
+}
+.pz-outliner .outliner-footer span {
+    display: flex;
+    flex-direction: column;
+    gap: 2px;
+    white-space: nowrap;
+}
+.pz-outliner .outliner-footer small {
+    font-size: 7px;
+    letter-spacing: 0.7px;
+    color: #555;
+}
+.pz-outliner .outliner-footer b {
+    font-size: 10px;
+    font-weight: 400;
+    color: #b0b0b0;
+}
+.pz-outliner .outliner-footer span:first-child b { color: #34c759; }
+
+/* Viewport Toolbar (ProjectZeroEditor 1:1 with Edit / Sim / Play) */
+#outliner.pz-outliner {
+    flex: 1 1 0% !important;
+}
+
+#viewport-column.pz-viewport-col {
+    flex: 1 1 0% !important;
