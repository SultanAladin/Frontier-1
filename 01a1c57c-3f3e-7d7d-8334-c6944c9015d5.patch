+.volume-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:12px 0 18px}.volume-fields label>span,.volume-range>span{font-size:11px;color:#aeb6c0}.volume-fields label>div{display:flex;align-items:center;background:#202226;border:1px solid #3a3e44;border-radius:6px;margin-top:7px;padding:8px}.volume-fields input{width:100%;min-width:0;border:0;outline:none;background:none;color:#e1e5e9;font:inherit}.volume-fields small{color:#737d89}.volume-range{display:block;margin:18px 0}.volume-range>span{display:flex;justify-content:space-between;margin-bottom:9px}.volume-range strong{font-weight:500;color:#d5dce3}.volume-fields input:focus-visible{outline:1px solid var(--accent)}
+@media(max-width:600px){.volume-summary{gap:10px}.volume-summary svg{width:100px}.volume-fields{gap:6px}}
+
+.volume-shape-label{display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:11px;color:#bbb;margin:12px 0 20px}.volume-shape-label select{background:#252525;border:1px solid #414141;border-radius:7px;padding:9px 12px;color:#ddd;font:inherit;min-width:150px}.volume-subheading{border-top:1px solid #ffffff0c;padding-top:16px;font-size:9px;letter-spacing:1px;color:#a6a6a6;display:flex;justify-content:space-between;gap:12px}.volume-subheading span{letter-spacing:0;color:#7d838b}.volume-custom{margin-bottom:20px}.volume-custom>label{font-size:11px;color:#c6c6c6}.volume-custom textarea{display:block;width:100%;box-sizing:border-box;background:#1b1d20;border:1px solid #3b4046;border-radius:8px;padding:10px;color:#d2d8de;font:12px/1.7 monospace;resize:vertical;margin:10px 0}.volume-custom button{border:1px solid #41474d;border-radius:7px;padding:8px 12px;background:#2a2e33;color:#cdd3d9;font-size:10px}.volume-custom [role=alert]{color:#e9a69e;font-size:11px}
