+}
+.pz-outliner .row-status {
+    width: 16px;
+    height: 16px;
+    border-radius: 50%;
+    background: #34c759;
+    color: #0d3c16;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    flex: none;
+}
+.pz-outliner .row-status.warm { background: #e5a93c; color: #3a2605; }
+.pz-outliner .row-status.idle { background: #2c2c2c; color: #777; }
+
+.pz-outliner .visibility {
+    padding: 0;
+    min-height: 20px;
+    width: 18px;
+    height: 20px;
+    background: transparent;
+    border: 0;
+    color: #777;
+    opacity: 0;
