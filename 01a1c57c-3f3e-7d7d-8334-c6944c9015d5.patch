+.cards { gap: 16px; }
+.card {
+  position: relative;
+  background: linear-gradient(135deg, #252525 0%, #202020 80%);
+  border: 1px solid #343434;
+  border-radius: 22px;
+  box-shadow: inset 0 1px 0 #ffffff06, 0 6px 20px #00000014;
+  transition: border-color .2s, box-shadow .2s;
+}
+.card:hover { border-color: #454545; box-shadow: inset 0 1px 0 #ffffff08, 0 8px 24px #00000020; }
