+            this.Diffuse.Tuning.ColourSigma       = this.Settings.DiffuseColourSigma;
+            this.Diffuse.Tuning.TallyLimit        = this.Settings.DiffuseTallyLimit;
+        }
+        else if (["GlossyWavelets", "GlossyColourSigma", "GlossyTallyLimit"].includes(Key) && this.Glossy)
