+      e.preventDefault();
+      const dir = new THREE.Vector3();
+      this.camera.getWorldDirection(dir);
+      if (e.deltaY < 0) { this.speed = Math.min(1200, this.speed * 1.18); this.camera.position.addScaledVector(dir, this.speed * 0.12); }
