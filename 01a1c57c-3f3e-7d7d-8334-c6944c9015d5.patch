+        const Controls = Row.ReferenceOnly ? Frame() : Frame("details");
+        if (!Row.ReferenceOnly)
+          await Sequence(Row.Id, [
+            ["summary", ".lp-participation"],
+            ".entity-capabilities",
+            ["details", ".lp-output"],
