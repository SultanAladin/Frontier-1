+        assert.deepEqual(
+          Actual.Cards,
+          [
+            "Fog settings",
+            "Visibility through fog",
+            "Medium",
+            "Height and tint",
+            "Wind binding",
+          ],
+        );
+      }
+      if (Id === "lighting") {
+        assert(Actual.Headings.includes("Browse contents 10 matches"));
+        Expected.Headings = Expected.Headings.map((Heading) =>
+          Heading === "Browse contents 7 matches"
+            ? "Browse contents 10 matches"
+            : Heading,
+        );
+      }
+      if (Id !== "height-fog")
