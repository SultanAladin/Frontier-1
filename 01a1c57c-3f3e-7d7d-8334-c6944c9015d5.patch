+function ensureBuckets(buckets) {
+  for (const k of ['bridge-deck', 'bridge-rail', 'bridge-steel', 'bridge-concrete', 'bridge-cable']) {
+    if (!buckets[k]) buckets[k] = newBucket();
+  }
+  return buckets;
