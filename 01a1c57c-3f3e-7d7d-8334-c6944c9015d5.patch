 0V-40M0-26l-10-9m10 9 10-9M0-13l-7-7m7 7 7-7" stroke="#86b5d5" stroke-width="4.5"/><path d="M-1-3v-34" stroke="#f0fcff" stroke-width="1.1" opacity=".7"/></g><g transform="rotate(300)"><path d="M0 0V-40M0-26l-10-9m10 9 10-9M0-13l-7-7m7 7 7-7" stroke="#86b5d5" stroke-width="4.5"/><path d="M-1-3v-34" stroke="#f0fcff" stroke-width="1.1" opacity=".7"/></g><path d="M0-7 6-3v7L0 8-6 4v-7Z" fill="#eefaff" stroke="none"/></g><circle cx="53" cy="58" r="3" fill="#d7edf5"/><circle cx="170" cy="121" r="2.5" fill="#d7edf5"/><circle cx="70" cy="208" r="3" fill="#d7edf5"/><circle cx="154" cy="208" r="2" fill="#d7edf5"/><circle cx="208" cy="119" r="2" fill="#d7edf5"/></svg>
