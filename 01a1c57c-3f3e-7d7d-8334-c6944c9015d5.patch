+.scene-extension, .group-count { color: #727272; }
+.search { background: #1d1d1d; border-color: #2c2c2c; border-radius: 9px; }
+.search input::placeholder { color: #898989; }
+.tree-row { border-radius: 9px; }
+.tree-row:hover { background: #222; }
+.tree-row.selected { background: linear-gradient(110deg, #333, #292929); border-color: #434343; box-shadow: inset 0 1px #ffffff06, 0 3px 8px #0002; }
+.tree-row.selected:before { background: #e8e8e8; }
+.selected .object-button, .selected .object-button>svg { color: #f1f1f1; }
+.object-button { color: #b0b0b0; }
+.object-button>svg { color: #939393; }
+.selected-dot { background: #dedede; }
+.visibility { color: #969696; }
+.outliner-bottom { border-color: #2c2c2c; }
+.world-icon { background: #242424; border: 1px solid #343434; color: #c1c1c1; }
+.status-dot, .little-dot, .footer-dot { background: #adadad; }
+.object-icon { background: linear-gradient(140deg, #343434, #222); border-color: #424242; box-shadow: inset 0 1px #ffffff0c, 0 8px 20px #0002; }
+.eyebrow { color: #949494; }
+h1 { color: #f0f0f0; font-weight: 300; }
+.enabled-pill { background: #262626; color: #d2d2d2; border-color: #3b3b3b; }
+.enabled-pill>span { background: #d4d4d4; box-shadow: 0 0 7px #ffffff18; }
+.enabled-pill:hover { background: #333; }
