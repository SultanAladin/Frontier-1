+                Scene.RetainOccupantTransform(Cone.Occupant);
+                Cone.Settling = false;
+                First = Math.min(First, Cone.Occupant);
+                Last = Math.max(Last, Cone.Occupant);
+            }
+            if (Cone.Displaced)
