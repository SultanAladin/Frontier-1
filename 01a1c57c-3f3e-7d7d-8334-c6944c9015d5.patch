+      g.font = '8px ui-sans-serif,system-ui'; g.textAlign = 'center'; g.fillText(`${m} m`, x, y - gh + 10);
+      if (ri === 0) g.fillRect(x - 1, y - gh * .48, 2, gh * .48);
