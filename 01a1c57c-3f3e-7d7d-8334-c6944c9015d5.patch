+        const InEditMode = this.Settings.RunMode === "EDIT";
+
+        // 1. Vehicle-parented low-poly 3D camera (Editor-only visual debug: hidden in Play/Sim or when viewing through it)
+        const VehCamIdx = Scene.CameraOccupants.Vehicle;
+        const VehCamOcc = Scene.Occupants[VehCamIdx];
+        if (VehCamOcc)
+        {
+            const ViewingThroughVehCam = !this.FreeCamera && !this.RmbFlying && !this.EditorFlightActive
+                                       && this.Settings.CameraMode === "VehicleCamera";
+            const ShouldHideVehCam = Boolean(!InEditMode || !this.VehicleCamera.Visible || ViewingThroughVehCam || this.Vehicle.Hidden);
+            if (VehCamOcc.Inactive !== ShouldHideVehCam)
+            {
+                VehCamOcc.Inactive = ShouldHideVehCam;
+                RebuildRuns = true;
+            }
+            Scene.AssignOccupantTransform(VehCamIdx, this.ResolveVehicleCameraWorldTransform());
+        }
+
+        // 2. Cine Camera low-poly 3D camera (Lobby-only & Editor-only visual debug: hidden in Play/Sim or outside Lobby)
+        const CineCamIdx = Scene.CameraOccupants.Cine;
+        const CineCamOcc = Scene.Occupants[CineCamIdx];
+        if (CineCamOcc)
+        {
+            const ViewingThroughCine = !this.FreeCamera && !this.RmbFlying && !this.EditorFlightActive
