+
+  await Page.locator(".inspector-scroll").evaluate(
+    (Node) => (Node.scrollTop = 0),
+  );
+  await Page.screenshot({ path: path.join(Proof, "OutlinerMetadata.png") });
+} catch (Error) {
+  Errors.push(Error.stack);
+} finally {
