+  await Open("local-cloud");
+  await Slice("summary").locator(".cl-hero").waitFor();
+  assert.equal(
+    await Slice("summary").locator(".cl-local-domain").innerText(),
+    "LOCAL VOLUME · SCHEMATIC",
