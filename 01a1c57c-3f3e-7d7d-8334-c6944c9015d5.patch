+    const clear=Math.pow(ndh,Math.max(10,2/(coatR*coatR)))*coat*.65;
+    const reflection=Math.pow(Math.max(0,-xx*.7+yy*.15+z*.55),6)*.65+Math.pow(Math.max(0,xx*.5+yy*.1+z*.4),10)*.35;
