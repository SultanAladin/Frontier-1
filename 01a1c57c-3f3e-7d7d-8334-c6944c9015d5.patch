+    SyncStudioLightMaterial()
+    {
+        if (!this.Lobby || !this.Lighting?.StudioLights?.length || !this.Exchange?.Device)
+            return;
+        const KeyLight = this.Lighting.StudioLights.find((L) => L.SoftboxLinked);
+        if (KeyLight && this.Materials?.[CourseMaterial.StudioSoftbox])
+        {
+            const Softbox = this.Materials[CourseMaterial.StudioSoftbox];
+            const Active = KeyLight.Enabled !== false ? 1.0 : 0.0;
+            const Scale = (KeyLight.Intensity / 950.0) * 18.0 * Active;
+            Softbox.Emission = [
+                KeyLight.Colour[0] * Scale,
+                KeyLight.Colour[1] * Scale,
+                KeyLight.Colour[2] * Scale
